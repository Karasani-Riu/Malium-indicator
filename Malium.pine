fib_tolerance_max = input.float(0.22, title="Max Fibonacci Tolerance", minval=0.10, maxval=0.30, step=0.01, group=group_harmonic, tooltip="Maximum tolerance for flexible Fibonacci matching (±0.22)")
show_potential = input.bool(true, title="Show Potential Patterns", group=group_harmonic, tooltip="Display patterns in formation with dashed lines")

// Legacy tolerance for backward compatibility
