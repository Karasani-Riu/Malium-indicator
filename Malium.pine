// Backward compatibility (will be replaced by directional colors in pattern functions)
color_harmonic = color.new(color.purple, 0)
color_impulse = color.new(color.blue, 0)
color_corrective = color.new(color.red, 0)
color_neowave = color.new(color.fuchsia, 0)
color_chart_pattern = color.new(color.aqua, 0)

// --- Advanced Settings ---
