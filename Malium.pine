// ═══════════════════════════════════════════════════════════════════════════════
// II. FIBONACCI RATIOS & CONSTANTS (피보나치 상수)
// ═══════════════════════════════════════════════════════════════════════════════

// Traditional Fibonacci Ratios
var float FIB_0236 = 0.236
var float FIB_0382 = 0.382
var float FIB_0500 = 0.500
var float FIB_0618 = 0.618
var float FIB_0786 = 0.786
var float FIB_0886 = 0.886
var float FIB_1000 = 1.000
var float FIB_1130 = 1.130
var float FIB_1272 = 1.272
var float FIB_1414 = 1.414
var float FIB_1618 = 1.618
var float FIB_2000 = 2.000
var float FIB_2240 = 2.240
var float FIB_2618 = 2.618

// Ian Copsey Harmonic Elliott Wave Ratios (Advanced)
var float FIB_0414 = 0.414  // √2 ratio - 41.4%
var float FIB_0586 = 0.586  // Complementary √2 ratio - 58.6%
var float FIB_1236 = 1.236  // 123.6%
var float FIB_1382 = 1.382  // 138.2%
var float FIB_1667 = 1.667  // 166.7%
var float FIB_1764 = 1.764  // 176.4% - Very frequent Wave (iii) target
var float FIB_1854 = 1.854  // 185.4% - Very frequent Wave (iii) target
var float FIB_1900 = 1.9002 // 190.02% - Wave (iii) target
var float FIB_2236 = 2.236  // 223.6% - Common Wave (iii) extension
var float FIB_2382 = 2.382  // 238.2%
var float FIB_2764 = 2.764  // 276.4% - Frequent Wave (iii) target
var float FIB_2854 = 2.854  // 285.4% - Frequent Wave (iii) target
var float FIB_3000 = 3.000  // 300% - Common BCD extension
var float FIB_3618 = 3.618  // 361.8%
var float FIB_4236 = 4.236  // 423.6%

// ═══════════════════════════════════════════════════════════════════════════════
// III. ZIGZAG CALCULATION (지그재그 계산)
// ═══════════════════════════════════════════════════════════════════════════════

// ZigZag Pivot Detection
f_pivothigh(len) =>
    ta.pivothigh(high, len, len)

f_pivotlow(len) =>
    ta.pivotlow(low, len, len)

// ZigZag State Variables
var float[] zz_price = array.new_float(0)
var int[] zz_bar = array.new_int(0)
var int[] zz_direction = array.new_int(0) // 1 = high, -1 = low

// Calculate ZigZag
var float last_pivot_price = na
var int last_pivot_bar = na
var int last_pivot_dir = na

ph = f_pivothigh(zigzag_depth)
pl = f_pivotlow(zigzag_depth)

if not na(ph)
    price_change = na(last_pivot_price) ? 100.0 : math.abs((ph - last_pivot_price) / last_pivot_price * 100)
    if na(last_pivot_dir) or last_pivot_dir == -1
        if na(last_pivot_price) or price_change >= zigzag_deviation
            array.push(zz_price, ph)
            array.push(zz_bar, bar_index - zigzag_depth)
            array.push(zz_direction, 1)
            last_pivot_price := ph
            last_pivot_bar := bar_index - zigzag_depth
            last_pivot_dir := 1
            if array.size(zz_price) > 100
                array.shift(zz_price)
                array.shift(zz_bar)
                array.shift(zz_direction)
    else if last_pivot_dir == 1
        if ph > last_pivot_price
            array.set(zz_price, array.size(zz_price) - 1, ph)
            array.set(zz_bar, array.size(zz_bar) - 1, bar_index - zigzag_depth)
            last_pivot_price := ph
            last_pivot_bar := bar_index - zigzag_depth

if not na(pl)
    price_change = na(last_pivot_price) ? 100.0 : math.abs((pl - last_pivot_price) / last_pivot_price * 100)
    if na(last_pivot_dir) or last_pivot_dir == 1
        if na(last_pivot_price) or price_change >= zigzag_deviation
            array.push(zz_price, pl)
            array.push(zz_bar, bar_index - zigzag_depth)
            array.push(zz_direction, -1)
            last_pivot_price := pl
            last_pivot_bar := bar_index - zigzag_depth
            last_pivot_dir := -1
            if array.size(zz_price) > 100
                array.shift(zz_price)
                array.shift(zz_bar)
                array.shift(zz_direction)
    else if last_pivot_dir == -1
        if pl < last_pivot_price
            array.set(zz_price, array.size(zz_price) - 1, pl)
            array.set(zz_bar, array.size(zz_bar) - 1, bar_index - zigzag_depth)
            last_pivot_price := pl
            last_pivot_bar := bar_index - zigzag_depth

// ═══════════════════════════════════════════════════════════════════════════════
// III-B. DUAL ZIGZAG ENGINE (이중 지그재그 엔진 - 프랙탈 구조용)
// ═══════════════════════════════════════════════════════════════════════════════

// Major ZigZag Arrays (대파동 - Bold 1,2,3,4,5 and A,B,C)
var float[] major_zz_price = array.new_float(0)
var int[] major_zz_bar = array.new_int(0)
var int[] major_zz_direction = array.new_int(0)  // 1 = high, -1 = low

// Minor ZigZag Arrays (소파동 - Small i,ii,iii,iv,v and a,b,c)
var float[] minor_zz_price = array.new_float(0)
var int[] minor_zz_bar = array.new_int(0)
var int[] minor_zz_direction = array.new_int(0)

// Major ZigZag State
var float major_last_pivot_price = na
var int major_last_pivot_bar = na
var int major_last_pivot_dir = na

// Minor ZigZag State
var float minor_last_pivot_price = na
var int minor_last_pivot_bar = na
var int minor_last_pivot_dir = na

// Calculate Major ZigZag (대파동 탐지)
major_ph = f_pivothigh(major_zigzag_depth)
major_pl = f_pivotlow(major_zigzag_depth)

if not na(major_ph)
    major_price_change = na(major_last_pivot_price) ? 100.0 : math.abs((major_ph - major_last_pivot_price) / major_last_pivot_price * 100)
    if na(major_last_pivot_dir) or major_last_pivot_dir == -1
        if na(major_last_pivot_price) or major_price_change >= major_zigzag_deviation
            array.push(major_zz_price, major_ph)
            array.push(major_zz_bar, bar_index - major_zigzag_depth)
            array.push(major_zz_direction, 1)
            major_last_pivot_price := major_ph
            major_last_pivot_bar := bar_index - major_zigzag_depth
            major_last_pivot_dir := 1
            if array.size(major_zz_price) > 50
                array.shift(major_zz_price)
                array.shift(major_zz_bar)
                array.shift(major_zz_direction)
    else if major_last_pivot_dir == 1
        if major_ph > major_last_pivot_price
            array.set(major_zz_price, array.size(major_zz_price) - 1, major_ph)
            array.set(major_zz_bar, array.size(major_zz_bar) - 1, bar_index - major_zigzag_depth)
            major_last_pivot_price := major_ph
            major_last_pivot_bar := bar_index - major_zigzag_depth

if not na(major_pl)
    major_price_change = na(major_last_pivot_price) ? 100.0 : math.abs((major_pl - major_last_pivot_price) / major_last_pivot_price * 100)
    if na(major_last_pivot_dir) or major_last_pivot_dir == 1
        if na(major_last_pivot_price) or major_price_change >= major_zigzag_deviation
            array.push(major_zz_price, major_pl)
            array.push(major_zz_bar, bar_index - major_zigzag_depth)
            array.push(major_zz_direction, -1)
            major_last_pivot_price := major_pl
            major_last_pivot_bar := bar_index - major_zigzag_depth
            major_last_pivot_dir := -1
            if array.size(major_zz_price) > 50
                array.shift(major_zz_price)
                array.shift(major_zz_bar)
                array.shift(major_zz_direction)
    else if major_last_pivot_dir == -1
        if major_pl < major_last_pivot_price
            array.set(major_zz_price, array.size(major_zz_price) - 1, major_pl)
            array.set(major_zz_bar, array.size(major_zz_bar) - 1, bar_index - major_zigzag_depth)
            major_last_pivot_price := major_pl
            major_last_pivot_bar := bar_index - major_zigzag_depth

// Calculate Minor ZigZag (소파동 탐지)
minor_ph = f_pivothigh(minor_zigzag_depth)
minor_pl = f_pivotlow(minor_zigzag_depth)

if not na(minor_ph)
    minor_price_change = na(minor_last_pivot_price) ? 100.0 : math.abs((minor_ph - minor_last_pivot_price) / minor_last_pivot_price * 100)
    if na(minor_last_pivot_dir) or minor_last_pivot_dir == -1
        if na(minor_last_pivot_price) or minor_price_change >= minor_zigzag_deviation
            array.push(minor_zz_price, minor_ph)
            array.push(minor_zz_bar, bar_index - minor_zigzag_depth)
            array.push(minor_zz_direction, 1)
            minor_last_pivot_price := minor_ph
            minor_last_pivot_bar := bar_index - minor_zigzag_depth
            minor_last_pivot_dir := 1
            if array.size(minor_zz_price) > 100
                array.shift(minor_zz_price)
                array.shift(minor_zz_bar)
                array.shift(minor_zz_direction)
    else if minor_last_pivot_dir == 1
        if minor_ph > minor_last_pivot_price
            array.set(minor_zz_price, array.size(minor_zz_price) - 1, minor_ph)
            array.set(minor_zz_bar, array.size(minor_zz_bar) - 1, bar_index - minor_zigzag_depth)
            minor_last_pivot_price := minor_ph
            minor_last_pivot_bar := bar_index - minor_zigzag_depth

if not na(minor_pl)
    minor_price_change = na(minor_last_pivot_price) ? 100.0 : math.abs((minor_pl - minor_last_pivot_price) / minor_last_pivot_price * 100)
    if na(minor_last_pivot_dir) or minor_last_pivot_dir == 1
        if na(minor_last_pivot_price) or minor_price_change >= minor_zigzag_deviation
            array.push(minor_zz_price, minor_pl)
            array.push(minor_zz_bar, bar_index - minor_zigzag_depth)
            array.push(minor_zz_direction, -1)
            minor_last_pivot_price := minor_pl
            minor_last_pivot_bar := bar_index - minor_zigzag_depth
            minor_last_pivot_dir := -1
            if array.size(minor_zz_price) > 100
                array.shift(minor_zz_price)
                array.shift(minor_zz_bar)
                array.shift(minor_zz_direction)
    else if minor_last_pivot_dir == -1
        if minor_pl < minor_last_pivot_price
            array.set(minor_zz_price, array.size(minor_zz_price) - 1, minor_pl)
            array.set(minor_zz_bar, array.size(minor_zz_bar) - 1, bar_index - minor_zigzag_depth)
            minor_last_pivot_price := minor_pl
            minor_last_pivot_bar := bar_index - minor_zigzag_depth

// ═══════════════════════════════════════════════════════════════════════════════
// III-C. FRACTAL WAVE LABELING (프랙탈 파동 라벨링 - 계층적 구조)
// ═══════════════════════════════════════════════════════════════════════════════

// Persistent storage for live updates (라이브 업데이트용 저장소)
var label[] major_impulse_labels = array.new<label>(5)
var line[] major_impulse_lines = array.new<line>(5)
var label[] major_corrective_labels = array.new<label>(3)
var line[] major_corrective_lines = array.new<line>(3)
var label[] minor_impulse_labels = array.new<label>(5)
var line[] minor_impulse_lines = array.new<line>(5)
var label[] minor_corrective_labels = array.new<label>(3)
var line[] minor_corrective_lines = array.new<line>(3)

// Detect Major Impulse Waves (대파동 임펄스: 1, 2, 3, 4, 5)
f_detect_major_impulse() =>
    if array.size(major_zz_price) >= 6 and show_fractal_elliott and show_major_waves
        size = array.size(major_zz_price)

        // Get last 6 pivots for 5-wave pattern
        p0 = array.get(major_zz_price, size - 6)
        p1 = array.get(major_zz_price, size - 5)
        p2 = array.get(major_zz_price, size - 4)
        p3 = array.get(major_zz_price, size - 3)
        p4 = array.get(major_zz_price, size - 2)
        p5 = array.get(major_zz_price, size - 1)

        b0 = array.get(major_zz_bar, size - 6)
        b1 = array.get(major_zz_bar, size - 5)
        b2 = array.get(major_zz_bar, size - 4)
        b3 = array.get(major_zz_bar, size - 3)
        b4 = array.get(major_zz_bar, size - 2)
        b5 = array.get(major_zz_bar, size - 1)

        d0 = array.get(major_zz_direction, size - 6)
        is_bullish = d0 == -1  // Starting from low

        // Elliott Wave Rules
        wave1 = math.abs(p1 - p0)
        wave2 = math.abs(p2 - p1)
        wave3 = math.abs(p3 - p2)
        wave4 = math.abs(p4 - p3)
        wave5 = math.abs(p5 - p4)

        retrace2 = wave2 / wave1
        valid_wave2 = retrace2 < 1.0  // Wave 2 cannot retrace >100%
        valid_wave3 = wave3 > wave1 or wave3 > wave5  // Wave 3 not shortest
        valid_wave4 = is_bullish ? (p4 > p1) : (p4 < p1)  // Wave 4 no overlap

        if valid_wave2 and valid_wave3 and valid_wave4
            // Delete old lines/labels for live update
            for i = 0 to 4
                if not na(array.get(major_impulse_lines, i))
                    line.delete(array.get(major_impulse_lines, i))
                if not na(array.get(major_impulse_labels, i))
                    label.delete(array.get(major_impulse_labels, i))

            // Directional color based on wave direction
            wave_color = is_bullish ? color_bullish_wave : color_bearish_wave

            // Draw major impulse lines (bold, last wave is dashed for live update)
            array.set(major_impulse_lines, 0, line.new(b0, p0, b1, p1, color=wave_color, width=3, style=line.style_solid))
            array.set(major_impulse_lines, 1, line.new(b1, p1, b2, p2, color=wave_color, width=3, style=line.style_solid))
            array.set(major_impulse_lines, 2, line.new(b2, p2, b3, p3, color=wave_color, width=3, style=line.style_solid))
            array.set(major_impulse_lines, 3, line.new(b3, p3, b4, p4, color=wave_color, width=3, style=line.style_solid))
            array.set(major_impulse_lines, 4, line.new(b4, p4, b5, p5, color=wave_color, width=3, style=line.style_dashed))  // Last wave: dashed

            // Major wave labels (bold Arabic numerals, far from candles)
            label_offset_major = atr_value * label_offset_multiplier * 3.0
            array.set(major_impulse_labels, 0, label.new(b1, is_bullish ? p1 - label_offset_major : p1 + label_offset_major,
                     "1", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color_impulse_label, size=size.large, textalign=text.align_center))
            array.set(major_impulse_labels, 1, label.new(b2, is_bullish ? p2 + label_offset_major : p2 - label_offset_major,
                     "2", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color_impulse_label, size=size.large, textalign=text.align_center))
            array.set(major_impulse_labels, 2, label.new(b3, is_bullish ? p3 - label_offset_major : p3 + label_offset_major,
                     "3", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color_impulse_label, size=size.large, textalign=text.align_center))
            array.set(major_impulse_labels, 3, label.new(b4, is_bullish ? p4 + label_offset_major : p4 - label_offset_major,
                     "4", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color_impulse_label, size=size.large, textalign=text.align_center))
            array.set(major_impulse_labels, 4, label.new(b5, is_bullish ? p5 - label_offset_major : p5 + label_offset_major,
                     "5?", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color.new(color_impulse_label, 50), size=size.large, textalign=text.align_center))  // "5?" for uncertain last wave

            // ═══════════════════════════════════════════════════════════════════════
            // ELLIOTT WAVE ALTERNATION RULE (Visual Guide to Elliott Wave Trading)
            // ═══════════════════════════════════════════════════════════════════════
            // If Wave 2 is sharp (deep retrace 50%+), Wave 4 should be shallow (flat/triangle <50%)
            // If Wave 2 is shallow, Wave 4 should be deep
            if show_alternation
                retrace4 = wave4 / wave3

                // Classify Wave 2 and 4 patterns
                wave2_sharp = retrace2 >= 0.50  // Sharp correction (Zigzag)
                wave2_shallow = retrace2 < 0.50  // Shallow correction (Flat/Triangle)
                wave4_shallow = retrace4 < 0.50
                wave4_deep = retrace4 >= 0.50

                // Check alternation rule
                alternation_valid = (wave2_sharp and wave4_shallow) or (wave2_shallow and wave4_deep)

                if not alternation_valid
                    // Warning: Alternation rule violated
                    warning_text = wave2_sharp ? "⚠ Alt: W2 Sharp + W4 Deep" : "⚠ Alt: W2 Shallow + W4 Shallow"
                    label.new(b4, is_bullish ? p4 + label_offset_major * 2 : p4 - label_offset_major * 2,
                             warning_text, style=label.style_none,
                             textcolor=color.new(color.orange, 0), size=size.tiny)

            // ═══════════════════════════════════════════════════════════════════════
            // ELLIOTT WAVE CHANNELING (Visual Guide to Elliott Wave Trading)
            // ═══════════════════════════════════════════════════════════════════════
            // Impulse waves travel within parallel channels
            // Base channel: 0-2 baseline, parallel through Wave 1
            // Wave 5 typically terminates at or near channel boundary
            if show_elliott_channels
                // Calculate channel slope from Wave 0 to Wave 2
                bars_02 = b2 - b0
                price_02 = p2 - p0
                slope = bars_02 != 0 ? price_02 / bars_02 : 0

                // Draw base channel line (0-2)
                line.new(b0, p0, b2, p2, color=color.new(color_impulse, 60),
                         width=1, style=line.style_dotted, extend=extend.right)

                // Draw parallel channel line through Wave 1
                // Project Wave 5 target at channel boundary
                bars_to_5 = b5 - b0
                channel_target = p0 + (slope * bars_to_5)
                parallel_offset = p1 - (p0 + (slope * (b1 - b0)))
                channel_parallel = channel_target + parallel_offset

                line.new(b1, p1, b5, channel_parallel, color=color.new(color_impulse, 60),
                         width=1, style=line.style_dotted, extend=extend.right)

                label.new(b5 + 3, channel_parallel, "Ch", style=label.style_none,
                         textcolor=color.new(color_impulse, 60), size=size.tiny)

            // ═══════════════════════════════════════════════════════════════════════
            // EXTENSION RELATIONSHIPS (Visual Guide to Elliott Wave Trading)
            // ═══════════════════════════════════════════════════════════════════════
            // One wave extends (usually Wave 3), other two waves tend toward equality
            // If Wave 3 extended, check if Wave 1 ≈ Wave 5
            if show_extension_labels
                // Identify which wave is extended (1.618x or greater than others)
                wave1_extended = wave1 > wave3 * 1.618 or wave1 > wave5 * 1.618
                wave3_extended = wave3 > wave1 * 1.618 or wave3 > wave5 * 1.618
                wave5_extended = wave5 > wave1 * 1.618 or wave5 > wave3 * 1.618

                extension_text = ""
                equality_text = ""

                if wave3_extended
                    extension_text := "③ Ext"
                    // Check Wave 1 ≈ Wave 5 equality
                    ratio_15 = wave1 > wave5 ? wave5 / wave1 : wave1 / wave5
                    if ratio_15 >= 0.90 and ratio_15 <= 1.10
                        equality_text := "①≈⑤"
                else if wave1_extended
                    extension_text := "① Ext"
                else if wave5_extended
                    extension_text := "⑤ Ext"

                // Display extension label
                if extension_text != ""
                    label.new(b3, is_bullish ? p3 - label_offset_major * 2.5 : p3 + label_offset_major * 2.5,
                             extension_text, style=label.style_none,
                             textcolor=color.new(color_impulse, 30), size=size.small)

                // Display equality label
                if equality_text != ""
                    label.new(b5 + 5, is_bullish ? p5 - label_offset_major * 2 : p5 + label_offset_major * 2,
                             equality_text, style=label.style_none,
                             textcolor=color.new(color_impulse, 40), size=size.tiny)

// Detect Major Corrective Waves (대파동 조정: A, B, C)
f_detect_major_corrective() =>
    if array.size(major_zz_price) >= 4 and show_fractal_elliott and show_major_waves
        size = array.size(major_zz_price)

        // Get last 4 pivots for ABC pattern
        p0 = array.get(major_zz_price, size - 4)
        p1 = array.get(major_zz_price, size - 3)
        p2 = array.get(major_zz_price, size - 2)
        p3 = array.get(major_zz_price, size - 1)

        b0 = array.get(major_zz_bar, size - 4)
        b1 = array.get(major_zz_bar, size - 3)
        b2 = array.get(major_zz_bar, size - 2)
        b3 = array.get(major_zz_bar, size - 1)

        d0 = array.get(major_zz_direction, size - 4)
        is_bullish = d0 == 1  // Corrective after uptrend

        // Directional color based on wave direction
        wave_color = is_bullish ? color_bearish_wave : color_bullish_wave  // Reversed because corrections go opposite direction

        // ABC pattern validation
        wave_a = math.abs(p1 - p0)
        wave_b = math.abs(p2 - p1)
        wave_c = math.abs(p3 - p2)

        retrace_b = wave_b / wave_a
        valid_abc = retrace_b > 0.236 and retrace_b < 1.0  // B retraces 23.6%-100% of A

        if valid_abc
            // Delete old lines/labels for live update
            for i = 0 to 2
                if not na(array.get(major_corrective_lines, i))
                    line.delete(array.get(major_corrective_lines, i))
                if not na(array.get(major_corrective_labels, i))
                    label.delete(array.get(major_corrective_labels, i))

            // Draw major corrective lines (last wave C is dashed for live update)
            array.set(major_corrective_lines, 0, line.new(b0, p0, b1, p1, color=wave_color, width=3, style=line.style_solid))
            array.set(major_corrective_lines, 1, line.new(b1, p1, b2, p2, color=wave_color, width=3, style=line.style_solid))
            array.set(major_corrective_lines, 2, line.new(b2, p2, b3, p3, color=wave_color, width=3, style=line.style_dashed))  // Last wave: dashed

            // Major corrective labels (bold uppercase, far from candles)
            label_offset_major = atr_value * label_offset_multiplier * 3.0
            array.set(major_corrective_labels, 0, label.new(b1, is_bullish ? p1 + label_offset_major : p1 - label_offset_major,
                     "A", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color_corrective_label, size=size.large, textalign=text.align_center))
            array.set(major_corrective_labels, 1, label.new(b2, is_bullish ? p2 - label_offset_major : p2 + label_offset_major,
                     "B", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color_corrective_label, size=size.large, textalign=text.align_center))
            array.set(major_corrective_labels, 2, label.new(b3, is_bullish ? p3 + label_offset_major : p3 - label_offset_major,
                     "C?", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color.new(color_corrective_label, 50), size=size.large, textalign=text.align_center))  // "C?" for uncertain last wave

// Detect Minor Impulse Waves (소파동 임펄스: i, ii, iii, iv, v)
f_detect_minor_impulse() =>
    if array.size(minor_zz_price) >= 6 and show_fractal_elliott and show_minor_waves
        size = array.size(minor_zz_price)

        // Get last 6 pivots for sub-impulse pattern
        p0 = array.get(minor_zz_price, size - 6)
        p1 = array.get(minor_zz_price, size - 5)
        p2 = array.get(minor_zz_price, size - 4)
        p3 = array.get(minor_zz_price, size - 3)
        p4 = array.get(minor_zz_price, size - 2)
        p5 = array.get(minor_zz_price, size - 1)

        b0 = array.get(minor_zz_bar, size - 6)
        b1 = array.get(minor_zz_bar, size - 5)
        b2 = array.get(minor_zz_bar, size - 4)
        b3 = array.get(minor_zz_bar, size - 3)
        b4 = array.get(minor_zz_bar, size - 2)
        b5 = array.get(minor_zz_bar, size - 1)

        d0 = array.get(minor_zz_direction, size - 6)
        is_bullish = d0 == -1

        // Directional color based on wave direction
        wave_color = is_bullish ? color_bullish_wave : color_bearish_wave

        // Sub-wave validation
        wave1 = math.abs(p1 - p0)
        wave2 = math.abs(p2 - p1)
        wave3 = math.abs(p3 - p2)
        wave4 = math.abs(p4 - p3)
        wave5 = math.abs(p5 - p4)

        retrace2 = wave2 / wave1
        valid_wave2 = retrace2 < 1.0
        valid_wave3 = wave3 > wave1 or wave3 > wave5
        valid_wave4 = is_bullish ? (p4 > p1) : (p4 < p1)

        if valid_wave2 and valid_wave3 and valid_wave4
            // Delete old lines/labels for live update
            for i = 0 to 4
                if not na(array.get(minor_impulse_lines, i))
                    line.delete(array.get(minor_impulse_lines, i))
                if not na(array.get(minor_impulse_labels, i))
                    label.delete(array.get(minor_impulse_labels, i))

            // Draw minor impulse lines (thin, last wave is dashed for live update)
            array.set(minor_impulse_lines, 0, line.new(b0, p0, b1, p1, color=wave_color, width=1, style=line.style_dotted))
            array.set(minor_impulse_lines, 1, line.new(b1, p1, b2, p2, color=wave_color, width=1, style=line.style_dotted))
            array.set(minor_impulse_lines, 2, line.new(b2, p2, b3, p3, color=wave_color, width=1, style=line.style_dotted))
            array.set(minor_impulse_lines, 3, line.new(b3, p3, b4, p4, color=wave_color, width=1, style=line.style_dotted))
            array.set(minor_impulse_lines, 4, line.new(b4, p4, b5, p5, color=wave_color, width=1, style=line.style_dashed))  // Last wave: more dashed

            // Minor wave labels (lowercase Roman numerals, close to candles)
            label_offset_minor = atr_value * label_offset_multiplier * 0.5
            array.set(minor_impulse_labels, 0, label.new(b1, is_bullish ? p1 - label_offset_minor : p1 + label_offset_minor,
                     "i", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color_impulse_label, size=size.tiny, textalign=text.align_center))
            array.set(minor_impulse_labels, 1, label.new(b2, is_bullish ? p2 + label_offset_minor : p2 - label_offset_minor,
                     "ii", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color_impulse_label, size=size.tiny, textalign=text.align_center))
            array.set(minor_impulse_labels, 2, label.new(b3, is_bullish ? p3 - label_offset_minor : p3 + label_offset_minor,
                     "iii", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color_impulse_label, size=size.tiny, textalign=text.align_center))
            array.set(minor_impulse_labels, 3, label.new(b4, is_bullish ? p4 + label_offset_minor : p4 - label_offset_minor,
                     "iv", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color_impulse_label, size=size.tiny, textalign=text.align_center))
            array.set(minor_impulse_labels, 4, label.new(b5, is_bullish ? p5 - label_offset_minor : p5 + label_offset_minor,
                     "v?", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color.new(color_impulse_label, 50), size=size.tiny, textalign=text.align_center))  // "v?" for uncertain last wave

            // Elliott Wave enhancements for minor waves
            if show_alternation
                retrace4 = wave4 / wave3
                wave2_sharp = retrace2 >= 0.50
                wave2_shallow = retrace2 < 0.50
                wave4_shallow = retrace4 < 0.50
                wave4_deep = retrace4 >= 0.50
                alternation_valid = (wave2_sharp and wave4_shallow) or (wave2_shallow and wave4_deep)

                if not alternation_valid
                    warning_text = wave2_sharp ? "⚠ ii Sharp + iv Deep" : "⚠ ii Shallow + iv Shallow"
                    label.new(b4, is_bullish ? p4 + label_offset_minor * 2 : p4 - label_offset_minor * 2,
                             warning_text, style=label.style_none,
                             textcolor=color.new(color.orange, 30), size=size.tiny)

            if show_elliott_channels
                bars_02 = b2 - b0
                price_02 = p2 - p0
                slope = bars_02 != 0 ? price_02 / bars_02 : 0

                line.new(b0, p0, b2, p2, color=color.new(wave_color, 70),
                         width=1, style=line.style_dotted, extend=extend.right)

                bars_to_5 = b5 - b0
                channel_target = p0 + (slope * bars_to_5)
                parallel_offset = p1 - (p0 + (slope * (b1 - b0)))
                channel_parallel = channel_target + parallel_offset

                line.new(b1, p1, b5, channel_parallel, color=color.new(wave_color, 70),
                         width=1, style=line.style_dotted, extend=extend.right)

            if show_extension_labels
                wave1_extended = wave1 > wave3 * 1.618 or wave1 > wave5 * 1.618
                wave3_extended = wave3 > wave1 * 1.618 or wave3 > wave5 * 1.618
                wave5_extended = wave5 > wave1 * 1.618 or wave5 > wave3 * 1.618

                if wave3_extended
                    label.new(b3, is_bullish ? p3 - label_offset_minor * 2 : p3 + label_offset_minor * 2,
                             "iii Ext", style=label.style_none,
                             textcolor=color.new(color_impulse_label, 40), size=size.tiny)

// Detect Minor Corrective Waves (소파동 조정: a, b, c)
f_detect_minor_corrective() =>
    if array.size(minor_zz_price) >= 4 and show_fractal_elliott and show_minor_waves
        size = array.size(minor_zz_price)

        // Get last 4 pivots for abc pattern
        p0 = array.get(minor_zz_price, size - 4)
        p1 = array.get(minor_zz_price, size - 3)
        p2 = array.get(minor_zz_price, size - 2)
        p3 = array.get(minor_zz_price, size - 1)

        b0 = array.get(minor_zz_bar, size - 4)
        b1 = array.get(minor_zz_bar, size - 3)
        b2 = array.get(minor_zz_bar, size - 2)
        b3 = array.get(minor_zz_bar, size - 1)

        d0 = array.get(minor_zz_direction, size - 4)
        is_bullish = d0 == 1

        // Directional color based on wave direction
        wave_color = is_bullish ? color_bearish_wave : color_bullish_wave  // Reversed because corrections go opposite direction

        // abc pattern validation
        wave_a = math.abs(p1 - p0)
        wave_b = math.abs(p2 - p1)
        wave_c = math.abs(p3 - p2)

        retrace_b = wave_b / wave_a
        valid_abc = retrace_b > 0.236 and retrace_b < 1.0

        if valid_abc
            // Delete old lines/labels for live update
            for i = 0 to 2
                if not na(array.get(minor_corrective_lines, i))
                    line.delete(array.get(minor_corrective_lines, i))
                if not na(array.get(minor_corrective_labels, i))
                    label.delete(array.get(minor_corrective_labels, i))

            // Draw minor corrective lines (last wave c is dashed for live update)
            array.set(minor_corrective_lines, 0, line.new(b0, p0, b1, p1, color=wave_color, width=1, style=line.style_dotted))
            array.set(minor_corrective_lines, 1, line.new(b1, p1, b2, p2, color=wave_color, width=1, style=line.style_dotted))
            array.set(minor_corrective_lines, 2, line.new(b2, p2, b3, p3, color=wave_color, width=1, style=line.style_dashed))  // Last wave: more dashed

            // Minor corrective labels (lowercase letters, close to candles)
            label_offset_minor = atr_value * label_offset_multiplier * 0.5
            array.set(minor_corrective_labels, 0, label.new(b1, is_bullish ? p1 + label_offset_minor : p1 - label_offset_minor,
                     "a", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color_corrective_label, size=size.tiny, textalign=text.align_center))
            array.set(minor_corrective_labels, 1, label.new(b2, is_bullish ? p2 - label_offset_minor : p2 + label_offset_minor,
                     "b", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color_corrective_label, size=size.tiny, textalign=text.align_center))
            array.set(minor_corrective_labels, 2, label.new(b3, is_bullish ? p3 + label_offset_minor : p3 - label_offset_minor,
                     "c?", style=label.style_none, color=color.new(color.white, 100),
                     textcolor=color.new(color_corrective_label, 50), size=size.tiny, textalign=text.align_center))  // "c?" for uncertain last wave

// ═══════════════════════════════════════════════════════════════════════════════
// IV. HELPER FUNCTIONS (헬퍼 함수)
// ═══════════════════════════════════════════════════════════════════════════════

// Check if value is within tolerance of target
f_within_tolerance(value, target, tolerance) =>
    math.abs(value - target) <= tolerance

// Enhanced flexible tolerance that prevents invading adjacent Fibonacci levels
// Returns dynamic tolerance based on target and spacing between Fib levels
f_flexible_tolerance(target, prev_level=na, next_level=na) =>
    // Start with base tolerance range
    base_tolerance = fib_tolerance_min
    max_tolerance = fib_tolerance_max

    // Calculate safe tolerance based on adjacent levels
    safe_tolerance = max_tolerance

    if not na(prev_level)
        // Distance to previous level (e.g., 0.618 - 0.5 = 0.118)
        dist_to_prev = math.abs(target - prev_level)
        // Max safe tolerance is half the distance (to not cross midpoint)
        safe_tolerance := math.min(safe_tolerance, dist_to_prev / 2)

    if not na(next_level)
        // Distance to next level (e.g., 0.786 - 0.618 = 0.168)
        dist_to_next = math.abs(next_level - target)
        safe_tolerance := math.min(safe_tolerance, dist_to_next / 2)

    // Ensure tolerance is within min-max range
    final_tolerance = math.max(base_tolerance, math.min(safe_tolerance, max_tolerance))
    final_tolerance

// Check if value matches target with flexible tolerance
f_within_flexible_tolerance(value, target, prev_level=na, next_level=na) =>
    tolerance = f_flexible_tolerance(target, prev_level, next_level)
    math.abs(value - target) <= tolerance

// Calculate retracement ratio (with zero-division protection)
f_retracement(a, b, c) =>
    divisor = (a - b)
    divisor != 0 ? math.abs((c - b) / divisor) : 0.0

// Calculate extension ratio (with zero-division protection)
f_extension(a, b, c) =>
    divisor = (a - b)
    divisor != 0 ? math.abs((c - b) / divisor) : 0.0

// Get ATR for label offset calculation
atr_value = ta.atr(14)

// Calculate label offset based on direction
f_label_offset(is_bullish, multiplier=1.0) =>
    offset = atr_value * label_offset_multiplier * multiplier
    is_bullish ? offset : -offset

// ═══════════════════════════════════════════════════════════════════════════════
// V. ELLIOTT WAVE DETECTION (엘리엇 파동 탐지 - Legacy ZigZag)
// ═══════════════════════════════════════════════════════════════════════════════

// Persistent storage for live updates (라이브 업데이트용 저장소)
var label[] legacy_impulse_labels = array.new<label>(5)
var line[] legacy_impulse_lines = array.new<line>(5)
var label[] legacy_corrective_labels = array.new<label>(3)
var line[] legacy_corrective_lines = array.new<line>(3)

// Detect Impulse Waves (1, 2, 3, 4, 5)
f_detect_impulse_wave() =>
    if array.size(zz_price) >= 6 and show_elliott and show_elliott_impulse
        size = array.size(zz_price)

        // Get last 6 pivots (for 5-wave pattern)
        p0 = array.get(zz_price, size - 6)
        p1 = array.get(zz_price, size - 5)
        p2 = array.get(zz_price, size - 4)
        p3 = array.get(zz_price, size - 3)
        p4 = array.get(zz_price, size - 2)
        p5 = array.get(zz_price, size - 1)

        b0 = array.get(zz_bar, size - 6)
        b1 = array.get(zz_bar, size - 5)
        b2 = array.get(zz_bar, size - 4)
        b3 = array.get(zz_bar, size - 3)
        b4 = array.get(zz_bar, size - 2)
        b5 = array.get(zz_bar, size - 1)

        d0 = array.get(zz_direction, size - 6)

        // Check for bullish impulse (starting from low)
        is_bullish = d0 == -1

        // Directional color based on wave direction
        wave_color = is_bullish ? color_bullish_wave : color_bearish_wave

        // Impulse wave rules:
        // - Wave 2 cannot retrace more than 100% of wave 1
        // - Wave 3 cannot be the shortest
        // - Wave 4 cannot overlap wave 1

        wave1 = math.abs(p1 - p0)
        wave2 = math.abs(p2 - p1)
        wave3 = math.abs(p3 - p2)
        wave4 = math.abs(p4 - p3)
        wave5 = math.abs(p5 - p4)

        // Check wave 2 retracement
        retrace2 = wave2 / wave1
        valid_wave2 = retrace2 < 1.0

        // Check wave 3 is not shortest
        valid_wave3 = wave3 > wave1 or wave3 > wave5

        // Check wave 4 doesn't overlap wave 1
        valid_wave4 = is_bullish ? (p4 > p1) : (p4 < p1)

        // Check for truncated wave 5
        is_truncated = is_bullish ? (p5 < p3) : (p5 > p3)

        // Check for diagonal (wave 3 is not longest)
        is_diagonal = not (wave3 > wave1 and wave3 > wave5)

        // ── TIME ANALYSIS (Glenn Neely - Critical Rule) ──────────────────
        // Wave-3 should take 40-60% of (Wave-1 + Wave-2) time
        // Deviation indicates corrective structure, not impulsive
        time_wave1 = b1 - b0
        time_wave2 = b2 - b1
        time_wave3 = b3 - b2
        time_wave4 = b4 - b3
        time_wave5 = b5 - b4

        time_wave12 = time_wave1 + time_wave2
        time_ratio = time_wave12 != 0 ? time_wave3 / time_wave12 : 0

        // Valid impulse: Wave-3 time between 40-60% of (Wave-1 + Wave-2)
        valid_time_ratio = time_ratio >= 0.4 and time_ratio <= 0.6

        // Velocity check: Wave-3 too violent indicates pattern change
        velocity_wave3 = time_wave3 != 0 ? wave3 / time_wave3 : 0
        avg_velocity = ((wave1 / time_wave1) + (wave5 / time_wave5)) / 2
        too_violent = velocity_wave3 > avg_velocity * 2.5

        // Time-based pattern quality
        time_valid = valid_time_ratio and not too_violent
        time_warning = not valid_time_ratio or too_violent

        if valid_wave2 and valid_wave3 and valid_wave4
            // Delete old lines/labels for live update
            for i = 0 to 4
                if not na(array.get(legacy_impulse_lines, i))
                    line.delete(array.get(legacy_impulse_lines, i))
                if not na(array.get(legacy_impulse_labels, i))
                    label.delete(array.get(legacy_impulse_labels, i))

            // Draw impulse wave lines (last wave dashed)
            array.set(legacy_impulse_lines, 0, line.new(b0, p0, b1, p1, color=wave_color, width=2, style=line.style_solid))
            array.set(legacy_impulse_lines, 1, line.new(b1, p1, b2, p2, color=wave_color, width=2, style=line.style_solid))
            array.set(legacy_impulse_lines, 2, line.new(b2, p2, b3, p3, color=wave_color, width=2, style=line.style_solid))
            array.set(legacy_impulse_lines, 3, line.new(b3, p3, b4, p4, color=wave_color, width=2, style=line.style_solid))
            array.set(legacy_impulse_lines, 4, line.new(b4, p4, b5, p5, color=wave_color, width=2, style=line.style_dashed))  // Last wave dashed

            // Place labels
            array.set(legacy_impulse_labels, 0, label.new(b1, p1, "①", style=is_bullish ? label.style_label_up : label.style_label_down, color=color_impulse_label, textcolor=color.white, size=size.normal))
            array.set(legacy_impulse_labels, 1, label.new(b2, p2, "②", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_impulse_label, textcolor=color.white, size=size.normal))
            array.set(legacy_impulse_labels, 2, label.new(b3, p3, "③", style=is_bullish ? label.style_label_up : label.style_label_down, color=color_impulse_label, textcolor=color.white, size=size.normal))
            array.set(legacy_impulse_labels, 3, label.new(b4, p4, "④", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_impulse_label, textcolor=color.white, size=size.normal))

            // Label wave 5 (or 5T if truncated) - uncertain with ?
            if is_truncated and show_truncated
                array.set(legacy_impulse_labels, 4, label.new(b5, p5, "⑤T?", style=is_bullish ? label.style_label_up : label.style_label_down, color=color.new(color_impulse_label, 30), textcolor=color.white, size=size.normal))
                // Add truncation annotation
                line.new(b3, p3, b5, p5, color=wave_color, width=1, style=line.style_dashed)
                label.new(b5, p5 + (is_bullish ? atr_value : -atr_value), "Truncated 5?", style=label.style_none, color=color.new(color.white, 100), textcolor=color.new(color_impulse_label, 50), size=size.small)
            else
                array.set(legacy_impulse_labels, 4, label.new(b5, p5, "⑤?", style=is_bullish ? label.style_label_up : label.style_label_down, color=color.new(color_impulse_label, 30), textcolor=color.white, size=size.normal))

            // Check and label diagonal
            if is_diagonal and show_diagonal
                label.new(b3, p3 + (is_bullish ? atr_value * 2 : -atr_value * 2), "Diagonal?", style=label.style_none, color=color.new(color.white, 100), textcolor=color.new(color_impulse_label, 50), size=size.small)

            // TIME ANALYSIS (Glenn Neely - Internal Validation Only)
            // Note: Time validation is performed internally but not displayed on chart
            // time_valid and time_warning variables are calculated above for internal use
            // UI warnings removed per user request to avoid chart clutter

            // Elliott Wave enhancements for legacy impulse
            if show_alternation
                retrace4 = wave4 / wave3
                wave2_sharp = retrace2 >= 0.50
                wave2_shallow = retrace2 < 0.50
                wave4_shallow = retrace4 < 0.50
                wave4_deep = retrace4 >= 0.50
                alternation_valid = (wave2_sharp and wave4_shallow) or (wave2_shallow and wave4_deep)

                if not alternation_valid
                    warning_text = wave2_sharp ? "⚠ Alt: ② Sharp + ④ Deep" : "⚠ Alt: ② Shallow + ④ Shallow"
                    label.new(b4, is_bullish ? p4 - atr_value * 2 : p4 + atr_value * 2,
                             warning_text, style=label.style_none,
                             textcolor=color.new(color.orange, 0), size=size.tiny)

            if show_elliott_channels
                bars_02 = b2 - b0
                price_02 = p2 - p0
                slope = bars_02 != 0 ? price_02 / bars_02 : 0

                line.new(b0, p0, b2, p2, color=color.new(wave_color, 60),
                         width=1, style=line.style_dotted, extend=extend.right)

                bars_to_5 = b5 - b0
                channel_target = p0 + (slope * bars_to_5)
                parallel_offset = p1 - (p0 + (slope * (b1 - b0)))
                channel_parallel = channel_target + parallel_offset

                line.new(b1, p1, b5, channel_parallel, color=color.new(wave_color, 60),
                         width=1, style=line.style_dotted, extend=extend.right)

                label.new(b5 + 3, channel_parallel, "Ch", style=label.style_none,
                         textcolor=color.new(color_impulse_label, 60), size=size.tiny)

            if show_extension_labels
                wave1_extended = wave1 > wave3 * 1.618 or wave1 > wave5 * 1.618
                wave3_extended = wave3 > wave1 * 1.618 or wave3 > wave5 * 1.618
                wave5_extended = wave5 > wave1 * 1.618 or wave5 > wave3 * 1.618

                extension_text = ""
                equality_text = ""

                if wave3_extended
                    extension_text := "③ Ext"
                    ratio_15 = wave1 > wave5 ? wave5 / wave1 : wave1 / wave5
                    if ratio_15 >= 0.90 and ratio_15 <= 1.10
                        equality_text := "①≈⑤"
                else if wave1_extended
                    extension_text := "① Ext"
                else if wave5_extended
                    extension_text := "⑤ Ext"

                if extension_text != ""
                    label.new(b3, is_bullish ? p3 + atr_value * 2 : p3 - atr_value * 2,
                             extension_text, style=label.style_none,
                             textcolor=color.new(color_impulse_label, 30), size=size.small)

                if equality_text != ""
                    label.new(b5 + 5, is_bullish ? p5 + atr_value : p5 - atr_value,
                             equality_text, style=label.style_none,
                             textcolor=color.new(color_impulse_label, 40), size=size.tiny)

// Detect Corrective Waves (ABC)
f_detect_corrective_wave() =>
    if array.size(zz_price) >= 4 and show_elliott and show_elliott_corrective
        size = array.size(zz_price)

        // Get last 4 pivots (for ABC pattern)
        p0 = array.get(zz_price, size - 4)
        p1 = array.get(zz_price, size - 3)
        p2 = array.get(zz_price, size - 2)
        p3 = array.get(zz_price, size - 1)

        b0 = array.get(zz_bar, size - 4)
        b1 = array.get(zz_bar, size - 3)
        b2 = array.get(zz_bar, size - 2)
        b3 = array.get(zz_bar, size - 1)

        d0 = array.get(zz_direction, size - 4)
        is_bullish = d0 == 1 // Corrective after bullish move

        // Directional color based on wave direction
        wave_color = is_bullish ? color_bearish_wave : color_bullish_wave  // Reversed because corrections go opposite direction

        // Check if this is a completed correction
        waveA = math.abs(p1 - p0)
        waveB = math.abs(p2 - p1)
        waveC = math.abs(p3 - p2)

        // Basic ABC validation
        if waveA > 0 and waveB > 0 and waveC > 0
            // Delete old lines/labels for live update
            for i = 0 to 2
                if not na(array.get(legacy_corrective_lines, i))
                    line.delete(array.get(legacy_corrective_lines, i))
                if not na(array.get(legacy_corrective_labels, i))
                    label.delete(array.get(legacy_corrective_labels, i))

            // Draw corrective wave lines (last wave C is dashed)
            array.set(legacy_corrective_lines, 0, line.new(b0, p0, b1, p1, color=wave_color, width=2, style=line.style_solid))
            array.set(legacy_corrective_lines, 1, line.new(b1, p1, b2, p2, color=wave_color, width=2, style=line.style_solid))
            array.set(legacy_corrective_lines, 2, line.new(b2, p2, b3, p3, color=wave_color, width=2, style=line.style_dashed))  // Last wave dashed

            // Place labels (C is uncertain with ?)
            array.set(legacy_corrective_labels, 0, label.new(b1, p1, "Ⓐ", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_corrective_label, textcolor=color.white, size=size.normal))
            array.set(legacy_corrective_labels, 1, label.new(b2, p2, "Ⓑ", style=is_bullish ? label.style_label_up : label.style_label_down, color=color_corrective_label, textcolor=color.white, size=size.normal))
            array.set(legacy_corrective_labels, 2, label.new(b3, p3, "Ⓒ?", style=is_bullish ? label.style_label_down : label.style_label_up, color=color.new(color_corrective_label, 30), textcolor=color.white, size=size.normal))

// Detect Connecting Waves (WXY)
f_detect_connecting_wave_wxy() =>
    if array.size(zz_price) >= 6 and show_elliott and show_elliott_connecting
        size = array.size(zz_price)

        // Get last 6 pivots for WXY pattern
        p0 = array.get(zz_price, size - 6)
        p1 = array.get(zz_price, size - 5)
        p2 = array.get(zz_price, size - 4)
        p3 = array.get(zz_price, size - 3)
        p4 = array.get(zz_price, size - 2)
        p5 = array.get(zz_price, size - 1)

        b0 = array.get(zz_bar, size - 6)
        b1 = array.get(zz_bar, size - 5)
        b2 = array.get(zz_bar, size - 4)
        b3 = array.get(zz_bar, size - 3)
        b4 = array.get(zz_bar, size - 2)
        b5 = array.get(zz_bar, size - 1)

        d0 = array.get(zz_direction, size - 6)
        is_bullish = d0 == -1

        // Directional color based on wave direction
        wave_color = is_bullish ? color_bearish_wave : color_bullish_wave  // Reversed because corrections go opposite direction

        // WXY structure: W (3 waves), X (connector), Y (3 waves)
        // Simplified: each segment is a corrective structure

        // Draw lines
        line.new(b0, p0, b2, p2, color=wave_color, width=1, style=line.style_solid)
        line.new(b2, p2, b4, p4, color=wave_color, width=1, style=line.style_dashed)
        line.new(b4, p4, b5, p5, color=wave_color, width=1, style=line.style_solid)

        // Place labels
        label.new(b2, p2, "W", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_corrective_label, textcolor=color.white, size=size.small)
        label.new(b3, p3, "X", style=is_bullish ? label.style_label_up : label.style_label_down, color=color_corrective_label, textcolor=color.white, size=size.small)
        label.new(b5, p5, "Y", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_corrective_label, textcolor=color.white, size=size.small)

// Detect Triangle Waves (ABCDE)
f_detect_triangle_wave() =>
    if array.size(zz_price) >= 6 and show_elliott and show_elliott_triangle
        size = array.size(zz_price)

        // Get last 6 pivots for triangle pattern (5 points + origin)
        p0 = array.get(zz_price, size - 6)
        p1 = array.get(zz_price, size - 5)
        p2 = array.get(zz_price, size - 4)
        p3 = array.get(zz_price, size - 3)
        p4 = array.get(zz_price, size - 2)
        p5 = array.get(zz_price, size - 1)

        b0 = array.get(zz_bar, size - 6)
        b1 = array.get(zz_bar, size - 5)
        b2 = array.get(zz_bar, size - 4)
        b3 = array.get(zz_bar, size - 3)
        b4 = array.get(zz_bar, size - 2)
        b5 = array.get(zz_bar, size - 1)

        d0 = array.get(zz_direction, size - 6)
        is_bullish = d0 == 1

        // Directional color based on wave direction
        wave_color = is_bullish ? color_bearish_wave : color_bullish_wave  // Reversed because corrections go opposite direction

        // Calculate ranges to detect converging/expanding
        range1 = math.abs(p1 - p0)
        range2 = math.abs(p2 - p1)
        range3 = math.abs(p3 - p2)
        range4 = math.abs(p4 - p3)
        range5 = math.abs(p5 - p4)

        // Check if converging (each swing smaller)
        is_converging = range5 < range4 and range4 < range3 and range3 < range2

        // Check if expanding (each swing larger)
        is_expanding = range5 > range4 and range4 > range3 and range3 > range2

        if is_converging or is_expanding
            // Draw triangle lines
            line.new(b0, p0, b1, p1, color=wave_color, width=1)
            line.new(b1, p1, b2, p2, color=wave_color, width=1)
            line.new(b2, p2, b3, p3, color=wave_color, width=1)
            line.new(b3, p3, b4, p4, color=wave_color, width=1)
            line.new(b4, p4, b5, p5, color=wave_color, width=1)

            // Place labels
            label.new(b1, p1, "A", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_corrective_label, textcolor=color.white, size=size.small)
            label.new(b2, p2, "B", style=is_bullish ? label.style_label_up : label.style_label_down, color=color_corrective_label, textcolor=color.white, size=size.small)
            label.new(b3, p3, "C", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_corrective_label, textcolor=color.white, size=size.small)
            label.new(b4, p4, "D", style=is_bullish ? label.style_label_up : label.style_label_down, color=color_corrective_label, textcolor=color.white, size=size.small)
            label.new(b5, p5, "E", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_corrective_label, textcolor=color.white, size=size.small)

            // Add pattern type label
            if is_expanding
                label.new(b3, p3 + (is_bullish ? -atr_value * 2 : atr_value * 2), "Expanding Triangle", style=label.style_none, textcolor=color_corrective_label, size=size.small)
            else
                label.new(b3, p3 + (is_bullish ? -atr_value * 2 : atr_value * 2), "Converging Triangle", style=label.style_none, textcolor=color_corrective_label, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// VI. HARMONIC PATTERN DETECTION (하모닉 패턴 탐지)
// ═══════════════════════════════════════════════════════════════════════════════

// PRZ (Potential Reversal Zone) Calculation - Scott Carney Critical Enhancement
// Calculates confluence of multiple Fibonacci levels for high-probability reversal zones
f_calculate_prz(x, a, b, c, is_bullish) =>
    xa_distance = math.abs(a - x)
    ab_distance = math.abs(b - a)
    bc_distance = math.abs(c - b)

    // Calculate multiple D point projections
    d_xad_0786 = is_bullish ? x - (xa_distance * FIB_0786) : x + (xa_distance * FIB_0786)
    d_xad_0886 = is_bullish ? x - (xa_distance * FIB_0886) : x + (xa_distance * FIB_0886)
    d_xad_1272 = is_bullish ? x - (xa_distance * FIB_1272) : x + (xa_distance * FIB_1272)
    d_xad_1618 = is_bullish ? x - (xa_distance * FIB_1618) : x + (xa_distance * FIB_1618)

    // AB=CD completion levels
    d_abcd_1000 = is_bullish ? c - ab_distance : c + ab_distance
    d_abcd_1272 = is_bullish ? c - (ab_distance * FIB_1272) : c + (ab_distance * FIB_1272)
    d_abcd_1618 = is_bullish ? c - (ab_distance * FIB_1618) : c + (ab_distance * FIB_1618)

    // BC projection levels
    d_bcd_1618 = is_bullish ? c - (bc_distance * FIB_1618) : c + (bc_distance * FIB_1618)
    d_bcd_2000 = is_bullish ? c - (bc_distance * FIB_2000) : c + (bc_distance * FIB_2000)
    d_bcd_2618 = is_bullish ? c - (bc_distance * FIB_2618) : c + (bc_distance * FIB_2618)

    // Store all levels in array for confluence calculation
    var float[] prz_levels = array.new<float>(0)
    array.clear(prz_levels)
    array.push(prz_levels, d_xad_0786)
    array.push(prz_levels, d_xad_0886)
    array.push(prz_levels, d_xad_1272)
    array.push(prz_levels, d_xad_1618)
    array.push(prz_levels, d_abcd_1000)
    array.push(prz_levels, d_abcd_1272)
    array.push(prz_levels, d_abcd_1618)
    array.push(prz_levels, d_bcd_1618)
    array.push(prz_levels, d_bcd_2000)
    array.push(prz_levels, d_bcd_2618)

    // Calculate PRZ confluence zone (where multiple levels cluster)
    // Sort levels
    array.sort(prz_levels)

    // Find the zone with maximum confluence (most levels within 1% range)
    max_confluence = 0
    prz_center = d_xad_0786
    prz_range = 0.0

    for i = 0 to array.size(prz_levels) - 1
        level = array.get(prz_levels, i)
        confluence_count = 0

        // Count how many levels are within 1% of this level
        for j = 0 to array.size(prz_levels) - 1
            other_level = array.get(prz_levels, j)
            // Zero-division protection
            if level != 0 and math.abs(other_level - level) / level <= 0.01  // Within 1%
                confluence_count += 1

        if confluence_count > max_confluence
            max_confluence := confluence_count
            prz_center := level

    // Calculate PRZ range (±0.5% from center)
    prz_range := math.abs(prz_center * 0.005)

    [prz_center, prz_range, max_confluence]

// Detect Gartley Pattern
f_detect_gartley() =>
    if array.size(zz_price) >= 5 and show_harmonic
        size = array.size(zz_price)

        // XABCD points
        x = array.get(zz_price, size - 5)
        a = array.get(zz_price, size - 4)
        b = array.get(zz_price, size - 3)
        c = array.get(zz_price, size - 2)
        d = array.get(zz_price, size - 1)

        bx = array.get(zz_bar, size - 5)
        ba = array.get(zz_bar, size - 4)
        bb = array.get(zz_bar, size - 3)
        bc = array.get(zz_bar, size - 2)
        bd = array.get(zz_bar, size - 1)

        // Calculate ratios
        xab = f_retracement(x, a, b)
        abc = f_retracement(a, b, c)
        bcd = f_retracement(b, c, d)
        xad = f_retracement(x, a, d)

        // Gartley ratios with flexible tolerance:
        // XAB = 0.618 (between 0.5 and 0.786)
        // ABC = 0.382 - 0.886
        // BCD = 1.13 - 1.618
        // XAD = 0.786 (between 0.618 and 1.0)

        // Use flexible tolerance for key ratios
        xab_match = f_within_flexible_tolerance(xab, FIB_0618, FIB_0500, FIB_0786)
        xad_match = f_within_flexible_tolerance(xad, FIB_0786, FIB_0618, FIB_1000)

        // Range checks with flexible tolerance
        abc_min_tol = f_flexible_tolerance(FIB_0382, FIB_0236, FIB_0500)
        abc_max_tol = f_flexible_tolerance(FIB_0886, FIB_0786, FIB_1000)
        abc_match = (abc >= FIB_0382 - abc_min_tol and abc <= FIB_0886 + abc_max_tol)

        bcd_min_tol = f_flexible_tolerance(FIB_1130, FIB_1000, FIB_1272)
        bcd_max_tol = f_flexible_tolerance(FIB_1618, FIB_1414, FIB_2000)
        bcd_match = (bcd >= FIB_1130 - bcd_min_tol and bcd <= FIB_1618 + bcd_max_tol)

        // ── GARTLEY SPECIFICITY: BC/XA Ratio Check (Scott Carney) ──────────────
        // For a valid Gartley correction pattern, the BC leg must not exceed 1.272 of XA
        // This prevents over-extension and distinguishes Gartley from Butterfly patterns
        // BXC Ratio = BC leg length / XA leg length
        bc_length = math.abs(c - b)
        xa_length = math.abs(a - x)
        bc_xa_ratio = xa_length != 0 ? bc_length / xa_length : 0

        // BC must not violate 1.272 of XA for valid Gartley correction
        bc_valid = bc_xa_ratio <= FIB_1272

        is_gartley = xab_match and abc_match and bcd_match and xad_match and bc_valid

        // Potential pattern with wider tolerance
        is_potential = (not is_gartley) and show_potential and
                       f_within_tolerance(xab, FIB_0618, fib_tolerance_max * 1.2) and
                       f_within_tolerance(xad, FIB_0786, fib_tolerance_max * 1.2)

        if is_gartley or is_potential
            line_style = is_gartley ? line.style_solid : line.style_dashed
            pattern_label = is_gartley ? "Gartley" : "Potential Gartley"

            is_bullish = a > x

            // Directional color based on pattern direction
            pattern_color = is_bullish ? color_bullish_harmonic : color_bearish_harmonic

            // Draw pattern
            line.new(bx, x, ba, a, color=pattern_color, width=2, style=line_style)
            line.new(ba, a, bb, b, color=pattern_color, width=2, style=line_style)
            line.new(bb, b, bc, c, color=pattern_color, width=2, style=line_style)
            line.new(bc, c, bd, d, color=pattern_color, width=2, style=line_style)

            // Draw XB and AC lines
            line.new(bx, x, bb, b, color=color.new(pattern_color, 70), width=1, style=line.style_dotted)
            line.new(ba, a, bc, c, color=color.new(pattern_color, 70), width=1, style=line.style_dotted)

            // Labels
            label.new(bx, x, "X", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(ba, a, "A", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bb, b, "B", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bc, c, "C", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bd, d, "D", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)

            label.new(bc, c + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label, style=label.style_none, textcolor=color_gartley_label, size=size.normal)

// Detect Butterfly Pattern
f_detect_butterfly() =>
    if array.size(zz_price) >= 5 and show_harmonic
        size = array.size(zz_price)

        x = array.get(zz_price, size - 5)
        a = array.get(zz_price, size - 4)
        b = array.get(zz_price, size - 3)
        c = array.get(zz_price, size - 2)
        d = array.get(zz_price, size - 1)

        bx = array.get(zz_bar, size - 5)
        ba = array.get(zz_bar, size - 4)
        bb = array.get(zz_bar, size - 3)
        bc = array.get(zz_bar, size - 2)
        bd = array.get(zz_bar, size - 1)

        xab = f_retracement(x, a, b)
        abc = f_retracement(a, b, c)
        bcd = f_extension(b, c, d)
        xad = f_extension(x, a, d)

        // Butterfly ratios with flexible tolerance:
        // XAB = 0.786 (between 0.618 and 1.0)
        // ABC = 0.382 - 0.886
        // BCD = 1.618 - 2.24
        // XAD = 1.27 - 1.618 (STRICT: pattern invalid if outside this range)

        xab_match = f_within_flexible_tolerance(xab, FIB_0786, FIB_0618, FIB_1000)

        abc_min_tol = f_flexible_tolerance(FIB_0382, FIB_0236, FIB_0500)
        abc_max_tol = f_flexible_tolerance(FIB_0886, FIB_0786, FIB_1000)
        abc_match = (abc >= FIB_0382 - abc_min_tol and abc <= FIB_0886 + abc_max_tol)

        bcd_min_tol = f_flexible_tolerance(FIB_1618, FIB_1414, FIB_2000)
        bcd_max_tol = f_flexible_tolerance(FIB_2240, FIB_2000, FIB_2618)
        bcd_match = (bcd >= FIB_1618 - bcd_min_tol and bcd <= FIB_2240 + bcd_max_tol)

        // Strict XAD validation for Butterfly: XAD must EXCEED 1.272 and NOT violate 1.618
        // Range: 1.272 < XAD <= 1.618 (Scott Carney specification)
        // XAD > 1.272 ensures clear distinction from Gartley (XAD = 0.786)
        xad_max_tol = f_flexible_tolerance(FIB_1618, FIB_1618, FIB_1618)  // No upper tolerance
        xad_match = (xad > FIB_1272 and xad <= FIB_1618 + xad_max_tol)

        is_butterfly = xab_match and abc_match and bcd_match and xad_match

        is_potential = (not is_butterfly) and show_potential and
                       f_within_tolerance(xab, FIB_0786, fib_tolerance_max * 1.2)

        if is_butterfly or is_potential
            line_style = is_butterfly ? line.style_solid : line.style_dashed
            pattern_label = is_butterfly ? "Butterfly" : "Potential Butterfly"

            is_bullish = a > x
            pattern_color = is_bullish ? color_bullish_harmonic : color_bearish_harmonic

            line.new(bx, x, ba, a, color=pattern_color, width=2, style=line_style)
            line.new(ba, a, bb, b, color=pattern_color, width=2, style=line_style)
            line.new(bb, b, bc, c, color=pattern_color, width=2, style=line_style)
            line.new(bc, c, bd, d, color=pattern_color, width=2, style=line_style)

            label.new(bx, x, "X", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(ba, a, "A", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bb, b, "B", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bc, c, "C", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bd, d, "D", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)

            label.new(bc, c + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label, style=label.style_none, textcolor=color_butterfly_label, size=size.normal)

// Detect Bat Pattern
f_detect_bat() =>
    if array.size(zz_price) >= 5 and show_harmonic
        size = array.size(zz_price)

        x = array.get(zz_price, size - 5)
        a = array.get(zz_price, size - 4)
        b = array.get(zz_price, size - 3)
        c = array.get(zz_price, size - 2)
        d = array.get(zz_price, size - 1)

        bx = array.get(zz_bar, size - 5)
        ba = array.get(zz_bar, size - 4)
        bb = array.get(zz_bar, size - 3)
        bc = array.get(zz_bar, size - 2)
        bd = array.get(zz_bar, size - 1)

        xab = f_retracement(x, a, b)
        abc = f_retracement(a, b, c)
        bcd = f_retracement(b, c, d)
        xad = f_retracement(x, a, d)

        // Bat ratios with flexible tolerance:
        // XAB = 0.382 - 0.50
        // ABC = 0.382 - 0.886
        // BCD = 1.618 - 2.618
        // XAD = 0.886

        xab_min_tol = f_flexible_tolerance(FIB_0382, FIB_0236, FIB_0500)
        xab_max_tol = f_flexible_tolerance(FIB_0500, FIB_0382, FIB_0618)
        xab_match = (xab >= FIB_0382 - xab_min_tol and xab <= FIB_0500 + xab_max_tol)

        abc_min_tol = f_flexible_tolerance(FIB_0382, FIB_0236, FIB_0500)
        abc_max_tol = f_flexible_tolerance(FIB_0886, FIB_0786, FIB_1000)
        abc_match = (abc >= FIB_0382 - abc_min_tol and abc <= FIB_0886 + abc_max_tol)

        bcd_min_tol = f_flexible_tolerance(FIB_1618, FIB_1414, FIB_2000)
        bcd_max_tol = f_flexible_tolerance(FIB_2618, FIB_2240, FIB_3000)
        bcd_match = (bcd >= FIB_1618 - bcd_min_tol and bcd <= FIB_2618 + bcd_max_tol)

        xad_match = f_within_flexible_tolerance(xad, FIB_0886, FIB_0786, FIB_1000)

        is_bat = xab_match and abc_match and bcd_match and xad_match

        is_potential = (not is_bat) and show_potential and
                       (xab >= FIB_0382 - fib_tolerance_max * 1.2 and xab <= FIB_0500 + fib_tolerance_max * 1.2)

        if is_bat or is_potential
            line_style = is_bat ? line.style_solid : line.style_dashed
            pattern_label = is_bat ? "Bat" : "Potential Bat"

            is_bullish = a > x
            pattern_color = is_bullish ? color_bullish_harmonic : color_bearish_harmonic

            line.new(bx, x, ba, a, color=pattern_color, width=2, style=line_style)
            line.new(ba, a, bb, b, color=pattern_color, width=2, style=line_style)
            line.new(bb, b, bc, c, color=pattern_color, width=2, style=line_style)
            line.new(bc, c, bd, d, color=pattern_color, width=2, style=line_style)

            label.new(bx, x, "X", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(ba, a, "A", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bb, b, "B", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bc, c, "C", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bd, d, "D", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)

            label.new(bc, c + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label, style=label.style_none, textcolor=color_bat_label, size=size.normal)

// Detect Crab Pattern
f_detect_crab() =>
    if array.size(zz_price) >= 5 and show_harmonic
        size = array.size(zz_price)

        x = array.get(zz_price, size - 5)
        a = array.get(zz_price, size - 4)
        b = array.get(zz_price, size - 3)
        c = array.get(zz_price, size - 2)
        d = array.get(zz_price, size - 1)

        bx = array.get(zz_bar, size - 5)
        ba = array.get(zz_bar, size - 4)
        bb = array.get(zz_bar, size - 3)
        bc = array.get(zz_bar, size - 2)
        bd = array.get(zz_bar, size - 1)

        xab = f_retracement(x, a, b)
        abc = f_retracement(a, b, c)
        bcd = f_extension(b, c, d)
        xad = f_extension(x, a, d)

        // Crab ratios with flexible tolerance:
        // XAB = 0.382 - 0.618
        // ABC = 0.382 - 0.886
        // BCD = 2.24 - 3.618
        // XAD = 1.618

        xab_min_tol = f_flexible_tolerance(FIB_0382, FIB_0236, FIB_0500)
        xab_max_tol = f_flexible_tolerance(FIB_0618, FIB_0500, FIB_0786)
        xab_match = (xab >= FIB_0382 - xab_min_tol and xab <= FIB_0618 + xab_max_tol)

        abc_min_tol = f_flexible_tolerance(FIB_0382, FIB_0236, FIB_0500)
        abc_max_tol = f_flexible_tolerance(FIB_0886, FIB_0786, FIB_1000)
        abc_match = (abc >= FIB_0382 - abc_min_tol and abc <= FIB_0886 + abc_max_tol)

        bcd_min_tol = f_flexible_tolerance(FIB_2240, FIB_2000, FIB_2618)
        bcd_match = (bcd >= FIB_2240 - bcd_min_tol)

        xad_match = f_within_flexible_tolerance(xad, FIB_1618, FIB_1414, FIB_2000)

        is_crab = xab_match and abc_match and bcd_match and xad_match

        is_potential = (not is_crab) and show_potential and
                       f_within_tolerance(xad, FIB_1618, fib_tolerance_max * 1.2)

        if is_crab or is_potential
            line_style = is_crab ? line.style_solid : line.style_dashed
            pattern_label = is_crab ? "Crab" : "Potential Crab"

            is_bullish = a > x
            pattern_color = is_bullish ? color_bullish_harmonic : color_bearish_harmonic

            line.new(bx, x, ba, a, color=pattern_color, width=2, style=line_style)
            line.new(ba, a, bb, b, color=pattern_color, width=2, style=line_style)
            line.new(bb, b, bc, c, color=pattern_color, width=2, style=line_style)
            line.new(bc, c, bd, d, color=pattern_color, width=2, style=line_style)

            label.new(bx, x, "X", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(ba, a, "A", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bb, b, "B", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bc, c, "C", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bd, d, "D", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)

            label.new(bc, c + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label, style=label.style_none, textcolor=color_crab_label, size=size.normal)

// Detect Shark Pattern
f_detect_shark() =>
    if array.size(zz_price) >= 5 and show_harmonic
        size = array.size(zz_price)

        x = array.get(zz_price, size - 5)
        a = array.get(zz_price, size - 4)
        b = array.get(zz_price, size - 3)
        c = array.get(zz_price, size - 2)
        d = array.get(zz_price, size - 1)

        bx = array.get(zz_bar, size - 5)
        ba = array.get(zz_bar, size - 4)
        bb = array.get(zz_bar, size - 3)
        bc = array.get(zz_bar, size - 2)
        bd = array.get(zz_bar, size - 1)

        xab = f_retracement(x, a, b)
        abc = f_retracement(a, b, c)
        xad = f_extension(x, a, d)

        // Shark ratios with flexible tolerance:
        // XAB = 0.382 - 0.618
        // ABC = 1.13 - 1.618
        // XAD = 0.886 - 1.13

        xab_min_tol = f_flexible_tolerance(FIB_0382, FIB_0236, FIB_0500)
        xab_max_tol = f_flexible_tolerance(FIB_0618, FIB_0500, FIB_0786)
        xab_match = (xab >= FIB_0382 - xab_min_tol and xab <= FIB_0618 + xab_max_tol)

        abc_min_tol = f_flexible_tolerance(FIB_1130, FIB_1000, FIB_1272)
        abc_max_tol = f_flexible_tolerance(FIB_1618, FIB_1414, FIB_2000)
        abc_match = (abc >= FIB_1130 - abc_min_tol and abc <= FIB_1618 + abc_max_tol)

        xad_min_tol = f_flexible_tolerance(FIB_0886, FIB_0786, FIB_1000)
        xad_max_tol = f_flexible_tolerance(FIB_1130, FIB_1000, FIB_1272)
        xad_match = (xad >= FIB_0886 - xad_min_tol and xad <= FIB_1130 + xad_max_tol)

        is_shark = xab_match and abc_match and xad_match

        is_potential = (not is_shark) and show_potential and
                       (xab >= FIB_0382 - fib_tolerance_max * 1.2 and xab <= FIB_0618 + fib_tolerance_max * 1.2)

        if is_shark or is_potential
            line_style = is_shark ? line.style_solid : line.style_dashed
            pattern_label = is_shark ? "Shark" : "Potential Shark"

            is_bullish = a > x
            pattern_color = is_bullish ? color_bullish_harmonic : color_bearish_harmonic

            line.new(bx, x, ba, a, color=pattern_color, width=2, style=line_style)
            line.new(ba, a, bb, b, color=pattern_color, width=2, style=line_style)
            line.new(bb, b, bc, c, color=pattern_color, width=2, style=line_style)
            line.new(bc, c, bd, d, color=pattern_color, width=2, style=line_style)

            label.new(bx, x, "X", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(ba, a, "A", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bb, b, "B", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bc, c, "C", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bd, d, "D", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)

            label.new(bc, c + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label, style=label.style_none, textcolor=color_shark_label, size=size.normal)

// Detect Cypher Pattern
f_detect_cypher() =>
    if array.size(zz_price) >= 5 and show_harmonic
        size = array.size(zz_price)

        x = array.get(zz_price, size - 5)
        a = array.get(zz_price, size - 4)
        b = array.get(zz_price, size - 3)
        c = array.get(zz_price, size - 2)
        d = array.get(zz_price, size - 1)

        bx = array.get(zz_bar, size - 5)
        ba = array.get(zz_bar, size - 4)
        bb = array.get(zz_bar, size - 3)
        bc = array.get(zz_bar, size - 2)
        bd = array.get(zz_bar, size - 1)

        xab = f_retracement(x, a, b)
        axc = f_extension(a, x, c)
        xcd = f_retracement(x, c, d)

        // Cypher ratios with flexible tolerance:
        // XAB = 0.382 - 0.618
        // AXC = 1.13 - 1.414
        // XCD = 0.786

        xab_min_tol = f_flexible_tolerance(FIB_0382, FIB_0236, FIB_0500)
        xab_max_tol = f_flexible_tolerance(FIB_0618, FIB_0500, FIB_0786)
        xab_match = (xab >= FIB_0382 - xab_min_tol and xab <= FIB_0618 + xab_max_tol)

        axc_min_tol = f_flexible_tolerance(FIB_1130, FIB_1000, FIB_1272)
        axc_max_tol = f_flexible_tolerance(FIB_1414, FIB_1272, FIB_1618)
        axc_match = (axc >= FIB_1130 - axc_min_tol and axc <= FIB_1414 + axc_max_tol)

        xcd_match = f_within_flexible_tolerance(xcd, FIB_0786, FIB_0618, FIB_0886)

        is_cypher = xab_match and axc_match and xcd_match

        is_potential = (not is_cypher) and show_potential and
                       f_within_tolerance(xcd, FIB_0786, fib_tolerance_max * 1.2)

        if is_cypher or is_potential
            line_style = is_cypher ? line.style_solid : line.style_dashed
            pattern_label = is_cypher ? "Cypher" : "Potential Cypher"

            is_bullish = a > x
            pattern_color = is_bullish ? color_bullish_harmonic : color_bearish_harmonic

            line.new(bx, x, ba, a, color=pattern_color, width=2, style=line_style)
            line.new(ba, a, bb, b, color=pattern_color, width=2, style=line_style)
            line.new(bb, b, bc, c, color=pattern_color, width=2, style=line_style)
            line.new(bc, c, bd, d, color=pattern_color, width=2, style=line_style)

            label.new(bx, x, "X", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(ba, a, "A", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bb, b, "B", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bc, c, "C", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bd, d, "D", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)

            label.new(bc, c + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label, style=label.style_none, textcolor=color_cypher_label, size=size.normal)

// Detect Deep Crab Pattern (Scott Carney)
f_detect_deep_crab() =>
    if array.size(zz_price) >= 5 and show_harmonic
        size = array.size(zz_price)

        x = array.get(zz_price, size - 5)
        a = array.get(zz_price, size - 4)
        b = array.get(zz_price, size - 3)
        c = array.get(zz_price, size - 2)
        d = array.get(zz_price, size - 1)

        bx = array.get(zz_bar, size - 5)
        ba = array.get(zz_bar, size - 4)
        bb = array.get(zz_bar, size - 3)
        bc = array.get(zz_bar, size - 2)
        bd = array.get(zz_bar, size - 1)

        xab = f_retracement(x, a, b)
        abc = f_retracement(a, b, c)
        bcd = f_extension(b, c, d)
        xad = f_extension(x, a, d)

        // Deep Crab ratios (Scott Carney Vol. 3):
        // B point = 0.886 minimum (key differentiator)
        // BC projection = 2.0 - 2.618
        // XAD = 1.618 - 1.902 (Deep Crab specific: can extend up to 1.902)

        // B must be at least 0.886
        b_min_match = xab >= 0.886 - fib_tolerance_min

        abc_min_tol = f_flexible_tolerance(FIB_0382, FIB_0236, FIB_0500)
        abc_max_tol = f_flexible_tolerance(FIB_0886, FIB_0786, FIB_1000)
        abc_match = (abc >= FIB_0382 - abc_min_tol and abc <= FIB_0886 + abc_max_tol)

        bcd_min_tol = f_flexible_tolerance(FIB_2000, FIB_1618, FIB_2240)
        bcd_max_tol = f_flexible_tolerance(FIB_2618, FIB_2240, FIB_3000)
        bcd_match = (bcd >= FIB_2000 - bcd_min_tol and bcd <= FIB_2618 + bcd_max_tol)

        xad_match = f_within_flexible_tolerance(xad, FIB_1618, FIB_1414, FIB_1900)

        is_deep_crab = b_min_match and abc_match and bcd_match and xad_match

        is_potential = (not is_deep_crab) and show_potential and b_min_match and
                       f_within_tolerance(xad, FIB_1618, fib_tolerance_max * 1.5)

        if is_deep_crab or is_potential
            line_style = is_deep_crab ? line.style_solid : line.style_dashed
            pattern_label = is_deep_crab ? "Deep Crab" : "Potential Deep Crab"

            is_bullish = a > x
            pattern_color = is_bullish ? color_bullish_harmonic : color_bearish_harmonic

            line.new(bx, x, ba, a, color=pattern_color, width=2, style=line_style)
            line.new(ba, a, bb, b, color=pattern_color, width=2, style=line_style)
            line.new(bb, b, bc, c, color=pattern_color, width=2, style=line_style)
            line.new(bc, c, bd, d, color=pattern_color, width=2, style=line_style)

            label.new(bx, x, "X", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(ba, a, "A", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bb, b, "B", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bc, c, "C", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bd, d, "D", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)

            label.new(bc, c + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label, style=label.style_none, textcolor=color_deep_crab_label, size=size.normal)

// Detect 5-0 Pattern (Scott Carney - Released 2005)
f_detect_5_0_pattern() =>
    if array.size(zz_price) >= 5 and show_harmonic
        size = array.size(zz_price)

        x = array.get(zz_price, size - 5)
        a = array.get(zz_price, size - 4)
        b = array.get(zz_price, size - 3)
        c = array.get(zz_price, size - 2)
        d = array.get(zz_price, size - 1)

        bx = array.get(zz_bar, size - 5)
        ba = array.get(zz_bar, size - 4)
        bb = array.get(zz_bar, size - 3)
        bc = array.get(zz_bar, size - 2)
        bd = array.get(zz_bar, size - 1)

        xab = f_retracement(x, a, b)
        xad = f_retracement(x, a, d)

        // 5-0 Pattern ratios (uses Reciprocal AB=CD):
        // 0B point = 1.13 - 1.618 (critical validation)
        // XAD = 0.50 OR 0.618 (dual PRZ levels)
        // Focus on B point validation + reciprocal AB=CD

        // Calculate 0B projection (from origin to B)
        ob_projection = math.abs((b - x) / (a - x))
        ob_match = (ob_projection >= 1.13 - fib_tolerance_max and ob_projection <= 1.618 + fib_tolerance_max)

        // XAD must be 50% OR 61.8%
        xad_50_match = f_within_flexible_tolerance(xad, 0.50, 0.382, 0.618)
        xad_618_match = f_within_flexible_tolerance(xad, FIB_0618, FIB_0500, FIB_0786)
        xad_match = xad_50_match or xad_618_match

        is_5_0 = ob_match and xad_match

        is_potential = (not is_5_0) and show_potential and ob_match

        if is_5_0 or is_potential
            line_style = is_5_0 ? line.style_solid : line.style_dashed
            pattern_label = is_5_0 ? "5-0" : "Potential 5-0"

            is_bullish = a > x
            pattern_color = is_bullish ? color_bullish_harmonic : color_bearish_harmonic

            line.new(bx, x, ba, a, color=pattern_color, width=2, style=line_style)
            line.new(ba, a, bb, b, color=pattern_color, width=2, style=line_style)
            line.new(bb, b, bc, c, color=pattern_color, width=2, style=line_style)
            line.new(bc, c, bd, d, color=pattern_color, width=2, style=line_style)

            label.new(bx, x, "0", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(ba, a, "A", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bb, b, "B", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bc, c, "C", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bd, d, "D", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)

            label.new(bc, c + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label, style=label.style_none, textcolor=color_5_0_label, size=size.normal)

// Detect Shark Pattern - Carney Advanced (Scott Carney - Released 2011)
f_detect_shark_advanced() =>
    if array.size(zz_price) >= 5 and show_harmonic
        size = array.size(zz_price)

        x = array.get(zz_price, size - 5)
        a = array.get(zz_price, size - 4)
        b = array.get(zz_price, size - 3)
        c = array.get(zz_price, size - 2)
        d = array.get(zz_price, size - 1)

        bx = array.get(zz_bar, size - 5)
        ba = array.get(zz_bar, size - 4)
        bb = array.get(zz_bar, size - 3)
        bc = array.get(zz_bar, size - 2)
        bd = array.get(zz_bar, size - 1)

        // Shark is unique - measures 0C extension instead of XAB
        oc_extension = math.abs((c - x) / (a - x))
        cd_extension = f_extension(c, d, d)  // Placeholder for reciprocal AB=CD
        xad = f_extension(x, a, d)

        // Shark ratios (precursor to 5-0):
        // 0C = 1.13 - 1.618 (impulsive extension)
        // XAD = 0.886 - 1.13 (88.6% + extension convergence)
        // Initial target = 50% level

        oc_match = (oc_extension >= 1.13 - fib_tolerance_max and oc_extension <= 1.618 + fib_tolerance_max)

        xad_min_tol = f_flexible_tolerance(FIB_0886, FIB_0786, FIB_1000)
        xad_max_tol = f_flexible_tolerance(FIB_1130, FIB_1000, FIB_1272)
        xad_match = (xad >= FIB_0886 - xad_min_tol and xad <= FIB_1130 + xad_max_tol)

        is_shark_pattern = oc_match and xad_match

        is_potential = (not is_shark_pattern) and show_potential and oc_match

        if is_shark_pattern or is_potential
            line_style = is_shark_pattern ? line.style_solid : line.style_dashed
            pattern_label = is_shark_pattern ? "Shark" : "Potential Shark"

            is_bullish = a > x
            pattern_color = is_bullish ? color_bullish_harmonic : color_bearish_harmonic

            line.new(bx, x, ba, a, color=pattern_color, width=2, style=line_style)
            line.new(ba, a, bb, b, color=pattern_color, width=2, style=line_style)
            line.new(bb, b, bc, c, color=pattern_color, width=2, style=line_style)
            line.new(bc, c, bd, d, color=pattern_color, width=2, style=line_style)

            label.new(bx, x, "0", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(ba, a, "A", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bb, b, "B", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bc, c, "C", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bd, d, "D", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)

            label.new(bc, c + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label, style=label.style_none, textcolor=color_shark_label, size=size.normal)

            // Add 50% retracement reference level (educational)
            target_50 = is_bullish ? d + (c - d) * 0.5 : d - (d - c) * 0.5
            line.new(bd, d, bd + 10, target_50, color=color.new(pattern_color, 50), width=1, style=line.style_dotted, extend=extend.right)
            label.new(bd + 5, target_50, "50% Level", style=label.style_none, textcolor=color.new(pattern_color, 30), size=size.tiny)

// Detect Alternate Bat Pattern (Scott Carney Vol 3)
f_detect_alternate_bat() =>
    if array.size(zz_price) >= 5 and show_harmonic
        size = array.size(zz_price)

        x = array.get(zz_price, size - 5)
        a = array.get(zz_price, size - 4)
        b = array.get(zz_price, size - 3)
        c = array.get(zz_price, size - 2)
        d = array.get(zz_price, size - 1)

        bx = array.get(zz_bar, size - 5)
        ba = array.get(zz_bar, size - 4)
        bb = array.get(zz_bar, size - 3)
        bc = array.get(zz_bar, size - 2)
        bd = array.get(zz_bar, size - 1)

        xab = f_retracement(x, a, b)
        abc = f_retracement(a, b, c)
        bcd = f_extension(b, c, d)
        xad = f_extension(x, a, d)

        // Alternate Bat ratios (distinct from standard Bat):
        // B Point: 0.382 maximum (-3% tolerance)
        // BC: 2.0-3.618 extension (much deeper than regular Bat)
        // XAD: 0.886-1.13 (extends beyond 0.886)
        // Uses 1.618 AB=CD structure (not standard AB=CD)

        // B point must be 0.382 or less (tighter than standard Bat)
        xab_match = xab <= FIB_0382 + fib_tolerance_min

        // BC projection is much deeper: 2.0-3.618
        bc_min_tol = f_flexible_tolerance(FIB_2000, FIB_1618, FIB_2240)
        bc_max_tol = f_flexible_tolerance(FIB_3618, FIB_2618, FIB_4236)
        bcd_match = (bcd >= FIB_2000 - bc_min_tol and bcd <= FIB_3618 + bc_max_tol)

        // XAD extends to 0.886-1.13 (deeper than standard Bat's 0.886)
        xad_min_tol = f_flexible_tolerance(FIB_0886, FIB_0786, FIB_1000)
        xad_max_tol = f_flexible_tolerance(FIB_1130, FIB_1000, FIB_1272)
        xad_match = (xad >= FIB_0886 - xad_min_tol and xad <= FIB_1130 + xad_max_tol)

        // Check for 1.618 AB=CD (alternate structure)
        ab_length = math.abs(b - a)
        cd_length = math.abs(d - c)
        abcd_ratio = cd_length / ab_length
        alternate_abcd = math.abs(abcd_ratio - 1.618) < fib_tolerance_max

        is_alternate_bat = xab_match and bcd_match and xad_match and alternate_abcd

        is_potential = (not is_alternate_bat) and show_potential and xab_match and xad_match

        if is_alternate_bat or is_potential
            line_style = is_alternate_bat ? line.style_solid : line.style_dashed
            pattern_label = is_alternate_bat ? "Alt Bat" : "Potential Alt Bat"

            is_bullish = a > x
            pattern_color = is_bullish ? color_bullish_harmonic : color_bearish_harmonic

            line.new(bx, x, ba, a, color=pattern_color, width=2, style=line_style)
            line.new(ba, a, bb, b, color=pattern_color, width=2, style=line_style)
            line.new(bb, b, bc, c, color=pattern_color, width=2, style=line_style)
            line.new(bc, c, bd, d, color=pattern_color, width=2, style=line_style)

            label.new(bx, x, "X", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(ba, a, "A", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bb, b, "B", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bc, c, "C", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bd, d, "D", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)

            label.new(bc, c + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label, style=label.style_none, textcolor=color_alt_bat_label, size=size.normal)

// Detect Three Drives Pattern (Scott Carney Vol 1-3)
// Three consecutive drives with symmetrical corrections
f_detect_three_drives() =>
    if array.size(zz_price) >= 7 and show_harmonic
        size = array.size(zz_price)

        // Three Drives pattern requires 7 points
        p0 = array.get(zz_price, size - 7)
        p1 = array.get(zz_price, size - 6)
        p2 = array.get(zz_price, size - 5)
        p3 = array.get(zz_price, size - 4)
        p4 = array.get(zz_price, size - 3)
        p5 = array.get(zz_price, size - 2)
        p6 = array.get(zz_price, size - 1)

        b0 = array.get(zz_bar, size - 7)
        b1 = array.get(zz_bar, size - 6)
        b2 = array.get(zz_bar, size - 5)
        b3 = array.get(zz_bar, size - 4)  // FIXED: Was size - 6 (duplicate!)
        b4 = array.get(zz_bar, size - 3)
        b5 = array.get(zz_bar, size - 2)
        b6 = array.get(zz_bar, size - 1)

        // Calculate drive lengths
        drive1 = math.abs(p1 - p0)
        drive2 = math.abs(p3 - p2)
        drive3 = math.abs(p5 - p4)

        // Calculate retracements
        retrace1 = f_retracement(p0, p1, p2)
        retrace2 = f_retracement(p2, p3, p4)

        // Calculate time symmetry (with zero-division protection)
        time1 = b1 - b0
        time2 = b3 - b2
        time3 = b5 - b4
        time_symmetric = (time1 != 0 and time2 != 0) and
                        math.abs(time2 / time1 - 1.0) < 0.3 and
                        math.abs(time3 / time2 - 1.0) < 0.3

        // Three Drives ratios (with zero-division protection):
        // Each drive approximately equal or 127.2%/161.8% extensions
        // Retracements typically 61.8% or 78.6%

        drive2_ratio = drive1 != 0 ? drive2 / drive1 : 0.0
        drive3_ratio = drive2 != 0 ? drive3 / drive2 : 0.0

        // Drives should be approximately equal or follow 1.272/1.618 extensions
        drives_equal = (math.abs(drive2_ratio - 1.0) < fib_tolerance_max) and
                       (math.abs(drive3_ratio - 1.0) < fib_tolerance_max)

        drives_extended = ((drive2_ratio >= FIB_1272 - fib_tolerance_max and drive2_ratio <= FIB_1618 + fib_tolerance_max) and
                          (drive3_ratio >= FIB_1272 - fib_tolerance_max and drive3_ratio <= FIB_1618 + fib_tolerance_max))

        // Retracements should be 61.8% or 78.6%
        retrace1_valid = (retrace1 >= FIB_0618 - fib_tolerance_max and retrace1 <= FIB_0786 + fib_tolerance_max)
        retrace2_valid = (retrace2 >= FIB_0618 - fib_tolerance_max and retrace2 <= FIB_0786 + fib_tolerance_max)

        is_three_drives = (drives_equal or drives_extended) and retrace1_valid and retrace2_valid and time_symmetric
        is_potential = (not is_three_drives) and show_potential and retrace1_valid and retrace2_valid

        if is_three_drives or is_potential
            line_style = is_three_drives ? line.style_solid : line.style_dashed
            pattern_label = is_three_drives ? "Three Drives" : "Potential Three Drives"

            is_bullish = p1 > p0
            pattern_color = is_bullish ? color_bullish_harmonic : color_bearish_harmonic

            // Draw drives
            line.new(b0, p0, b1, p1, color=pattern_color, width=2, style=line_style)
            line.new(b1, p1, b2, p2, color=pattern_color, width=2, style=line_style)
            line.new(b2, p2, b3, p3, color=pattern_color, width=2, style=line_style)
            line.new(b3, p3, b4, p4, color=pattern_color, width=2, style=line_style)
            line.new(b4, p4, b5, p5, color=pattern_color, width=2, style=line_style)
            line.new(b5, p5, b6, p6, color=pattern_color, width=2, style=line_style)

            // Label drives
            label.new(b1, p1, "1", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(b3, p3, "2", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(b5, p5, "3", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)

            label.new(b4, p4 + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label,
                     style=label.style_none, textcolor=color_three_drives_label, size=size.normal,
                     tooltip="Three Drives Pattern\nSymmetrical drives with 61.8-78.6% retracements\nScott Carney Vol 1-3")

// Detect AB=CD Pattern (Standalone - Scott Carney Foundation Pattern)
// The most basic harmonic pattern - perfect symmetry
f_detect_abcd() =>
    if array.size(zz_price) >= 4 and show_harmonic
        size = array.size(zz_price)

        // ABCD requires 4 points
        a = array.get(zz_price, size - 4)
        b = array.get(zz_price, size - 3)
        c = array.get(zz_price, size - 2)
        d = array.get(zz_price, size - 1)

        ba = array.get(zz_bar, size - 4)
        bb = array.get(zz_bar, size - 3)
        bc = array.get(zz_bar, size - 2)
        bd = array.get(zz_bar, size - 1)

        // Calculate ratios
        abc = f_retracement(a, b, c)
        // Note: bcd removed - not used in AB=CD pattern validation

        // AB=CD: Classic ratio is 1.0 (AB equals CD)
        // Also valid: 1.272 or 1.618 extensions
        ab_length = math.abs(b - a)
        cd_length = math.abs(d - c)
        abcd_ratio = ab_length != 0 ? cd_length / ab_length : 0.0

        // BC retracement should be 0.382-0.886
        abc_valid = (abc >= FIB_0382 - fib_tolerance_max and abc <= FIB_0886 + fib_tolerance_max)

        // Perfect AB=CD (1.0 ratio)
        perfect_abcd = math.abs(abcd_ratio - 1.0) < fib_tolerance_max

        // Extended AB=CD (1.272 or 1.618)
        extended_abcd = (math.abs(abcd_ratio - FIB_1272) < fib_tolerance_max) or
                        (math.abs(abcd_ratio - FIB_1618) < fib_tolerance_max)

        // Time equality (AB time ≈ CD time) with zero-division protection
        time_ab = bb - ba
        time_cd = bd - bc
        time_equal = time_ab != 0 ? math.abs(time_cd / time_ab - 1.0) < 0.2 : false

        is_abcd = abc_valid and (perfect_abcd or extended_abcd) and time_equal
        is_potential = (not is_abcd) and show_potential and abc_valid and (perfect_abcd or extended_abcd)

        if is_abcd or is_potential
            line_style = is_abcd ? line.style_solid : line.style_dashed
            pattern_type = perfect_abcd ? "AB=CD" : "AB=CD (Extended)"
            pattern_label = is_abcd ? pattern_type : "Potential " + pattern_type

            is_bullish = b > a
            pattern_color = is_bullish ? color_bullish_harmonic : color_bearish_harmonic

            // Draw pattern
            line.new(ba, a, bb, b, color=pattern_color, width=2, style=line_style)
            line.new(bb, b, bc, c, color=pattern_color, width=2, style=line_style)
            line.new(bc, c, bd, d, color=pattern_color, width=2, style=line_style)

            // Label points
            label.new(ba, a, "A", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bb, b, "B", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bc, c, "C", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)
            label.new(bd, d, "D", style=label.style_circle, color=pattern_color, textcolor=color.white, size=size.small)

            label.new(bc, c + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label,
                     style=label.style_none, textcolor=color_abcd_label, size=size.normal,
                     tooltip="AB=CD Pattern\nPerfect price/time symmetry\nFoundation of all harmonic patterns\nScott Carney")

// ═══════════════════════════════════════════════════════════════════════════════
// VI-B. BAMM PATTERN DETECTION (Bad Action Magnet Move - Scott Carney Vol 2/3)
// ═══════════════════════════════════════════════════════════════════════════════

// Detect BAMM Pattern (Bad Action Magnet Move)
// BAMM occurs near harmonic PRZ with extreme spike followed by quick reversal
f_detect_bamm() =>
    if show_harmonic and barstate.isconfirmed
        // BAMM characteristics:
        // 1. 2-4 bar extreme spike (Bad Action)
        // 2. Near harmonic pattern PRZ zone
        // 3. High volume spike
        // 4. Quick reversal (Magnet Move back)

        // Calculate recent price action
        current_high = high
        current_low = low
        current_close = close
        current_volume = volume

        // Look for 2-4 bar spike
        lookback = 4
        max_high = ta.highest(high, lookback)
        min_low = ta.lowest(low, lookback)
        avg_volume = ta.sma(volume, 20)

        // Detect bullish BAMM (downward spike then reversal)
        spike_down = (current_low == min_low) and (close > low)
        spike_range = (max_high - min_low) / min_low
        volume_spike = current_volume > avg_volume * 1.5

        // Check if we're near a potential PRZ (using ATR as proxy)
        atr = ta.atr(14)
        potential_prz = spike_range > (atr / close * 2)  // Spike is at least 2x ATR

        // Detect reversal (price moving away from spike low)
        bars_since_low = ta.barssince(current_low == min_low)
        reversal_strength = (close - min_low) / (max_high - min_low)
        strong_reversal = reversal_strength > 0.5 and bars_since_low <= 2

        // Bullish BAMM confirmation
        bullish_bamm = spike_down and potential_prz and volume_spike and strong_reversal

        if bullish_bamm
            label.new(bar_index, low, "BAMM ▲",
                     style=label.style_label_up,
                     color=color_bullish_harmonic,
                     textcolor=color.white,
                     size=size.normal,
                     tooltip="Bad Action Magnet Move\nExtreme spike with quick reversal\nEducational pattern - Scott Carney")

            // Draw spike range box
            box.new(bar_index - lookback, min_low, bar_index, max_high,
                   border_color=color.new(color_bullish_harmonic, 50),
                   bgcolor=color.new(color_bullish_harmonic, 90),
                   border_width=1)

        // Detect bearish BAMM (upward spike then reversal)
        spike_up = (current_high == max_high) and (close < high)
        bearish_reversal_strength = (max_high - close) / (max_high - min_low)
        bearish_strong_reversal = bearish_reversal_strength > 0.5 and ta.barssince(current_high == max_high) <= 2

        bearish_bamm = spike_up and potential_prz and volume_spike and bearish_strong_reversal

        if bearish_bamm
            label.new(bar_index, high, "BAMM ▼",
                     style=label.style_label_down,
                     color=color_bearish_harmonic,
                     textcolor=color.white,
                     size=size.normal,
                     tooltip="Bad Action Magnet Move\nExtreme spike with quick reversal\nEducational pattern - Scott Carney")

            // Draw spike range box
            box.new(bar_index - lookback, min_low, bar_index, max_high,
                   border_color=color.new(color_bearish_harmonic, 50),
                   bgcolor=color.new(color_bearish_harmonic, 90),
                   border_width=1)

// Detect RSI BAMM (RSI + BAMM Combined)
// Enhanced BAMM with RSI extreme confirmation
f_detect_rsi_bamm() =>
    if show_harmonic and barstate.isconfirmed
        // Calculate RSI
        rsi = ta.rsi(close, 14)
        rsi_prev = ta.rsi(close[1], 14)

        // RSI extremes
        rsi_oversold = 30
        rsi_overbought = 70

        // Trigger Bar: RSI reaches extreme
        trigger_bullish = rsi <= rsi_oversold or rsi[1] <= rsi_oversold
        trigger_bearish = rsi >= rsi_overbought or rsi[1] >= rsi_overbought

        // BAMM spike detection (same as regular BAMM)
        lookback = 4
        max_high = ta.highest(high, lookback)
        min_low = ta.lowest(low, lookback)
        avg_volume = ta.sma(volume, 20)
        current_volume = volume

        spike_down = (low == min_low) and (close > low)
        spike_up = (high == max_high) and (close < high)
        volume_spike = current_volume > avg_volume * 1.5

        // RSI recovery (Confirmation Point)
        rsi_recovering_up = rsi > rsi[1] and rsi[1] > rsi[2]  // RSI rising
        rsi_recovering_down = rsi < rsi[1] and rsi[1] < rsi[2]  // RSI falling

        // Bullish RSI BAMM
        bullish_rsi_bamm = trigger_bullish and spike_down and volume_spike and rsi_recovering_up

        if bullish_rsi_bamm
            label.new(bar_index, low, "RSI BAMM ▲\nRSI:" + str.tostring(rsi, "#.#"),
                     style=label.style_label_up,
                     color=color_bullish_harmonic,
                     textcolor=color.white,
                     size=size.large,
                     tooltip="RSI BAMM - Extreme Bullish Signal\nRSI Oversold + Spike + Recovery\nEducational pattern - Scott Carney Vol 2")

            // Draw RSI level line
            line.new(bar_index - 5, low, bar_index + 5, low,
                    color=color.new(color_bullish_harmonic, 30),
                    width=2,
                    style=line.style_dashed,
                    extend=extend.none)

        // Bearish RSI BAMM
        bearish_rsi_bamm = trigger_bearish and spike_up and volume_spike and rsi_recovering_down

        if bearish_rsi_bamm
            label.new(bar_index, high, "RSI BAMM ▼\nRSI:" + str.tostring(rsi, "#.#"),
                     style=label.style_label_down,
                     color=color_bearish_harmonic,
                     textcolor=color.white,
                     size=size.large,
                     tooltip="RSI BAMM - Extreme Bearish Signal\nRSI Overbought + Spike + Recovery\nEducational pattern - Scott Carney Vol 2")

            // Draw RSI level line
            line.new(bar_index - 5, high, bar_index + 5, high,
                    color=color.new(color_bearish_harmonic, 30),
                    width=2,
                    style=line.style_dashed,
                    extend=extend.none)

// ═══════════════════════════════════════════════════════════════════════════════
// VII. WYCKOFF PATTERN DETECTION (와이코프 패턴 탐지)
// ═══════════════════════════════════════════════════════════════════════════════

// Detect Wyckoff Accumulation & Distribution Phases (Enhanced with Volume)
f_detect_wyckoff() =>
    if array.size(zz_price) >= 5 and show_wyckoff
        size = array.size(zz_price)

        // Wyckoff Method with Volume Confirmation (Three Skills of Top Trading)
        // Volume leads price - high volume confirms phase transitions
        // Effort vs Result - high volume with small price move = absorption

        p0 = array.get(zz_price, size - 5)
        p1 = array.get(zz_price, size - 4)
        p2 = array.get(zz_price, size - 3)
        p3 = array.get(zz_price, size - 2)
        p4 = array.get(zz_price, size - 1)

        b0 = array.get(zz_bar, size - 5)
        b1 = array.get(zz_bar, size - 4)
        b2 = array.get(zz_bar, size - 3)
        b3 = array.get(zz_bar, size - 2)
        b4 = array.get(zz_bar, size - 1)

        d0 = array.get(zz_direction, size - 5)

        // Calculate volume metrics at key points
        avg_volume = ta.sma(volume, 20)

        // Helper function to get volume at specific bar
        f_get_volume_at_bar(bar_idx) =>
            bar_offset = bar_index - bar_idx
            bar_offset >= 0 and bar_offset < 5000 ? volume[bar_offset] : avg_volume

        // ═══════════════════════════════════════════════════════════════════
        // ACCUMULATION PHASE (Bullish - Smart Money Buying)
        // ═══════════════════════════════════════════════════════════════════
        if d0 == -1 and p1 > p0 and p2 < p1 and p3 > p2
            // Volume at each phase point
            vol_ps = f_get_volume_at_bar(b0)
            vol_ar = f_get_volume_at_bar(b1)
            vol_st = f_get_volume_at_bar(b2)

            // PS - Preliminary Support: High volume selling exhaustion
            ps_high_vol = vol_ps > avg_volume * 1.2
            ps_label = ps_high_vol ? "PS ✓" : "PS"
            ps_tooltip = ps_high_vol ?
                        "Preliminary Support (Volume Confirmed)\nSelling climax with high volume" :
                        "Preliminary Support\nInitial selling pressure stops"

            label.new(b0, p0, ps_label, style=label.style_label_down,
                     color=ps_high_vol ? color_wyckoff : color.new(color_wyckoff, 50),
                     textcolor=color.white, size=size.tiny, tooltip=ps_tooltip)

            // AR - Automatic Rally: Volume should decrease (no supply)
            ar_low_vol = vol_ar < avg_volume * 0.8
            ar_label = ar_low_vol ? "AR ✓" : "AR"
            ar_tooltip = ar_low_vol ?
                        "Automatic Rally (Volume Confirmed)\nLow volume rally = lack of supply" :
                        "Automatic Rally\nRally after selling stops"

            label.new(b1, p1, ar_label, style=label.style_label_up,
                     color=ar_low_vol ? color_wyckoff : color.new(color_wyckoff, 50),
                     textcolor=color.white, size=size.tiny, tooltip=ar_tooltip)

            // ST - Secondary Test: Low volume = no more sellers
            st_low_vol = vol_st < avg_volume * 0.7
            st_label = st_low_vol ? "ST ✓" : "ST"
            st_tooltip = st_low_vol ?
                        "Secondary Test (Volume Confirmed)\nLow volume test = absorption complete" :
                        "Secondary Test\nTesting support level"

            label.new(b2, p2, st_label, style=label.style_label_down,
                     color=st_low_vol ? color_wyckoff : color.new(color_wyckoff, 50),
                     textcolor=color.white, size=size.tiny, tooltip=st_tooltip)

            // Spring: Break below support with volume spike (shakeout)
            if p4 < p2
                vol_spring = f_get_volume_at_bar(b4)
                spring_high_vol = vol_spring > avg_volume * 1.3
                spring_label = spring_high_vol ? "Spring ✓" : "Spring"
                spring_tooltip = spring_high_vol ?
                                "Spring (Volume Confirmed)\nHigh volume shakeout = strong hands buying" :
                                "Spring\nFalse breakdown below support"

                label.new(b4, p4, spring_label, style=label.style_label_down,
                         color=spring_high_vol ? color_wyckoff : color.new(color_wyckoff, 50),
                         textcolor=color.white, size=size.tiny, tooltip=spring_tooltip)

                // Draw "Accumulation Zone" label if all volume conditions met
                if ps_high_vol and ar_low_vol and st_low_vol and spring_high_vol
                    label.new(b2, (p0 + p2) / 2, "ACCUMULATION ZONE",
                             style=label.style_none, textcolor=color.new(color_wyckoff, 0),
                             size=size.normal,
                             tooltip="All Wyckoff accumulation phases confirmed with volume\nStrong bullish setup")

        // ═══════════════════════════════════════════════════════════════════
        // DISTRIBUTION PHASE (Bearish - Smart Money Selling)
        // ═══════════════════════════════════════════════════════════════════
        if d0 == 1 and p1 < p0 and p2 > p1 and p3 < p2
            // Volume at each phase point
            vol_psy = f_get_volume_at_bar(b0)
            vol_ar_dist = f_get_volume_at_bar(b1)
            vol_st_dist = f_get_volume_at_bar(b2)

            // PSY - Preliminary Supply: High volume buying climax
            psy_high_vol = vol_psy > avg_volume * 1.2
            psy_label = psy_high_vol ? "PSY ✓" : "PSY"
            psy_tooltip = psy_high_vol ?
                         "Preliminary Supply (Volume Confirmed)\nBuying climax with high volume" :
                         "Preliminary Supply\nInitial buying pressure stops"

            label.new(b0, p0, psy_label, style=label.style_label_up,
                     color=psy_high_vol ? color.new(color.red, 0) : color.new(color.red, 50),
                     textcolor=color.white, size=size.tiny, tooltip=psy_tooltip)

            // AR - Automatic Reaction: Volume increases (supply appearing)
            ar_high_vol = vol_ar_dist > avg_volume * 0.9
            ar_label = ar_high_vol ? "AR ✓" : "AR"
            ar_tooltip = ar_high_vol ?
                        "Automatic Reaction (Volume Confirmed)\nSupply appears, sellers distribute" :
                        "Automatic Reaction\nDrop after buying stops"

            label.new(b1, p1, ar_label, style=label.style_label_down,
                     color=ar_high_vol ? color.new(color.red, 0) : color.new(color.red, 50),
                     textcolor=color.white, size=size.tiny, tooltip=ar_tooltip)

            // ST - Secondary Test: High volume on rally = sellers distributing
            st_high_vol = vol_st_dist > avg_volume * 0.8
            st_label = st_high_vol ? "ST ✓" : "ST"
            st_tooltip = st_high_vol ?
                        "Secondary Test (Volume Confirmed)\nHigh volume rally = distribution ongoing" :
                        "Secondary Test\nTesting resistance level"

            label.new(b2, p2, st_label, style=label.style_label_up,
                     color=st_high_vol ? color.new(color.red, 0) : color.new(color.red, 50),
                     textcolor=color.white, size=size.tiny, tooltip=st_tooltip)

            // UTAD - Upthrust After Distribution (break above resistance)
            if p4 > p2
                vol_utad = f_get_volume_at_bar(b4)
                utad_high_vol = vol_utad > avg_volume * 1.3
                utad_label = utad_high_vol ? "UTAD ✓" : "UTAD"
                utad_tooltip = utad_high_vol ?
                              "Upthrust After Distribution (Volume Confirmed)\nHigh volume false breakout = trap" :
                              "Upthrust After Distribution\nFalse breakout above resistance"

                label.new(b4, p4, utad_label, style=label.style_label_up,
                         color=utad_high_vol ? color.new(color.red, 0) : color.new(color.red, 50),
                         textcolor=color.white, size=size.tiny, tooltip=utad_tooltip)

                // Draw "Distribution Zone" label if all volume conditions met
                if psy_high_vol and ar_high_vol and st_high_vol and utad_high_vol
                    label.new(b2, (p0 + p2) / 2, "DISTRIBUTION ZONE",
                             style=label.style_none, textcolor=color.new(color.red, 0),
                             size=size.normal,
                             tooltip="All Wyckoff distribution phases confirmed with volume\nStrong bearish setup")

        // ═══════════════════════════════════════════════════════════════════
        // ADDITIONAL WYCKOFF SIGNALS: SOS, LPS, SOW, LPSY
        // (Three Skills of Top Trading - Advanced Wyckoff Signals)
        // ═══════════════════════════════════════════════════════════════════

        // SOS (Sign of Strength) & LPS (Last Point of Support) - After Accumulation
        // Check for upward breakout after accumulation with volume
        if array.size(zz_price) >= 3
            recent_size = array.size(zz_price)
            p_prev2 = array.get(zz_price, recent_size - 3)
            p_prev1 = array.get(zz_price, recent_size - 2)
            p_current = array.get(zz_price, recent_size - 1)

            b_prev2 = array.get(zz_bar, recent_size - 3)
            b_prev1 = array.get(zz_bar, recent_size - 2)
            b_current = array.get(zz_bar, recent_size - 1)

            d_prev1 = array.get(zz_direction, recent_size - 2)

            // SOS: Strong upward move with increasing volume (Jump Across Creek)
            if d_prev1 == -1 and p_current > p_prev1  // Valley to peak (upward)
                move_size = math.abs(p_current - p_prev1)
                vol_at_sos = f_get_volume_at_bar(b_current)
                sos_volume_confirmed = vol_at_sos > avg_volume * 1.3

                // Check if this is breaking above previous resistance (JAC - Jump Across Creek)
                is_breakout = p_current > p_prev2  // Current peak exceeds previous peak

                if is_breakout and sos_volume_confirmed
                    label.new(b_current, p_current, "SOS/JAC ✓", style=label.style_label_up,
                             color=color.new(color.green, 0), textcolor=color.white, size=size.tiny,
                             tooltip="Sign of Strength / Jump Across Creek\nVolume confirmed breakout above resistance")

            // LPS: Pullback after SOS that holds support (Backup to Edge of Creek)
            if d_prev1 == 1 and p_current < p_prev1  // Peak to valley (downward pullback)
                pullback_size = math.abs(p_prev1 - p_current)
                vol_at_lps = f_get_volume_at_bar(b_current)
                lps_volume_confirmed = vol_at_lps < avg_volume * 0.7  // Low volume on pullback

                // Check if pullback is shallow (held support)
                pullback_ratio = pullback_size / math.abs(p_prev1 - p_prev2)
                is_shallow_pullback = pullback_ratio < 0.5  // Less than 50% retracement

                if is_shallow_pullback and lps_volume_confirmed and p_current > p_prev2
                    label.new(b_current, p_current, "LPS ✓", style=label.style_label_down,
                             color=color.new(color.green, 0), textcolor=color.white, size=size.tiny,
                             tooltip="Last Point of Support\nLow volume pullback holding support\nTypical Wyckoff accumulation signal")

        // SOW (Sign of Weakness) & LPSY (Last Point of Supply) - After Distribution
        if array.size(zz_price) >= 3
            recent_size = array.size(zz_price)
            p_prev2 = array.get(zz_price, recent_size - 3)
            p_prev1 = array.get(zz_price, recent_size - 2)
            p_current = array.get(zz_price, recent_size - 1)

            b_prev2 = array.get(zz_bar, recent_size - 3)
            b_prev1 = array.get(zz_bar, recent_size - 2)
            b_current = array.get(zz_bar, recent_size - 1)

            d_prev1 = array.get(zz_direction, recent_size - 2)

            // SOW: Strong downward move with increasing volume
            if d_prev1 == 1 and p_current < p_prev1  // Peak to valley (downward)
                move_size = math.abs(p_prev1 - p_current)
                vol_at_sow = f_get_volume_at_bar(b_current)
                sow_volume_confirmed = vol_at_sow > avg_volume * 1.3

                // Check if breaking below previous support
                is_breakdown = p_current < p_prev2  // Current valley below previous valley

                if is_breakdown and sow_volume_confirmed
                    label.new(b_current, p_current, "SOW ✓", style=label.style_label_down,
                             color=color.new(color.maroon, 0), textcolor=color.white, size=size.tiny,
                             tooltip="Sign of Weakness\nVolume confirmed breakdown below support")

            // LPSY: Rally after SOW that fails at resistance (Last Point of Supply)
            if d_prev1 == -1 and p_current > p_prev1  // Valley to peak (upward rally)
                rally_size = math.abs(p_current - p_prev1)
                vol_at_lpsy = f_get_volume_at_bar(b_current)
                lpsy_volume_confirmed = vol_at_lpsy > avg_volume * 0.8  // High volume on rally = supply

                // Check if rally fails (doesn't break resistance)
                rally_ratio = rally_size / math.abs(p_prev2 - p_prev1)
                is_weak_rally = rally_ratio < 0.6  // Weak rally attempt

                if is_weak_rally and lpsy_volume_confirmed and p_current < p_prev2
                    label.new(b_current, p_current, "LPSY ✓", style=label.style_label_up,
                             color=color.new(color.maroon, 0), textcolor=color.white, size=size.tiny,
                             tooltip="Last Point of Supply\nHigh volume rally failing at resistance\nTypical Wyckoff distribution signal")

// ═══════════════════════════════════════════════════════════════════════════════
// VII-B. WYCKOFF ACCUMULATION/DISTRIBUTION SCORE (Inspired by Wyckoff Principles)
// ═══════════════════════════════════════════════════════════════════════════════

// Wyckoff Accumulation/Distribution Scoring System
// NOTE: This is a custom scoring system inspired by Wyckoff principles
// NOT the original "9 Tests" from Wyckoff's "Studies in Tape Reading"
// Source: Inspired by Richard D. Wyckoff and Hank Pruden methodologies
f_detect_wyckoff_9_tests() =>
    if show_wyckoff and array.size(zz_price) >= 6
        size = array.size(zz_price)
        avg_vol = ta.sma(volume, 20)
        atr = ta.atr(14)

        // Recent ZigZag structure (last 6 pivots)
        p0 = array.get(zz_price, size - 6)
        p1 = array.get(zz_price, size - 5)
        p2 = array.get(zz_price, size - 4)
        p3 = array.get(zz_price, size - 3)
        p4 = array.get(zz_price, size - 2)
        p5 = array.get(zz_price, size - 1)

        b0 = array.get(zz_bar, size - 6)
        b5 = array.get(zz_bar, size - 1)

        d0 = array.get(zz_direction, size - 6)

        f_vol_at(bi) =>
            offset = bar_index - bi
            offset >= 0 and offset < 5000 ? volume[offset] : avg_vol

        // ── BUYING TESTS (9 Tests for Accumulation) ──────────────────────────
        // Test 1: Price objective satisfied (prior declining trend exists)
        test1_buy = p0 > p1  // Prior decline: trough at p0 is lower peak -> valley

        // Test 2: Preliminary Support & Selling Climax (SC)
        // High volume at the low + wide spread bar
        vol_at_sc = f_vol_at(b0)
        bar_range_sc = math.abs(p1 - p0)
        test2_buy = vol_at_sc > avg_vol * 1.5 and bar_range_sc > atr * 1.2

        // Test 3: Secondary Test - Volume diminishing on down-tests
        vol_at_st = f_vol_at(array.get(zz_bar, size - 4))
        test3_buy = vol_at_st < vol_at_sc * 0.7  // Volume decreasing

        // Test 4: Downtrend line broken (price structure improving)
        // Higher lows forming: p4 > p2 > p0 (all valleys going up)
        test4_buy = d0 == -1 and p4 > p2 and p2 > p0

        // Test 5: Higher lows (bullish reaction structure)
        test5_buy = d0 == -1 and p4 > p0  // More recent low is higher

        // Test 6: Series of Higher Highs and Higher Lows (HH + HL)
        has_hh = p5 > p3 and p3 > p1  // Higher highs
        has_hl = p4 > p2 and p2 > p0  // Higher lows
        test6_buy = d0 == -1 and has_hh and has_hl

        // Test 7: Effort vs Result - Volume diminishing on reactions
        // Low volume on down-moves = lack of supply
        recent_down_vol = f_vol_at(array.get(zz_bar, size - 2))
        test7_buy = recent_down_vol < avg_vol * 0.8

        // Test 8: Base Building - Range contraction (stock consolidating)
        price_range_recent = ta.highest(high, 20) - ta.lowest(low, 20)
        price_range_prior  = ta.highest(high, 60) - ta.lowest(low, 60)
        test8_buy = price_range_recent < price_range_prior * 0.5  // Range narrowing

        // Test 9: Price stronger than prior decline
        // Current low is within 30% retracement of the whole decline
        total_decline = math.abs(p1 - p0)
        test9_buy = total_decline > 0 and (close - p0) / total_decline > 0.3

        // Count passing tests
        buy_score = (test1_buy ? 1 : 0) + (test2_buy ? 1 : 0) + (test3_buy ? 1 : 0) +
                   (test4_buy ? 1 : 0) + (test5_buy ? 1 : 0) + (test6_buy ? 1 : 0) +
                   (test7_buy ? 1 : 0) + (test8_buy ? 1 : 0) + (test9_buy ? 1 : 0)

        // ── SELLING TESTS (9 Tests for Distribution) ─────────────────────────
        // Test 1: Prior advancing trend exists
        test1_sell = p0 < p1  // Prior rise

        // Test 2: Buying Climax (BC) - High volume at the high
        vol_at_bc = f_vol_at(b0)
        test2_sell = vol_at_bc > avg_vol * 1.5

        // Test 3: Secondary Test - Volume diminishing on up-tests
        test3_sell = vol_at_st < vol_at_bc * 0.7

        // Test 4: Uptrend line broken (lower highs forming)
        test4_sell = d0 == 1 and p4 < p2 and p2 < p0

        // Test 5: Lower highs (bearish reaction structure)
        test5_sell = d0 == 1 and p4 < p0

        // Test 6: Series of Lower Highs and Lower Lows
        has_lh = p5 < p3 and p3 < p1  // Lower highs
        has_ll = p4 < p2 and p2 < p0  // Lower lows
        test6_sell = d0 == 1 and has_lh and has_ll

        // Test 7: Volume expanding on declines (supply present)
        test7_sell = recent_down_vol > avg_vol * 1.1

        // Test 8: Range expansion on down-moves
        test8_sell = price_range_recent > price_range_prior * 0.6 and
                    math.abs(p5 - p4) > math.abs(p3 - p2)  // Recent decline larger

        // Test 9: Price weaker than prior advance
        total_advance = math.abs(p1 - p0)
        test9_sell = total_advance > 0 and (p0 - close) / total_advance > 0.3

        sell_score = (test1_sell ? 1 : 0) + (test2_sell ? 1 : 0) + (test3_sell ? 1 : 0) +
                    (test4_sell ? 1 : 0) + (test5_sell ? 1 : 0) + (test6_sell ? 1 : 0) +
                    (test7_sell ? 1 : 0) + (test8_sell ? 1 : 0) + (test9_sell ? 1 : 0)

        // Display 9-Test scoreboard on last bar
        if barstate.islast
            var table wyckoff9_table = table.new(position.bottom_left, 3, 11, border_width=1, border_color=color.new(color.gray, 70))
            table.cell(wyckoff9_table, 0, 0, "Wyckoff Score",
                      bgcolor=color.new(color_wyckoff, 60), text_color=color.white, text_size=size.small)
            table.cell(wyckoff9_table, 1, 0, "Buy (" + str.tostring(buy_score) + "/9)",
                      bgcolor=color.new(color.green, 50), text_color=color.white, text_size=size.small)
            table.cell(wyckoff9_table, 2, 0, "Sell (" + str.tostring(sell_score) + "/9)",
                      bgcolor=color.new(color.red, 50), text_color=color.white, text_size=size.small)

            test_names = array.from("1:Prior Trend", "2:SC/BC Volume", "3:Vol Diminish",
                                   "4:Trend Break", "5:Higher Lows", "6:HH+HL",
                                   "7:Effort/Result", "8:Base Build", "9:Strength")
            buy_tests  = array.from(test1_buy, test2_buy, test3_buy, test4_buy, test5_buy,
                                   test6_buy, test7_buy, test8_buy, test9_buy)
            sell_tests = array.from(test1_sell, test2_sell, test3_sell, test4_sell, test5_sell,
                                   test6_sell, test7_sell, test8_sell, test9_sell)

            for i = 0 to 8
                t_name  = array.get(test_names, i)
                t_buy   = array.get(buy_tests, i)
                t_sell  = array.get(sell_tests, i)

                table.cell(wyckoff9_table, 0, i + 1, t_name,
                          text_color=color.white, text_size=size.tiny)
                table.cell(wyckoff9_table, 1, i + 1, t_buy ? "✓" : "–",
                          bgcolor=t_buy  ? color.new(color.green, 40) : color.new(color.gray, 80),
                          text_color=color.white, text_size=size.tiny)
                table.cell(wyckoff9_table, 2, i + 1, t_sell ? "✓" : "–",
                          bgcolor=t_sell ? color.new(color.red,   40) : color.new(color.gray, 80),
                          text_color=color.white, text_size=size.tiny)

        // High-confidence signal labels (≥7/9 tests passing)
        if barstate.isconfirmed
            if buy_score >= 7 and d0 == -1
                label.new(b5, p5, "W9 BUY\n" + str.tostring(buy_score) + "/9 ✓",
                         style=label.style_label_up, color=color.new(color_wyckoff, 0),
                         textcolor=color.white, size=size.normal,
                         tooltip="Wyckoff Accumulation Score\n" + str.tostring(buy_score) + " of 9 criteria met\nHigh-confidence accumulation zone\n(Inspired by Wyckoff principles)")
            if sell_score >= 7 and d0 == 1
                label.new(b5, p5, "W9 SELL\n" + str.tostring(sell_score) + "/9 ✓",
                         style=label.style_label_down, color=color.new(color.red, 0),
                         textcolor=color.white, size=size.normal,
                         tooltip="Wyckoff Distribution Score\n" + str.tostring(sell_score) + " of 9 criteria met\nHigh-confidence distribution zone\n(Inspired by Wyckoff principles)")

// ═══════════════════════════════════════════════════════════════════════════════
// VII-C. BUMP-AND-RUN REVERSAL (Thomas Bulkowski - 55% Success Rate)
// ═══════════════════════════════════════════════════════════════════════════════

// Bump-and-Run Reversal: Three phases - Lead-in → Bump → Run
// Source: Thomas Bulkowski "Encyclopedia of Chart Patterns" - 55% breakout rate
f_detect_bump_and_run() =>
    if show_chart_patterns and barstate.isconfirmed
        // Parameters for pattern detection
        lead_in_len    = 20   // Bars for lead-in trendline
        bump_threshold = 2.0  // Bump slope must be 2x lead-in slope
        min_bump_bars  = 5    // Minimum bars in bump phase
        avg_vol        = ta.sma(volume, 20)

        // ── LEAD-IN PHASE: Gentle uptrend ─────────────────────────────────
        // Calculate slope of recent highs over lead-in period
        lead_in_high_start = ta.highest(high, lead_in_len)[lead_in_len]
        lead_in_high_end   = ta.highest(high, 5)
        lead_in_slope = (lead_in_high_end - lead_in_high_start) / lead_in_len

        // Lead-in must be gently rising (positive but moderate slope)
        is_gentle_uptrend = lead_in_slope > 0 and
                           lead_in_slope < (lead_in_high_start * 0.005)  // < 0.5% per bar

        // ── BUMP PHASE: Steep acceleration ────────────────────────────────
        // Recent steep rise = Bump (2x slope of lead-in)
        bump_high_start = ta.highest(high, min_bump_bars)[min_bump_bars]
        bump_high_end   = high
        bump_slope      = (bump_high_end - bump_high_start) / min_bump_bars

        // Bump must be steeper than lead-in by threshold factor
        is_steep_bump   = lead_in_slope != 0 and
                         bump_slope > (math.abs(lead_in_slope) * bump_threshold)

        // Volume should increase during bump phase
        recent_vol  = ta.sma(volume, min_bump_bars)
        vol_expand  = recent_vol > avg_vol * 1.2  // Volume expansion in bump

        // ── RUN PHASE: Reversal back to lead-in line ──────────────────────
        // Price starts reversing from bump high
        // Identify if price crossed back below the projected lead-in trendline
        projected_lead_in = lead_in_high_end  // The trendline level

        // Check if we have a reversal from recent high
        bars_from_bump_high = ta.barssince(high == ta.highest(high, 30))
        price_below_bump    = close < ta.highest(high, 30) * 0.95  // 5% below bump peak
        is_run_phase        = bars_from_bump_high >= 2 and price_below_bump

        // ── BULLISH BARR (Bump-and-Run Reversal) at high ──────────────────
        bearish_barr = is_gentle_uptrend and is_steep_bump and vol_expand and is_run_phase

        // ── BEARISH BARR (Inverted - Dump-and-Run) ────────────────────────
        lead_in_low_start = ta.lowest(low, lead_in_len)[lead_in_len]
        lead_in_low_end   = ta.lowest(low, 5)
        lead_in_slope_dn  = (lead_in_low_start - lead_in_low_end) / lead_in_len

        bump_low_start  = ta.lowest(low, min_bump_bars)[min_bump_bars]
        bump_low_end    = low
        bump_slope_dn   = (bump_low_start - bump_low_end) / min_bump_bars

        is_gentle_dn    = lead_in_slope_dn > 0 and
                         lead_in_slope_dn < (lead_in_low_start * 0.005)
        is_steep_dn     = lead_in_slope_dn != 0 and
                         bump_slope_dn > (math.abs(lead_in_slope_dn) * bump_threshold)

        bars_from_dump_low = ta.barssince(low == ta.lowest(low, 30))
        price_above_dump   = close > ta.lowest(low, 30) * 1.05
        is_run_up          = bars_from_dump_low >= 2 and price_above_dump

        bullish_barr = is_gentle_dn and is_steep_dn and vol_expand and is_run_up

        // ── VISUALIZE ─────────────────────────────────────────────────────
        if bearish_barr
            // Directional color based on pattern direction
            pattern_color = color_bearish_chart_pattern  // Bearish pattern

            label.new(bar_index, high, "BARR ▼\nBump-Run",
                     style=label.style_label_down,
                     color=color.new(color_chart_pattern_label, 0),
                     textcolor=color.white,
                     size=size.normal,
                     tooltip="Bump-and-Run Reversal (Bearish)\nLead-in → Steep Bump → Run Down\n55% success rate (Bulkowski)\nEducational Pattern - NOT a trading signal")

            // Draw lead-in trendline projection
            line.new(bar_index - lead_in_len, lead_in_high_start, bar_index, lead_in_high_end,
                    color=color.new(pattern_color, 30),
                    width=1,
                    style=line.style_dashed)

        if bullish_barr
            // Directional color based on pattern direction
            pattern_color = color_bullish_chart_pattern  // Bullish pattern

            label.new(bar_index, low, "BARR ▲\nDump-Run",
                     style=label.style_label_up,
                     color=color.new(color_chart_pattern_label, 0),
                     textcolor=color.white,
                     size=size.normal,
                     tooltip="Bump-and-Run Reversal (Bullish / Inverted)\nLead-in → Steep Dump → Run Up\n55% success rate (Bulkowski)\nEducational Pattern - NOT a trading signal")

            line.new(bar_index - lead_in_len, lead_in_low_start, bar_index, lead_in_low_end,
                    color=color.new(pattern_color, 30),
                    width=1,
                    style=line.style_dashed)

// Detect Cup & Handle Pattern (Thomas Bulkowski - 53.6% Success Rate)
// Classic bullish continuation pattern with high statistical reliability
f_detect_cup_and_handle() =>
    if show_chart_patterns and barstate.isconfirmed
        // Cup & Handle parameters
        cup_min_bars = 35      // Minimum 7 weeks (5 bars/week)
        cup_max_bars = 250     // Maximum ~1 year
        handle_min_bars = 5    // Handle minimum duration
        handle_max_bars = 30   // Handle maximum duration

        // ── CUP DETECTION ──────────────────────────────────────────────
        // Find the lowest point in recent history (cup bottom)
        lookback = 60
        cup_low = ta.lowest(low, lookback)
        cup_low_bar = ta.barssince(low == cup_low)

        // Cup should be U-shaped (rounded bottom)
        // Check if price forms a rounded bottom (not V-shaped)
        left_rim_high = ta.highest(high, lookback)[lookback]
        right_rim_high = ta.highest(high, 10)

        // Rims should be approximately equal (within 5%) with zero-division protection
        rims_equal = left_rim_high != 0 ?
                     math.abs(right_rim_high - left_rim_high) / left_rim_high <= 0.05 :
                     false

        // Cup depth should be reasonable (10-50% of left rim) with zero-division protection
        cup_depth = left_rim_high - cup_low
        cup_depth_ratio = left_rim_high != 0 ? cup_depth / left_rim_high : 0.0
        valid_cup_depth = cup_depth_ratio >= 0.10 and cup_depth_ratio <= 0.50

        // Cup should be U-shaped (gradual decline and rise)
        // Check if the low is not too recent (not V-shaped)
        is_u_shaped = cup_low_bar >= cup_min_bars / 2

        // ── HANDLE DETECTION ───────────────────────────────────────────
        // Handle is a small pullback after the right rim
        // Handle should form in upper half of cup
        handle_start_price = ta.highest(high, 20)[5]  // ~5 bars ago
        handle_low = ta.lowest(low, handle_max_bars)
        handle_depth = handle_start_price - handle_low

        // Handle depth should be < 1/3 of cup depth (Bulkowski criterion)
        valid_handle_depth = handle_depth <= cup_depth * 0.33

        // Handle should be above cup midpoint
        cup_midpoint = cup_low + (cup_depth * 0.50)
        handle_above_midpoint = handle_low > cup_midpoint

        // ── VOLUME ANALYSIS ────────────────────────────────────────────
        // Volume should decrease during cup formation
        // Volume should increase on breakout
        avg_vol_cup = ta.sma(volume, lookback)
        avg_vol_handle = ta.sma(volume, handle_max_bars)
        recent_vol = ta.sma(volume, 5)

        volume_decreased_cup = avg_vol_handle < avg_vol_cup * 0.9
        volume_increasing_breakout = recent_vol > avg_vol_handle * 1.2

        // ── BREAKOUT DETECTION ─────────────────────────────────────────
        // Price should be breaking above handle resistance
        handle_resistance = ta.highest(high, 10)[1]  // Previous high
        breaking_out = close > handle_resistance

        // ── PATTERN CONFIRMATION ───────────────────────────────────────
        is_cup_and_handle = rims_equal and valid_cup_depth and is_u_shaped and
                           valid_handle_depth and handle_above_midpoint and
                           volume_decreased_cup and volume_increasing_breakout and
                           breaking_out

        is_potential = (not is_cup_and_handle) and rims_equal and valid_cup_depth and is_u_shaped

        if is_cup_and_handle or is_potential
            // Directional color based on pattern direction
            pattern_color = color_bullish_chart_pattern  // Bullish pattern

            pattern_label = is_cup_and_handle ? "Cup & Handle ▲" : "Potential Cup & Handle"

            // Calculate target (Measure Rule)
            // Target = Breakout + Cup Depth
            target = close + cup_depth
            target_gain = (target - close) / close * 100

            // ── VISUALIZATION ──────────────────────────────────────────
            label.new(bar_index, high, pattern_label,
                     style=label.style_label_up,
                     color=color.new(color_chart_pattern_label, 0),
                     textcolor=color.white,
                     size=size.normal,
                     tooltip="Cup & Handle Pattern\nBullish continuation\n53.6% avg rise (Bulkowski)\nTarget: " + str.tostring(target, "#.##") + " (+" + str.tostring(target_gain, "#.#") + "%)")

            // Draw cup (U-shape)
            box.new(bar_index - lookback, left_rim_high, bar_index - cup_low_bar, cup_low,
                   border_color=color.new(pattern_color, 50),
                   bgcolor=color.new(pattern_color, 95),
                   border_width=1)

            // Draw handle
            box.new(bar_index - handle_max_bars, handle_start_price, bar_index, handle_low,
                   border_color=color.new(pattern_color, 30),
                   bgcolor=color.new(pattern_color, 90),
                   border_width=2)

            // Draw target projection
            line.new(bar_index, close, bar_index + 10, target,
                    color=color.new(pattern_color, 0),
                    width=2,
                    style=line.style_dashed)

// ═══════════════════════════════════════════════════════════════════════════════
// VII-D. WAVE FAILURE CLASSIFICATIONS (Glen Neely NEoWave - 8 Types)
// ═══════════════════════════════════════════════════════════════════════════════

// Elliott/NEoWave Wave Failure Classifications
// 8 types based on B-wave and C-wave behavior in corrective structures
// Source: Glen Neely "Mastering Elliott Wave" Ch.6 - Flat Formations
f_detect_wave_failures() =>
    if show_elliott and array.size(zz_price) >= 5 and barstate.isconfirmed
        size = array.size(zz_price)

        // ABC Corrective wave structure
        // Wave A: p0 → p1 (first corrective move)
        // Wave B: p1 → p2 (retracement of A)
        // Wave C: p2 → p3 (final corrective move)
        p0 = array.get(zz_price, size - 5)
        p1 = array.get(zz_price, size - 4)  // End of A
        p2 = array.get(zz_price, size - 3)  // End of B
        p3 = array.get(zz_price, size - 2)  // End of C
        p4 = array.get(zz_price, size - 1)  // Next pivot

        b0 = array.get(zz_bar, size - 5)
        b1 = array.get(zz_bar, size - 4)
        b2 = array.get(zz_bar, size - 3)
        b3 = array.get(zz_bar, size - 2)

        d0 = array.get(zz_direction, size - 5)

        // Only analyse flat-type corrections (A and C same direction as overall)
        is_bearish_correction = d0 == 1  // A wave down
        is_bullish_correction = d0 == -1 // A wave up

        if is_bearish_correction
            // Bearish correction: p0 (high) → p1 (low) = Wave A
            wave_a = p0 - p1  // Wave A size (positive = down)
            wave_b = p2 - p1  // Wave B size (positive = up)
            wave_c = p2 - p3  // Wave C size (positive = down)

            // Ratios (NEoWave classification rules)
            b_vs_a  = wave_a != 0 ? wave_b / wave_a : 0
            c_vs_a  = wave_a != 0 ? wave_c / wave_a : 0
            b_reach_a_start = p2 >= p0  // B exceeds A's start (origin)

            // Classification logic:
            // 1. Common Flat:      B ≥ 61.8%A and B < A's start, C ≈ 100% A
            // 2. Elongated Flat:   B > A's start (B exceeds origin), C ≈ 100-160% A
            // 3. C-Failure:        C fails to reach A's end (C < 100% A, B normal)
            // 4. B-Failure:        B < 61.8% A (weak B wave)
            // 5. Double Failure:   B < 61.8% A AND C < 100% A
            // 6. Running Flat:     B > A's start, C barely exceeds A's end downward
            // 7. Irregular:        B > A's start, C > A's end significantly (most common)
            // 8. Running Irregular: B >> A's start, C >> A's end

            pattern_name = ""
            pattern_color = color.gray
            tooltip_text = ""

            if b_vs_a >= 0.618 and not b_reach_a_start and c_vs_a >= 0.9 and c_vs_a <= 1.1
                pattern_name = "Common Flat"
                pattern_color := color.new(color.blue, 0)
                tooltip_text := "Common Flat (NEoWave)\nB ≥ 61.8% of A, B < A's start\nC ≈ 100% of A\nMost balanced correction type"

            else if b_reach_a_start and c_vs_a >= 0.9 and c_vs_a <= 1.6
                pattern_name := "Elongated Flat"
                pattern_color := color.new(color.navy, 0)
                tooltip_text := "Elongated Flat (NEoWave)\nB exceeds A's starting point\nC ≈ 100–160% of A\nModerate extension"

            else if b_vs_a >= 0.618 and not b_reach_a_start and c_vs_a < 0.9
                pattern_name := "C-Failure"
                pattern_color := color.new(color.yellow, 0)
                tooltip_text := "C-Failure Flat (NEoWave)\nNormal B wave\nC fails to reach A's end\nSignals strong opposing trend"

            else if b_vs_a < 0.618 and not b_reach_a_start and c_vs_a >= 0.9
                pattern_name := "B-Failure"
                pattern_color := color.new(color.orange, 0)
                tooltip_text := "B-Failure Flat (NEoWave)\nB wave less than 61.8% of A\nWeak retracement phase\nStrong continuation expected"

            else if b_vs_a < 0.618 and c_vs_a < 0.9
                pattern_name := "Double Failure"
                pattern_color := color.new(color.red, 0)
                tooltip_text := "Double Failure (NEoWave)\nBOTH B and C waves fail\nExtremely strong continuation signal\nRare but powerful pattern"

            else if b_reach_a_start and c_vs_a >= 0.9 and c_vs_a <= 1.05
                pattern_name := "Running Flat"
                pattern_color := color.new(color.purple, 0)
                tooltip_text := "Running Flat (NEoWave)\nB beyond A's start\nC barely exceeds A's end\nMarket very strong against correction"

            else if b_reach_a_start and c_vs_a > 1.05 and c_vs_a <= 1.618
                pattern_name := "Irregular"
                pattern_color := color.new(color.fuchsia, 0)
                tooltip_text := "Irregular Flat (NEoWave)\nB beyond A's start\nC extends significantly past A's end\nMost common flat variant"

            else if b_reach_a_start and c_vs_a > 1.618
                pattern_name := "Running Irregular"
                pattern_color := color.new(color.maroon, 0)
                tooltip_text := "Running Irregular (NEoWave)\nB well beyond A's start\nC extends > 161.8% of A\nVery strong trend continuation"

            if pattern_name != ""
                label.new(b3, p3, pattern_name,
                         style=label.style_label_up,
                         color=pattern_color,
                         textcolor=color.white,
                         size=size.small,
                         tooltip=tooltip_text + "\n\nB/A ratio: " + str.tostring(b_vs_a, "#.###") +
                                "\nC/A ratio: " + str.tostring(c_vs_a, "#.###") +
                                "\nEducational - Glen Neely NEoWave")

                // Draw connecting lines for ABC
                line.new(b0, p0, b1, p1, color=color.new(pattern_color, 30), width=1)
                line.new(b1, p1, b2, p2, color=color.new(pattern_color, 30), width=1,
                        style=line.style_dashed)
                line.new(b2, p2, b3, p3, color=color.new(pattern_color, 30), width=1)

        if is_bullish_correction
            // Bullish correction: p0 (low) → p1 (high) = Wave A up
            wave_a = p1 - p0
            wave_b = p1 - p2
            wave_c = p3 - p2

            b_vs_a  = wave_a != 0 ? wave_b / wave_a : 0
            c_vs_a  = wave_a != 0 ? wave_c / wave_a : 0
            b_reach_a_start = p2 <= p0

            pattern_name = ""
            pattern_color = color.gray
            tooltip_text = ""

            if b_vs_a >= 0.618 and not b_reach_a_start and c_vs_a >= 0.9 and c_vs_a <= 1.1
                pattern_name := "Common Flat ▲"
                pattern_color := color.new(color.blue, 0)
                tooltip_text := "Common Flat Bullish (NEoWave)\nSymmetric correction\nExpect continuation up"

            else if b_reach_a_start and c_vs_a >= 0.9 and c_vs_a <= 1.6
                pattern_name := "Elongated ▲"
                pattern_color := color.new(color.navy, 0)
                tooltip_text := "Elongated Flat Bullish (NEoWave)\nB exceeds A start (deep retracement)\nExtended correction"

            else if b_vs_a >= 0.618 and not b_reach_a_start and c_vs_a < 0.9
                pattern_name := "C-Fail ▲"
                pattern_color := color.new(color.yellow, 0)
                tooltip_text := "C-Failure Flat Bullish (NEoWave)\nC fails to reach A's end\nVery strong uptrend signal"

            else if b_vs_a < 0.618 and not b_reach_a_start and c_vs_a >= 0.9
                pattern_name := "B-Fail ▲"
                pattern_color := color.new(color.orange, 0)
                tooltip_text := "B-Failure Flat Bullish (NEoWave)\nWeak B wave (< 61.8% of A)\nStrong upward continuation"

            else if b_vs_a < 0.618 and c_vs_a < 0.9
                pattern_name := "Dbl Fail ▲"
                pattern_color := color.new(color.red, 0)
                tooltip_text := "Double Failure Bullish (NEoWave)\nBoth B and C fail\nExtremely strong upward continuation"

            else if b_reach_a_start and c_vs_a >= 0.9 and c_vs_a <= 1.05
                pattern_name := "Running ▲"
                pattern_color := color.new(color.purple, 0)
                tooltip_text := "Running Flat Bullish (NEoWave)\nB deep, C barely completes\nMarket extremely strong"

            else if b_reach_a_start and c_vs_a > 1.05 and c_vs_a <= 1.618
                pattern_name := "Irregular ▲"
                pattern_color := color.new(color.fuchsia, 0)
                tooltip_text := "Irregular Flat Bullish (NEoWave)\nMost common flat type up"

            else if b_reach_a_start and c_vs_a > 1.618
                pattern_name := "Run Irr ▲"
                pattern_color := color.new(color.maroon, 0)
                tooltip_text := "Running Irregular Bullish (NEoWave)\nVery strong upward continuation"

            if pattern_name != ""
                label.new(b3, p3, pattern_name,
                         style=label.style_label_down,
                         color=pattern_color,
                         textcolor=color.white,
                         size=size.small,
                         tooltip=tooltip_text + "\n\nB/A ratio: " + str.tostring(b_vs_a, "#.###") +
                                "\nC/A ratio: " + str.tostring(c_vs_a, "#.###") +
                                "\nEducational - Glen Neely NEoWave")

                line.new(b0, p0, b1, p1, color=color.new(pattern_color, 30), width=1)
                line.new(b1, p1, b2, p2, color=color.new(pattern_color, 30), width=1,
                        style=line.style_dashed)
                line.new(b2, p2, b3, p3, color=color.new(pattern_color, 30), width=1)

// ═══════════════════════════════════════════════════════════════════════════════
// VIII. DOW THEORY DETECTION (다우 이론 탐지)
// ═══════════════════════════════════════════════════════════════════════════════

// Detect Dow Theory Trends
f_detect_dow_theory() =>
    if show_dow
        // Calculate trend using simple moving averages
        sma_short = ta.sma(close, 20)
        sma_medium = ta.sma(close, 50)
        sma_long = ta.sma(close, 200)

        // Short-term trend
        short_trend = close > sma_short ? "Bullish" : "Bearish"
        short_color = close > sma_short ? color.new(color_dow, 70) : color.new(color.red, 70)

        // Intermediate trend
        inter_trend = sma_short > sma_medium ? "Bullish" : "Bearish"
        inter_color = sma_short > sma_medium ? color.new(color_dow, 50) : color.new(color.red, 50)

        // Long-term trend
        long_trend = sma_medium > sma_long ? "Bullish" : "Bearish"
        long_color = sma_medium > sma_long ? color.new(color_dow, 30) : color.new(color.red, 30)

        // Display trend information at the right edge of chart
        if barstate.islast
            var table dow_table = table.new(position.top_right, 2, 4, border_width=1)
            table.cell(dow_table, 0, 0, "Dow Theory", bgcolor=color.new(color_dow, 80), text_color=color.white, text_size=size.small)
            table.cell(dow_table, 1, 0, "", bgcolor=color.new(color_dow, 80))

            table.cell(dow_table, 0, 1, "Short-Term", text_color=color.white, text_size=size.tiny)
            table.cell(dow_table, 1, 1, short_trend, bgcolor=short_color, text_color=color.white, text_size=size.tiny)

            table.cell(dow_table, 0, 2, "Intermediate", text_color=color.white, text_size=size.tiny)
            table.cell(dow_table, 1, 2, inter_trend, bgcolor=inter_color, text_color=color.white, text_size=size.tiny)

            table.cell(dow_table, 0, 3, "Long-Term", text_color=color.white, text_size=size.tiny)
            table.cell(dow_table, 1, 3, long_trend, bgcolor=long_color, text_color=color.white, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// IX. MASTER PATTERN DETECTION (마스터 패턴 탐지)
// ═══════════════════════════════════════════════════════════════════════════════

// Detect Master Pattern (Contraction, Expansion, Trend)
f_detect_master_pattern() =>
    if show_master
        // Calculate volatility using ATR
        atr14 = ta.atr(14)
        atr_sma = ta.sma(atr14, 20)

        // Bollinger Bands for contraction detection
        bb_basis = ta.sma(close, 20)
        bb_dev = ta.stdev(close, 20)
        bb_upper = bb_basis + 2 * bb_dev
        bb_lower = bb_basis - 2 * bb_dev
        bb_width = (bb_upper - bb_lower) / bb_basis

        // Contraction: Low volatility (narrow Bollinger Bands)
        is_contraction = bb_width < ta.sma(bb_width, 50) * 0.7

        // Expansion: High volatility (wide Bollinger Bands or strong price move)
        is_expansion = bb_width > ta.sma(bb_width, 50) * 1.3 or atr14 > atr_sma * 1.5

        // Trend: Strong directional movement
        ema_fast = ta.ema(close, 9)
        ema_slow = ta.ema(close, 21)
        is_uptrend = ema_fast > ema_slow and close > ema_fast
        is_downtrend = ema_fast < ema_slow and close < ema_fast

        // Visual representation
        var int contraction_start = na
        var int expansion_start = na

        // Contraction zone (yellow box)
        if is_contraction and na(contraction_start)
            contraction_start := bar_index
        else if not is_contraction and not na(contraction_start)
            box.new(contraction_start, high[1], bar_index, low[1], border_color=color.new(color.yellow, 50), bgcolor=color_master_contraction, text="Contraction", text_color=color.new(color.yellow, 0), text_size=size.small)
            contraction_start := na

        // Expansion line (purple line)
        if is_expansion
            line.new(bar_index - 1, close[1], bar_index, close, color=color_master_expansion, width=3)

        // Trend arrow
        if is_uptrend
            label.new(bar_index, low, "▲ Trend", style=label.style_label_up, color=color_master_trend, textcolor=color.white, size=size.tiny)
        else if is_downtrend
            label.new(bar_index, high, "▼ Trend", style=label.style_label_down, color=color_master_trend, textcolor=color.white, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// X. KONDRATIEV WAVE DETECTION (콘드라티예프 파동 탐지)
// ═══════════════════════════════════════════════════════════════════════════════

// Detect Kondratiev Wave Cycle (Long-term economic cycles: 40-60 years in real economy, adapted for chart timeframes)
// Returns the background color for the current phase
f_detect_kondratiev_wave() =>
    var color bg_color = na
    if show_kondratiev
        // Use very long-term moving averages to identify major cycles
        lookback = kondratiev_lookback

        // Calculate long-term price momentum and trend
        price_sma_ultra_long = ta.sma(close, lookback)
        price_highest = ta.highest(high, lookback)
        price_lowest = ta.lowest(low, lookback)
        price_range = price_highest - price_lowest

        // Position within the cycle (0-1 range)
        cycle_position = price_range > 0 ? (close - price_lowest) / price_range : 0.5

        // Rate of change to determine cycle phase
        roc_long = ta.roc(close, lookback / 4)
        roc_medium = ta.roc(close, lookback / 8)

        // Determine Kondratiev Wave Phase
        var string kondratiev_phase = "Spring"
        var color phase_color = color_kondratiev

        // Spring (봄): Recovery phase - Rising from bottom
        // Summer (여름): Prosperity phase - Peak expansion
        // Autumn (가을): Recession phase - Declining from peak
        // Winter (겨울): Depression phase - Bottom formation

        if cycle_position < 0.25 and roc_long > 0
            kondratiev_phase := "Spring (Recovery)"
            phase_color := color.new(color.green, 70)
            bg_color := color.new(color.green, 95)  // Subtle green tint for Spring
        else if cycle_position >= 0.25 and cycle_position < 0.60 and roc_medium > 0
            kondratiev_phase := "Summer (Prosperity)"
            phase_color := color.new(color.yellow, 70)
            bg_color := color.new(color.yellow, 95)  // Subtle yellow tint for Summer
        else if cycle_position >= 0.60 and roc_long < 0
            kondratiev_phase := "Autumn (Recession)"
            phase_color := color.new(color.orange, 70)
            bg_color := color.new(color.orange, 95)  // Subtle orange tint for Autumn
        else if cycle_position < 0.25 and roc_long < 0
            kondratiev_phase := "Winter (Depression)"
            phase_color := color.new(color.blue, 70)
            bg_color := color.new(color.blue, 96)  // Subtle blue tint for Winter

        // Display Kondratiev Wave information
        if barstate.islast
            var table kondratiev_table = table.new(position.bottom_right, 2, 3, border_width=1)
            table.cell(kondratiev_table, 0, 0, "Kondratiev Wave", bgcolor=color.new(color_kondratiev, 60), text_color=color.white, text_size=size.small)
            table.cell(kondratiev_table, 1, 0, "", bgcolor=color.new(color_kondratiev, 60))

            table.cell(kondratiev_table, 0, 1, "Current Phase", text_color=color.white, text_size=size.tiny)
            table.cell(kondratiev_table, 1, 1, kondratiev_phase, bgcolor=phase_color, text_color=color.white, text_size=size.tiny)

            table.cell(kondratiev_table, 0, 2, "Cycle Position", text_color=color.white, text_size=size.tiny)
            table.cell(kondratiev_table, 1, 2, str.tostring(math.round(cycle_position * 100, 0)) + "%", bgcolor=color.new(color_kondratiev, 80), text_color=color.white, text_size=size.tiny)

        // Draw phase transition markers on significant changes
        var string last_phase = na
        if na(last_phase)
            last_phase := kondratiev_phase
        else if last_phase != kondratiev_phase
            label.new(bar_index, high, kondratiev_phase, style=label.style_label_down, color=phase_color, textcolor=color.white, size=size.small, tooltip="Kondratiev Wave Phase Transition")
            last_phase := kondratiev_phase

    bg_color  // Return background color for seasonal tinting

// ═══════════════════════════════════════════════════════════════════════════════
// XI. DEEP DEPTH CYCLE DETECTION (심층 사이클 탐지)
// ═══════════════════════════════════════════════════════════════════════════════

// Detect Deep Depth Cycles (Multi-timeframe cycle analysis using Hurst-inspired approach)
f_detect_deep_depth_cycle() =>
    if show_deep_cycle
        // Calculate detrended price oscillators for different cycle lengths
        short_cycle_detrend = close - ta.sma(close, cycle_short)
        medium_cycle_detrend = close - ta.sma(close, cycle_medium)
        long_cycle_detrend = close - ta.sma(close, cycle_long)

        // Normalize oscillators
        short_normalized = short_cycle_detrend / ta.stdev(close, cycle_short)
        medium_normalized = medium_cycle_detrend / ta.stdev(close, cycle_medium)
        long_normalized = long_cycle_detrend / ta.stdev(close, cycle_long)

        // Detect cycle extremes (peaks and troughs)
        short_peak = ta.cross(short_normalized, 2.0) or (short_normalized > 2.0 and short_normalized[1] <= 2.0)
        short_trough = ta.cross(-2.0, short_normalized) or (short_normalized < -2.0 and short_normalized[1] >= -2.0)

        medium_peak = ta.cross(medium_normalized, 1.5) or (medium_normalized > 1.5 and medium_normalized[1] <= 1.5)
        medium_trough = ta.cross(-1.5, medium_normalized) or (medium_normalized < -1.5 and medium_normalized[1] >= -1.5)

        long_peak = ta.cross(long_normalized, 1.0) or (long_normalized > 1.0 and long_normalized[1] <= 1.0)
        long_trough = ta.cross(-1.0, long_normalized) or (long_normalized < -1.0 and long_normalized[1] >= -1.0)

        // Composite cycle score (alignment of multiple cycles)
        cycle_alignment = (short_normalized > 0 ? 1 : -1) + (medium_normalized > 0 ? 1 : -1) + (long_normalized > 0 ? 1 : -1)

        // Visual representation
        if short_peak
            label.new(bar_index, high, "SC↑", style=label.style_label_down, color=color.new(color_deep_cycle, 60), textcolor=color.white, size=size.tiny, tooltip="Short Cycle Peak")
        if short_trough
            label.new(bar_index, low, "SC↓", style=label.style_label_up, color=color.new(color_deep_cycle, 60), textcolor=color.white, size=size.tiny, tooltip="Short Cycle Trough")

        if medium_peak
            label.new(bar_index, high, "MC↑", style=label.style_label_down, color=color.new(color_deep_cycle, 40), textcolor=color.white, size=size.tiny, tooltip="Medium Cycle Peak")
        if medium_trough
            label.new(bar_index, low, "MC↓", style=label.style_label_up, color=color.new(color_deep_cycle, 40), textcolor=color.white, size=size.tiny, tooltip="Medium Cycle Trough")

        if long_peak
            label.new(bar_index, high, "LC↑", style=label.style_label_down, color=color_deep_cycle, textcolor=color.white, size=size.small, tooltip="Long Cycle Peak - Major Reversal Likely")
        if long_trough
            label.new(bar_index, low, "LC↓", style=label.style_label_up, color=color_deep_cycle, textcolor=color.white, size=size.small, tooltip="Long Cycle Trough - Major Reversal Likely")

        // Highlight strong cycle alignment (all 3 cycles in same direction)
        if math.abs(cycle_alignment) == 3
            bgcolor_color = cycle_alignment > 0 ? color.new(color.green, 95) : color.new(color.red, 95)
            bgcolor(bgcolor_color, title="Cycle Alignment")

        // Display cycle status
        if barstate.islast
            var table cycle_table = table.new(position.middle_right, 2, 4, border_width=1)
            table.cell(cycle_table, 0, 0, "Deep Cycles", bgcolor=color.new(color_deep_cycle, 60), text_color=color.white, text_size=size.small)
            table.cell(cycle_table, 1, 0, "", bgcolor=color.new(color_deep_cycle, 60))

            table.cell(cycle_table, 0, 1, "Short", text_color=color.white, text_size=size.tiny)
            short_status = short_normalized > 0 ? "↑" : "↓"
            table.cell(cycle_table, 1, 1, short_status, bgcolor=short_normalized > 0 ? color.new(color.green, 70) : color.new(color.red, 70), text_color=color.white, text_size=size.tiny)

            table.cell(cycle_table, 0, 2, "Medium", text_color=color.white, text_size=size.tiny)
            medium_status = medium_normalized > 0 ? "↑" : "↓"
            table.cell(cycle_table, 1, 2, medium_status, bgcolor=medium_normalized > 0 ? color.new(color.green, 70) : color.new(color.red, 70), text_color=color.white, text_size=size.tiny)

            table.cell(cycle_table, 0, 3, "Long", text_color=color.white, text_size=size.tiny)
            long_status = long_normalized > 0 ? "↑" : "↓"
            table.cell(cycle_table, 1, 3, long_status, bgcolor=long_normalized > 0 ? color.new(color.green, 70) : color.new(color.red, 70), text_color=color.white, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// XII. JESSE LIVERMORE ACCUMULATION CYLINDER DETECTION (제시 리버모어 축적 실린더 탐지)
// ═══════════════════════════════════════════════════════════════════════════════

// Detect Jesse Livermore's Accumulation Cylinder (Horizontal consolidation pattern)
f_detect_livermore_cylinder() =>
    if show_livermore
        // Track consolidation periods
        var int cylinder_start = na
        var float cylinder_high = na
        var float cylinder_low = na
        var int bars_in_cylinder = 0

        // Calculate current price range
        range_bars = cylinder_min_bars
        recent_high = ta.highest(high, range_bars)
        recent_low = ta.lowest(low, range_bars)
        recent_range = recent_high - recent_low
        recent_mid = (recent_high + recent_low) / 2
        range_pct = (recent_range / recent_mid) * 100

        // Check if we're in a consolidation (cylinder)
        is_consolidating = range_pct <= cylinder_range_pct

        // Volume analysis (accumulation should show consistent or increasing volume)
        avg_volume = ta.sma(volume, 20)
        is_volume_present = volume > avg_volume * 0.5

        if is_consolidating and is_volume_present
            if na(cylinder_start)
                // Start new cylinder
                cylinder_start := bar_index - range_bars
                cylinder_high := recent_high
                cylinder_low := recent_low
                bars_in_cylinder := range_bars
            else
                // Continue existing cylinder
                bars_in_cylinder := bars_in_cylinder + 1
                // Update boundaries if price extends slightly
                cylinder_high := math.max(cylinder_high, high)
                cylinder_low := math.min(cylinder_low, low)
        else
            // Check if we're breaking out of a cylinder
            if not na(cylinder_start) and bars_in_cylinder >= cylinder_min_bars
                // Draw the cylinder (accumulation zone)
                cylinder_color = color_livermore
                box.new(cylinder_start, cylinder_high, bar_index - 1, cylinder_low,
                        border_color=color.new(color.olive, 30),
                        bgcolor=cylinder_color,
                        text="Livermore Cylinder\n" + str.tostring(bars_in_cylinder) + " bars",
                        text_color=color.new(color.olive, 0),
                        text_size=size.small,
                        text_halign=text.align_center,
                        text_valign=text.align_center)

                // Detect breakout direction
                breakout_up = close > cylinder_high
                breakout_down = close < cylinder_low

                // Volume confirmation for breakout
                current_volume = volume
                avg_volume_20 = ta.sma(volume, 20)
                is_volume_confirmed = current_volume > avg_volume_20 * cylinder_breakout_volume_mult

                // Calculate volume ratio for tooltip
                volume_ratio = avg_volume_20 > 0 ? current_volume / avg_volume_20 : 0

                if breakout_up
                    if is_volume_confirmed
                        // Confirmed bullish breakout with volume
                        label.new(bar_index, low, "Livermore Breakout ▲\nVol: " + str.tostring(volume_ratio, "#.#") + "x",
                                 style=label.style_label_up,
                                 color=color.new(color.green, 0),
                                 textcolor=color.white,
                                 size=size.normal,
                                 tooltip="Livermore Cylinder CONFIRMED Bullish Breakout\nVolume: " + str.tostring(volume_ratio, "#.##") + "x average\nHistorically significant breakout pattern")
                        // Draw strong arrow for confirmed breakout
                        line.new(bar_index - 1, cylinder_high, bar_index + 5, cylinder_high + (cylinder_high - cylinder_low),
                                color=color.new(color.green, 0),
                                width=3,
                                style=line.style_arrow_right)
                    else
                        // Weak breakout without volume confirmation
                        label.new(bar_index, low, "Weak Breakout ▲",
                                 style=label.style_label_up,
                                 color=color.new(color.green, 50),
                                 textcolor=color.white,
                                 size=size.small,
                                 tooltip="Cylinder breakout without volume confirmation\nVolume: " + str.tostring(volume_ratio, "#.##") + "x average\nLower probability pattern")
                        // Draw dashed arrow for weak breakout
                        line.new(bar_index - 1, cylinder_high, bar_index + 5, cylinder_high + (cylinder_high - cylinder_low) * 0.5,
                                color=color.new(color.green, 50),
                                width=1,
                                style=line.style_dashed)
                else if breakout_down
                    if is_volume_confirmed
                        // Confirmed bearish breakout with volume
                        label.new(bar_index, high, "Livermore Breakout ▼\nVol: " + str.tostring(volume_ratio, "#.#") + "x",
                                 style=label.style_label_down,
                                 color=color.new(color.red, 0),
                                 textcolor=color.white,
                                 size=size.normal,
                                 tooltip="Livermore Cylinder CONFIRMED Bearish Breakout\nVolume: " + str.tostring(volume_ratio, "#.##") + "x average\nHistorically significant breakdown pattern")
                        // Draw strong arrow for confirmed breakout
                        line.new(bar_index - 1, cylinder_low, bar_index + 5, cylinder_low - (cylinder_high - cylinder_low),
                                color=color.new(color.red, 0),
                                width=3,
                                style=line.style_arrow_right)
                    else
                        // Weak breakout without volume confirmation
                        label.new(bar_index, high, "Weak Breakout ▼",
                                 style=label.style_label_down,
                                 color=color.new(color.red, 50),
                                 textcolor=color.white,
                                 size=size.small,
                                 tooltip="Cylinder breakout without volume confirmation\nVolume: " + str.tostring(volume_ratio, "#.##") + "x average\nLower probability pattern")
                        // Draw dashed arrow for weak breakout
                        line.new(bar_index - 1, cylinder_low, bar_index + 5, cylinder_low - (cylinder_high - cylinder_low) * 0.5,
                                color=color.new(color.red, 50),
                                width=1,
                                style=line.style_dashed)

            // Reset cylinder tracking
            cylinder_start := na
            cylinder_high := na
            cylinder_low := na
            bars_in_cylinder := 0

        // Draw current forming cylinder (in progress)
        if not na(cylinder_start) and bars_in_cylinder >= cylinder_min_bars and barstate.islast
            box.new(cylinder_start, cylinder_high, bar_index, cylinder_low,
                    border_color=color.new(color.olive, 30),
                    bgcolor=color.new(color_livermore, 30),
                    border_style=line.style_dashed,
                    text="Forming Cylinder\n" + str.tostring(bars_in_cylinder) + " bars",
                    text_color=color.new(color.olive, 0),
                    text_size=size.small,
                    text_halign=text.align_center,
                    text_valign=text.align_center)

// ═══════════════════════════════════════════════════════════════════════════════
// XIII. NEOWAVE ADVANCED PATTERNS (NEo파동 고급 패턴)
// ═══════════════════════════════════════════════════════════════════════════════

// Detect Diametric Formation (7-wave pattern - Glenn Neely discovery)
f_detect_diametric_formation() =>
    if array.size(zz_price) >= 8 and show_neowave_advanced and show_diametric
        size = array.size(zz_price)

        // Get last 8 pivots for 7-wave pattern (0-A-B-C-D-E-F-G)
        p0 = array.get(zz_price, size - 8)
        p1 = array.get(zz_price, size - 7)  // A
        p2 = array.get(zz_price, size - 6)  // B
        p3 = array.get(zz_price, size - 5)  // C
        p4 = array.get(zz_price, size - 4)  // D
        p5 = array.get(zz_price, size - 3)  // E
        p6 = array.get(zz_price, size - 2)  // F
        p7 = array.get(zz_price, size - 1)  // G

        b0 = array.get(zz_bar, size - 8)
        b1 = array.get(zz_bar, size - 7)
        b2 = array.get(zz_bar, size - 6)
        b3 = array.get(zz_bar, size - 5)
        b4 = array.get(zz_bar, size - 4)
        b5 = array.get(zz_bar, size - 3)
        b6 = array.get(zz_bar, size - 2)
        b7 = array.get(zz_bar, size - 1)

        // Calculate wave sizes
        wave_d = math.abs(p4 - p3)
        wave_e = math.abs(p5 - p4)

        // Determine pattern direction
        is_bullish = p1 > p0

        // Directional color based on pattern direction
        pattern_color = is_bullish ? color_bullish_neowave : color_bearish_neowave

        // Critical Diametric Rule: Wave-E becomes larger than Wave-D
        // (violates contracting triangle rules)
        is_diametric = wave_e > wave_d

        // Velocity check: Wave-E does NOT move quickly enough for zigzag
        e_velocity = wave_e / math.max(b5 - b4, 1)
        d_velocity = wave_d / math.max(b4 - b3, 1)
        zigzag_threshold = d_velocity * 1.5

        not_zigzag = e_velocity < zigzag_threshold

        if is_diametric and not_zigzag
            // Draw Diametric Formation with "bow tie" shape
            line.new(b0, p0, b1, p1, color=pattern_color, width=2)
            line.new(b1, p1, b2, p2, color=pattern_color, width=2)
            line.new(b2, p2, b3, p3, color=pattern_color, width=2)
            line.new(b3, p3, b4, p4, color=pattern_color, width=2)
            line.new(b4, p4, b5, p5, color=pattern_color, width=2)
            line.new(b5, p5, b6, p6, color=pattern_color, width=2)
            line.new(b6, p6, b7, p7, color=pattern_color, width=2)

            // Label waves A-G
            label.new(b1, p1, "A", style=is_bullish ? label.style_label_up : label.style_label_down,
                     color=color_neowave_label, textcolor=color.white, size=size.tiny)
            label.new(b2, p2, "B", style=is_bullish ? label.style_label_down : label.style_label_up,
                     color=color_neowave_label, textcolor=color.white, size=size.tiny)
            label.new(b3, p3, "C", style=is_bullish ? label.style_label_up : label.style_label_down,
                     color=color_neowave_label, textcolor=color.white, size=size.tiny)
            label.new(b4, p4, "D", style=is_bullish ? label.style_label_down : label.style_label_up,
                     color=color_neowave_label, textcolor=color.white, size=size.tiny)
            label.new(b5, p5, "E", style=is_bullish ? label.style_label_up : label.style_label_down,
                     color=color_neowave_label, textcolor=color.white, size=size.tiny)
            label.new(b6, p6, "F", style=is_bullish ? label.style_label_down : label.style_label_up,
                     color=color_neowave_label, textcolor=color.white, size=size.tiny)
            label.new(b7, p7, "G", style=is_bullish ? label.style_label_up : label.style_label_down,
                     color=color_neowave_label, textcolor=color.white, size=size.tiny)

            // Add pattern label
            label.new(b4, p4 + (is_bullish ? atr_value * 3 : -atr_value * 3),
                     "DIAMETRIC\n7-Wave Formation",
                     style=label.style_none, textcolor=color_neowave_label, size=size.normal,
                     tooltip="NEoWave Diametric: Wave-E > Wave-D, indicating complex correction")

// Detect Extracting Triangle (Glenn Neely - higher highs & higher lows)
f_detect_extracting_triangle() =>
    if array.size(zz_price) >= 6 and show_neowave_advanced and show_extracting_triangle
        size = array.size(zz_price)

        p0 = array.get(zz_price, size - 6)
        p1 = array.get(zz_price, size - 5)  // A
        p2 = array.get(zz_price, size - 4)  // B
        p3 = array.get(zz_price, size - 3)  // C
        p4 = array.get(zz_price, size - 2)  // D
        p5 = array.get(zz_price, size - 1)  // E

        b0 = array.get(zz_bar, size - 6)
        b1 = array.get(zz_bar, size - 5)
        b2 = array.get(zz_bar, size - 4)
        b3 = array.get(zz_bar, size - 3)
        b4 = array.get(zz_bar, size - 2)
        b5 = array.get(zz_bar, size - 1)

        d0 = array.get(zz_direction, size - 6)
        is_bullish = d0 == -1  // Starting from low

        // Directional color based on pattern direction
        pattern_color = is_bullish ? color_bullish_neowave : color_bearish_neowave

        // CRITICAL RULE: Wave-D ALWAYS larger than Wave-C
        wave_c = math.abs(p3 - p2)
        wave_d = math.abs(p4 - p3)
        wave_d_larger = wave_d > wave_c

        // Price progression check: Higher lows AND higher highs
        higher_lows = is_bullish ? (p2 > p0 and p4 > p2) : (p2 < p0 and p4 < p2)
        higher_highs = is_bullish ? (p3 > p1 and p5 > p3) : (p3 < p1 and p5 < p3)

        extracting_price_action = higher_lows and higher_highs

        if wave_d_larger and extracting_price_action
            // Draw Extracting Triangle
            line.new(b0, p0, b1, p1, color=pattern_color, width=2)
            line.new(b1, p1, b2, p2, color=pattern_color, width=2)
            line.new(b2, p2, b3, p3, color=pattern_color, width=2)
            line.new(b3, p3, b4, p4, color=pattern_color, width=2)
            line.new(b4, p4, b5, p5, color=pattern_color, width=2)

            // Labels
            label.new(b1, p1, "A", style=is_bullish ? label.style_label_down : label.style_label_up,
                     color=color_neowave_label, textcolor=color.white, size=size.tiny)
            label.new(b2, p2, "B", style=is_bullish ? label.style_label_up : label.style_label_down,
                     color=color_neowave_label, textcolor=color.white, size=size.tiny)
            label.new(b3, p3, "C", style=is_bullish ? label.style_label_down : label.style_label_up,
                     color=color_neowave_label, textcolor=color.white, size=size.tiny)
            label.new(b4, p4, "D", style=is_bullish ? label.style_label_up : label.style_label_down,
                     color=color_neowave_label, textcolor=color.white, size=size.tiny,
                     tooltip="Wave-D is ALWAYS larger than Wave-C in Extracting Triangle")
            label.new(b5, p5, "E", style=is_bullish ? label.style_label_down : label.style_label_up,
                     color=color_neowave_label, textcolor=color.white, size=size.tiny)

            label.new(b3, p3 + (is_bullish ? atr_value * 2.5 : -atr_value * 2.5),
                     "EXTRACTING △\nHigher Highs & Lows",
                     style=label.style_none, textcolor=color_neowave_label, size=size.small)

// Detect Neutral Triangle (C-wave longest)
f_detect_neutral_triangle() =>
    if array.size(zz_price) >= 6 and show_neowave_advanced and show_neutral_triangle
        size = array.size(zz_price)

        p0 = array.get(zz_price, size - 6)
        p1 = array.get(zz_price, size - 5)
        p2 = array.get(zz_price, size - 4)
        p3 = array.get(zz_price, size - 3)
        p4 = array.get(zz_price, size - 2)
        p5 = array.get(zz_price, size - 1)

        b0 = array.get(zz_bar, size - 6)
        b3 = array.get(zz_bar, size - 3)

        // Calculate wave sizes
        wave_a = math.abs(p1 - p0)
        wave_c = math.abs(p3 - p2)
        wave_e = math.abs(p5 - p4)
        wave_b = math.abs(p2 - p1)
        wave_d = math.abs(p4 - p3)

        // Neutral Triangle Rules:
        // - Wave-C is longest in direction of trend
        // - Wave-D is longest against trend (usually longest overall)
        c_is_longest_with_trend = wave_c == math.max(wave_a, math.max(wave_c, wave_e))
        d_is_longest_against_trend = wave_d == math.max(wave_b, wave_d)

        // Behavior: Low volatility (calm, consistent)
        price_range = math.max(p1, math.max(p3, p5)) - math.min(p0, math.min(p2, p4))
        time_span = b3 - b0
        avg_volatility = price_range / math.max(time_span, 1)

        low_volatility = avg_volatility < atr_value * 0.5  // Calm behavior

        if c_is_longest_with_trend and d_is_longest_against_trend and low_volatility
            d0 = array.get(zz_direction, size - 6)
            is_bullish = d0 == -1

            // Directional color based on pattern direction
            pattern_color = is_bullish ? color_bullish_neowave : color_bearish_neowave

            label.new(b3, p3 + (is_bullish ? atr_value * 2 : -atr_value * 2),
                     "NEUTRAL △\nC-Wave Extension",
                     style=label.style_none, textcolor=color_neowave_label, size=size.small,
                     tooltip="Neutral Triangle: C-wave longest (like 3rd wave extension)")

// ═══════════════════════════════════════════════════════════════════════════════
// XIV. CHART PATTERNS - HEAD & SHOULDERS (차트 패턴 - 헤드앤숄더)
// ═══════════════════════════════════════════════════════════════════════════════

// Detect Head and Shoulders Top/Bottom (Bulkowski statistical pattern)
f_detect_head_shoulders() =>
    if array.size(zz_price) >= 6 and show_chart_patterns and show_head_shoulders
        size = array.size(zz_price)

        // Need 5 pivots: Left Shoulder - Head - Right Shoulder (with valleys between)
        p0 = array.get(zz_price, size - 6)  // Start
        p1 = array.get(zz_price, size - 5)  // Left Shoulder
        p2 = array.get(zz_price, size - 4)  // Valley 1
        p3 = array.get(zz_price, size - 3)  // Head
        p4 = array.get(zz_price, size - 2)  // Valley 2
        p5 = array.get(zz_price, size - 1)  // Right Shoulder

        b0 = array.get(zz_bar, size - 6)
        b1 = array.get(zz_bar, size - 5)
        b2 = array.get(zz_bar, size - 4)
        b3 = array.get(zz_bar, size - 3)
        b4 = array.get(zz_bar, size - 2)
        b5 = array.get(zz_bar, size - 1)

        d1 = array.get(zz_direction, size - 5)

        // HEAD & SHOULDERS TOP: Head is highest
        if d1 == 1  // Starting with peak
            // Rule: Head must be higher than both shoulders
            head_highest = p3 > p1 and p3 > p5

            // Rule: Shoulders should be approximately equal (within tolerance)
            shoulder_symmetry = math.abs(p1 - p5) / p1 < 0.1  // Within 10%

            // Neckline should be near-horizontal (not too steep)
            neckline_slope = math.abs(p4 - p2) / p2
            near_horizontal = neckline_slope < 0.15  // Within 15%

            if head_highest and shoulder_symmetry and near_horizontal
                // Directional color based on pattern direction
                pattern_color = color_bearish_chart_pattern  // Bearish pattern

                // Draw pattern
                line.new(b0, p0, b1, p1, color=pattern_color, width=2)
                line.new(b1, p1, b2, p2, color=pattern_color, width=2)
                line.new(b2, p2, b3, p3, color=pattern_color, width=2)
                line.new(b3, p3, b4, p4, color=pattern_color, width=2)
                line.new(b4, p4, b5, p5, color=pattern_color, width=2)

                // Draw neckline
                neckline_price = (p2 + p4) / 2
                line.new(b2, p2, b4, p4, color=pattern_color, width=1, style=line.style_dashed)

                // Calculate target using measure rule
                pattern_height = p3 - neckline_price
                target = neckline_price - pattern_height

                // Labels
                label.new(b1, p1, "LS", style=label.style_label_down,
                         color=color_chart_pattern_label, textcolor=color.white, size=size.tiny)
                label.new(b3, p3, "HEAD", style=label.style_label_down,
                         color=color_chart_pattern_label, textcolor=color.white, size=size.normal)
                label.new(b5, p5, "RS", style=label.style_label_down,
                         color=color_chart_pattern_label, textcolor=color.white, size=size.tiny)

                label.new(b3, p3 + atr_value * 2,
                         "HEAD & SHOULDERS TOP\nProjection: " + str.tostring(target, format.mintick),
                         style=label.style_none, textcolor=color_chart_pattern_label, size=size.normal,
                         tooltip="Classic reversal pattern | Historical success rate: 83% (Bulkowski)")

        // HEAD & SHOULDERS BOTTOM: Head is lowest
        if d1 == -1  // Starting with valley
            // Rule: Head must be lower than both shoulders
            head_lowest = p3 < p1 and p3 < p5

            shoulder_symmetry = math.abs(p1 - p5) / p1 < 0.1

            neckline_slope = math.abs(p4 - p2) / p2
            near_horizontal = neckline_slope < 0.15

            if head_lowest and shoulder_symmetry and near_horizontal
                // Directional color based on pattern direction
                pattern_color = color_bullish_chart_pattern  // Bullish pattern

                // Draw pattern
                line.new(b0, p0, b1, p1, color=pattern_color, width=2)
                line.new(b1, p1, b2, p2, color=pattern_color, width=2)
                line.new(b2, p2, b3, p3, color=pattern_color, width=2)
                line.new(b3, p3, b4, p4, color=pattern_color, width=2)
                line.new(b4, p4, b5, p5, color=pattern_color, width=2)

                // Draw neckline
                neckline_price = (p2 + p4) / 2
                line.new(b2, p2, b4, p4, color=pattern_color, width=1, style=line.style_dashed)

                // Calculate target
                pattern_height = neckline_price - p3
                target = neckline_price + pattern_height

                label.new(b1, p1, "LS", style=label.style_label_up,
                         color=color_chart_pattern_label, textcolor=color.white, size=size.tiny)
                label.new(b3, p3, "HEAD", style=label.style_label_up,
                         color=color_chart_pattern_label, textcolor=color.white, size=size.normal)
                label.new(b5, p5, "RS", style=label.style_label_up,
                         color=color_chart_pattern_label, textcolor=color.white, size=size.tiny)

                label.new(b3, p3 - atr_value * 2,
                         "HEAD & SHOULDERS BOTTOM\nProjection: " + str.tostring(target, format.mintick),
                         style=label.style_none, textcolor=color_chart_pattern_label, size=size.normal,
                         tooltip="Classic reversal pattern | Historical success rate: 87% (Bulkowski)")

// Detect Double Top/Bottom (with Adam & Eve variations)
f_detect_double_patterns() =>
    if array.size(zz_price) >= 4 and show_chart_patterns and show_double_patterns
        size = array.size(zz_price)

        p0 = array.get(zz_price, size - 4)
        p1 = array.get(zz_price, size - 3)  // First peak/valley
        p2 = array.get(zz_price, size - 2)  // Middle valley/peak
        p3 = array.get(zz_price, size - 1)  // Second peak/valley

        b0 = array.get(zz_bar, size - 4)
        b1 = array.get(zz_bar, size - 3)
        b2 = array.get(zz_bar, size - 2)
        b3 = array.get(zz_bar, size - 1)

        d1 = array.get(zz_direction, size - 3)

        // DOUBLE TOP
        if d1 == 1
            // Peaks should be approximately equal (within 3%)
            peaks_equal = math.abs(p1 - p3) / p1 < 0.03

            // Second peak should not exceed first
            second_not_higher = p3 <= p1 * 1.01

            if peaks_equal and second_not_higher
                // Directional color based on pattern direction
                pattern_color = color_bearish_chart_pattern  // Bearish pattern

                // Determine Adam/Eve pattern based on sharpness
                bars_to_first = b1 - b0
                bars_to_second = b3 - b2

                first_sharp = bars_to_first < 15  // Adam = sharp, narrow
                second_sharp = bars_to_second < 15

                pattern_type = first_sharp and second_sharp ? "Adam & Adam" :
                               first_sharp and not second_sharp ? "Adam & Eve" :
                               not first_sharp and second_sharp ? "Eve & Adam" : "Eve & Eve"

                // Calculate target
                neckline = p2
                pattern_height = p1 - neckline
                target = neckline - pattern_height

                label.new(b2, p2 + atr_value * 2,
                         "DOUBLE TOP\n" + pattern_type + "\nProjection: " + str.tostring(target, format.mintick),
                         style=label.style_none, textcolor=color_chart_pattern_label, size=size.small,
                         tooltip="Classic reversal pattern | Best: Eve & Eve (Bulkowski)")

        // DOUBLE BOTTOM
        if d1 == -1
            valleys_equal = math.abs(p1 - p3) / p1 < 0.03
            second_not_lower = p3 >= p1 * 0.99

            if valleys_equal and second_not_lower
                // Directional color based on pattern direction
                pattern_color = color_bullish_chart_pattern  // Bullish pattern

                bars_to_first = b1 - b0
                bars_to_second = b3 - b2

                first_sharp = bars_to_first < 15
                second_sharp = bars_to_second < 15

                pattern_type = first_sharp and second_sharp ? "Adam & Adam" :
                               first_sharp and not second_sharp ? "Adam & Eve" :
                               not first_sharp and second_sharp ? "Eve & Adam" : "Eve & Eve"

                neckline = p2
                pattern_height = neckline - p1
                target = neckline + pattern_height

                label.new(b2, p2 - atr_value * 2,
                         "DOUBLE BOTTOM\n" + pattern_type + "\nProjection: " + str.tostring(target, format.mintick),
                         style=label.style_none, textcolor=color_chart_pattern_label, size=size.small,
                         tooltip="Classic reversal pattern | Best: Eve & Eve (Bulkowski)")

// Detect Rectangle Patterns (Bulkowski - High Success Rate)
f_detect_rectangles() =>
    if array.size(zz_price) >= 6 and show_chart_patterns and show_rectangles
        size = array.size(zz_price)

        // Need at least 6 pivots for Rectangle: alternating peaks/valleys within range
        p0 = array.get(zz_price, size - 6)
        p1 = array.get(zz_price, size - 5)
        p2 = array.get(zz_price, size - 4)
        p3 = array.get(zz_price, size - 3)
        p4 = array.get(zz_price, size - 2)
        p5 = array.get(zz_price, size - 1)

        b0 = array.get(zz_bar, size - 6)
        b1 = array.get(zz_bar, size - 5)
        b2 = array.get(zz_bar, size - 4)
        b3 = array.get(zz_bar, size - 3)
        b4 = array.get(zz_bar, size - 2)
        b5 = array.get(zz_bar, size - 1)

        d0 = array.get(zz_direction, size - 6)

        // Rectangle requires horizontal resistance and support
        // Peaks at similar levels, valleys at similar levels

        if d0 == -1  // Starting from valley (Rectangle Bottom - BULLISH)
            // Valleys: p0, p2, p4 should be near equal (support level)
            // Peaks: p1, p3, p5 should be near equal (resistance level)

            support = (p0 + p2 + p4) / 3
            resistance = (p1 + p3 + p5) / 3

            // Check if valleys are within 3% of support
            support_flat = math.abs(p0 - support) / support < 0.03 and
                          math.abs(p2 - support) / support < 0.03 and
                          math.abs(p4 - support) / support < 0.03

            // Check if peaks are within 3% of resistance
            resistance_flat = math.abs(p1 - resistance) / resistance < 0.03 and
                            math.abs(p3 - resistance) / resistance < 0.03 and
                            math.abs(p5 - resistance) / resistance < 0.03

            // Rectangle height should be reasonable (5-15% range)
            height_ratio = (resistance - support) / support
            valid_height = height_ratio > 0.05 and height_ratio < 0.15

            if support_flat and resistance_flat and valid_height
                // Directional color based on pattern direction
                pattern_color = color_bullish_chart_pattern  // Bullish pattern

                // Draw rectangle
                line.new(b0, support, b5, support, color=pattern_color, width=2, style=line.style_solid)
                line.new(b0, resistance, b5, resistance, color=pattern_color, width=2, style=line.style_solid)
                line.new(b0, support, b0, resistance, color=pattern_color, width=1, style=line.style_dotted)
                line.new(b5, support, b5, resistance, color=pattern_color, width=1, style=line.style_dotted)

                // Calculate target (height of rectangle projected upward)
                pattern_height = resistance - support
                target = resistance + pattern_height

                label.new(b3, (support + resistance) / 2,
                         "RECTANGLE BOTTOM\nProjection: " + str.tostring(target, format.mintick),
                         style=label.style_none, textcolor=color_chart_pattern_label, size=size.normal,
                         tooltip="Continuation pattern | Historical success rate: 85% (Bulkowski)")

        if d0 == 1  // Starting from peak (Rectangle Top - BEARISH)
            // Peaks: p0, p2, p4 should be near equal (resistance level)
            // Valleys: p1, p3, p5 should be near equal (support level)

            resistance = (p0 + p2 + p4) / 3
            support = (p1 + p3 + p5) / 3

            resistance_flat = math.abs(p0 - resistance) / resistance < 0.03 and
                            math.abs(p2 - resistance) / resistance < 0.03 and
                            math.abs(p4 - resistance) / resistance < 0.03

            support_flat = math.abs(p1 - support) / support < 0.03 and
                          math.abs(p3 - support) / support < 0.03 and
                          math.abs(p5 - support) / support < 0.03

            height_ratio = (resistance - support) / support
            valid_height = height_ratio > 0.05 and height_ratio < 0.15

            if support_flat and resistance_flat and valid_height
                // Directional color based on pattern direction
                pattern_color = color_bearish_chart_pattern  // Bearish pattern

                line.new(b0, support, b5, support, color=pattern_color, width=2, style=line.style_solid)
                line.new(b0, resistance, b5, resistance, color=pattern_color, width=2, style=line.style_solid)
                line.new(b0, support, b0, resistance, color=pattern_color, width=1, style=line.style_dotted)
                line.new(b5, support, b5, resistance, color=pattern_color, width=1, style=line.style_dotted)

                pattern_height = resistance - support
                target = support - pattern_height

                label.new(b3, (support + resistance) / 2,
                         "RECTANGLE TOP\nProjection: " + str.tostring(target, format.mintick),
                         style=label.style_none, textcolor=color_chart_pattern_label, size=size.normal,
                         tooltip="Continuation pattern | Historical success rate: 80% (Bulkowski)")

// Detect Diamond Patterns (Bulkowski - High Success Rate)
f_detect_diamonds() =>
    if array.size(zz_price) >= 7 and show_chart_patterns and show_diamonds
        size = array.size(zz_price)

        // Diamond: Broadening followed by contracting
        // Shape: V-shape opening, then inverted V-shape closing
        p0 = array.get(zz_price, size - 7)
        p1 = array.get(zz_price, size - 6)
        p2 = array.get(zz_price, size - 5)
        p3 = array.get(zz_price, size - 4)  // Widest point
        p4 = array.get(zz_price, size - 3)
        p5 = array.get(zz_price, size - 2)
        p6 = array.get(zz_price, size - 1)

        b0 = array.get(zz_bar, size - 7)
        b1 = array.get(zz_bar, size - 6)
        b2 = array.get(zz_bar, size - 5)
        b3 = array.get(zz_bar, size - 4)
        b4 = array.get(zz_bar, size - 3)
        b5 = array.get(zz_bar, size - 2)
        b6 = array.get(zz_bar, size - 1)

        d0 = array.get(zz_direction, size - 7)

        // DIAMOND BOTTOM (Bullish reversal)
        if d0 == -1  // Starting from valley
            // Diamond requires widening then narrowing volatility
            // Early swings smaller, middle swings largest, late swings smaller

            swing1 = math.abs(p1 - p0)
            swing2 = math.abs(p2 - p1)
            swing3 = math.abs(p3 - p2)  // Should be largest
            swing4 = math.abs(p4 - p3)
            swing5 = math.abs(p5 - p4)
            swing6 = math.abs(p6 - p5)

            // Check for expansion then contraction
            expanding = swing2 > swing1 and swing3 > swing2
            contracting = swing5 < swing4 and swing6 < swing5

            // Middle swing should be largest
            middle_largest = swing3 > swing1 and swing3 > swing6

            if expanding and contracting and middle_largest
                // Directional color based on pattern direction
                pattern_color = color_bullish_chart_pattern  // Bullish pattern

                // Draw diamond shape
                line.new(b0, p0, b1, p1, color=pattern_color, width=2)
                line.new(b1, p1, b2, p2, color=pattern_color, width=2)
                line.new(b2, p2, b3, p3, color=pattern_color, width=2)
                line.new(b3, p3, b4, p4, color=pattern_color, width=2)
                line.new(b4, p4, b5, p5, color=pattern_color, width=2)
                line.new(b5, p5, b6, p6, color=pattern_color, width=2)

                // Calculate target
                pattern_height = p3 - p0  // From lowest to highest point
                target = p6 + pattern_height

                label.new(b3, p3 + atr_value * 2,
                         "DIAMOND BOTTOM\nProjection: " + str.tostring(target, format.mintick),
                         style=label.style_none, textcolor=color_chart_pattern_label, size=size.normal,
                         tooltip="Reversal pattern | Historical success rate: 81% (Bulkowski)")

        // DIAMOND TOP (Bearish reversal)
        if d0 == 1  // Starting from peak
            swing1 = math.abs(p1 - p0)
            swing2 = math.abs(p2 - p1)
            swing3 = math.abs(p3 - p2)
            swing4 = math.abs(p4 - p3)
            swing5 = math.abs(p5 - p4)
            swing6 = math.abs(p6 - p5)

            expanding = swing2 > swing1 and swing3 > swing2
            contracting = swing5 < swing4 and swing6 < swing5
            middle_largest = swing3 > swing1 and swing3 > swing6

            if expanding and contracting and middle_largest
                // Directional color based on pattern direction
                pattern_color = color_bearish_chart_pattern  // Bearish pattern

                line.new(b0, p0, b1, p1, color=pattern_color, width=2)
                line.new(b1, p1, b2, p2, color=pattern_color, width=2)
                line.new(b2, p2, b3, p3, color=pattern_color, width=2)
                line.new(b3, p3, b4, p4, color=pattern_color, width=2)
                line.new(b4, p4, b5, p5, color=pattern_color, width=2)
                line.new(b5, p5, b6, p6, color=pattern_color, width=2)

                pattern_height = p0 - p3  // From highest to lowest point
                target = p6 - pattern_height

                label.new(b3, p3 - atr_value * 2,
                         "DIAMOND TOP\nProjection: " + str.tostring(target, format.mintick),
                         style=label.style_none, textcolor=color_chart_pattern_label, size=size.normal,
                         tooltip="Reversal pattern | Historical success rate: 78% (Bulkowski)")

// ═══════════════════════════════════════════════════════════════════════════════
// XV. MAIN EXECUTION (메인 실행)
// ═══════════════════════════════════════════════════════════════════════════════

// Execute pattern detection functions
if barstate.islast or barstate.isrealtime
    // Elliott Wave patterns
    f_detect_impulse_wave()
    f_detect_corrective_wave()
    f_detect_connecting_wave_wxy()
    f_detect_triangle_wave()

    // Fractal Elliott Wave (Dual ZigZag - Major/Minor)
    f_detect_major_impulse()
    f_detect_major_corrective()
    f_detect_minor_impulse()
    f_detect_minor_corrective()

    // NEoWave Advanced Patterns (Glenn Neely)
    f_detect_diametric_formation()
    f_detect_extracting_triangle()
    f_detect_neutral_triangle()

    // Chart Patterns (Bulkowski)
    f_detect_head_shoulders()
    f_detect_double_patterns()
    f_detect_rectangles()
    f_detect_diamonds()

    // Harmonic patterns
    f_detect_gartley()
    f_detect_butterfly()
    f_detect_bat()
    f_detect_crab()
    f_detect_shark()
    f_detect_cypher()

    // Scott Carney Advanced Patterns
    f_detect_deep_crab()
    f_detect_5_0_pattern()
    f_detect_shark_advanced()
    f_detect_alternate_bat()
    f_detect_three_drives()
    f_detect_abcd()

    // BAMM Patterns (Bad Action Magnet Move - Scott Carney Vol 2/3)
    f_detect_bamm()
    f_detect_rsi_bamm()

    // Wyckoff (Phase Detection + 9 Buying/Selling Tests)
    f_detect_wyckoff()
    f_detect_wyckoff_9_tests()

    // Chart Patterns (Bulkowski - Encyclopedia of Chart Patterns)
    f_detect_bump_and_run()
    f_detect_cup_and_handle()

// Wave Failure Classifications (NEoWave - Glen Neely 8 Types)
f_detect_wave_failures()

// Dow Theory (runs on every bar for table update)
f_detect_dow_theory()

// Master Pattern (runs on every bar for real-time detection)
f_detect_master_pattern()

// Kondratiev Wave (runs on every bar for phase detection)
kondratiev_bg_color = f_detect_kondratiev_wave()

// Apply Kondratiev seasonal background tinting
if kondratiev_show_background and not na(kondratiev_bg_color)
    bgcolor(kondratiev_bg_color, title="Kondratiev Seasonal Background")

// Deep Depth Cycle (runs on every bar for cycle analysis)
f_detect_deep_depth_cycle()

// Jesse Livermore Accumulation Cylinder (runs on every bar for consolidation detection)
f_detect_livermore_cylinder()

// Debug output
if debug_mode and barstate.islast
    var label debug_label = label.new(bar_index, high, "", style=label.style_label_down, color=color.new(color.gray, 80), textcolor=color.white, size=size.small)
    label.set_xy(debug_label, bar_index, high)
    label.set_text(debug_label, "Debug: ZigZag Points=" + str.tostring(array.size(zz_price)))

// Plot ZigZag line for reference (optional)
if array.size(zz_price) >= 2
    last_price = array.get(zz_price, array.size(zz_price) - 1)
    last_bar = array.get(zz_bar, array.size(zz_bar) - 1)
    if bar_index >= last_bar
        line.new(last_bar, last_price, bar_index, close, color=color.new(color.gray, 70), width=1, style=line.style_dotted)

plot(na, title="Advanced Market Analysis")
