//@version=6
indicator("Advanced Market Analysis & Pattern Detection", shorttitle="AMA", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// I. USER INPUTS & CONFIGURATION (사용자 설정)
// ═══════════════════════════════════════════════════════════════════════════════

// --- Pattern Display Toggles ---
var group_toggles = "Pattern Display Toggles"
show_elliott = input.bool(true, title="Show Elliott Waves", group=group_toggles)
show_elliott_impulse = input.bool(true, title="  ↳ Show Impulse Waves (1-5)", group=group_toggles)
show_elliott_corrective = input.bool(true, title="  ↳ Show Corrective Waves (ABC)", group=group_toggles)
show_elliott_connecting = input.bool(true, title="  ↳ Show Connecting Waves (WXY)", group=group_toggles)
show_elliott_triangle = input.bool(true, title="  ↳ Show Triangle Waves (ABCDE)", group=group_toggles)
show_truncated = input.bool(true, title="  ↳ Show Truncated Wave 5 (5T)", group=group_toggles)
show_diagonal = input.bool(true, title="  ↳ Show Diagonal Patterns", group=group_toggles)

// NEoWave Advanced Patterns (Glenn Neely)
show_neowave_advanced = input.bool(true, title="Show NEoWave Advanced Patterns", group=group_toggles)
show_diametric = input.bool(true, title="  ↳ Show Diametric Formation (7-wave)", group=group_toggles)
show_extracting_triangle = input.bool(true, title="  ↳ Show Extracting Triangle", group=group_toggles)
show_neutral_triangle = input.bool(true, title="  ↳ Show Neutral Triangle", group=group_toggles)
show_terminal_5th = input.bool(true, title="  ↳ Show 5th Failure Terminal", group=group_toggles)

// Chart Patterns (Bulkowski)
show_chart_patterns = input.bool(true, title="Show Chart Patterns", group=group_toggles)
show_head_shoulders = input.bool(true, title="  ↳ Show Head & Shoulders", group=group_toggles)
show_double_patterns = input.bool(true, title="  ↳ Show Double Top/Bottom", group=group_toggles)
show_cup_handle = input.bool(true, title="  ↳ Show Cup with Handle", group=group_toggles)

show_harmonic = input.bool(true, title="Show Harmonic Patterns", group=group_toggles)
show_wyckoff = input.bool(true, title="Show Wyckoff Phases", group=group_toggles)
show_dow = input.bool(true, title="Show Dow Theory", group=group_toggles)
show_master = input.bool(true, title="Show Master Pattern", group=group_toggles)
show_kondratiev = input.bool(true, title="Show Kondratiev Wave", group=group_toggles)
show_deep_cycle = input.bool(true, title="Show Deep Depth Cycle", group=group_toggles)
show_livermore = input.bool(true, title="Show Livermore Accumulation Cylinder", group=group_toggles)

// --- ZigZag Parameters ---
var group_zigzag = "ZigZag Settings"
zigzag_depth = input.int(12, title="ZigZag Depth", minval=1, group=group_zigzag, tooltip="Number of bars for pivot detection")
zigzag_deviation = input.float(5.0, title="ZigZag Deviation %", minval=0.1, group=group_zigzag, tooltip="Minimum price change percentage")

// --- Harmonic Pattern Parameters ---
var group_harmonic = "Harmonic Pattern Settings"
fib_tolerance = input.float(0.15, title="Fibonacci Tolerance", minval=0.05, maxval=0.30, step=0.01, group=group_harmonic, tooltip="Tolerance for Fibonacci ratio matching (±)")
show_potential = input.bool(true, title="Show Potential Patterns", group=group_harmonic, tooltip="Display patterns in formation with dashed lines")

// --- Kondratiev Wave Parameters ---
var group_kondratiev = "Kondratiev Wave Settings"
kondratiev_lookback = input.int(250, title="Lookback Period (Bars)", minval=50, maxval=1000, group=group_kondratiev, tooltip="Historical bars to analyze for cycle detection")

// --- Deep Depth Cycle Parameters ---
var group_deep_cycle = "Deep Depth Cycle Settings"
cycle_short = input.int(20, title="Short Cycle Length", minval=5, maxval=100, group=group_deep_cycle)
cycle_medium = input.int(50, title="Medium Cycle Length", minval=20, maxval=200, group=group_deep_cycle)
cycle_long = input.int(100, title="Long Cycle Length", minval=50, maxval=500, group=group_deep_cycle)

// --- Livermore Accumulation Cylinder Parameters ---
var group_livermore = "Livermore Cylinder Settings"
cylinder_min_bars = input.int(10, title="Minimum Consolidation Bars", minval=5, maxval=50, group=group_livermore, tooltip="Minimum bars for cylinder formation")
cylinder_range_pct = input.float(3.0, title="Max Range %", minval=1.0, maxval=10.0, step=0.5, group=group_livermore, tooltip="Maximum price range % for cylinder")

// --- Color Settings ---
var group_colors = "Color Settings"
color_impulse = input.color(color.new(color.blue, 0), title="Impulse Wave Color", group=group_colors)
color_corrective = input.color(color.new(color.red, 0), title="Corrective Wave Color", group=group_colors)
color_harmonic = input.color(color.new(color.purple, 0), title="Harmonic Pattern Color", group=group_colors)
color_wyckoff = input.color(color.new(color.orange, 0), title="Wyckoff Color", group=group_colors)
color_dow = input.color(color.new(color.green, 0), title="Dow Theory Color", group=group_colors)
color_master_contraction = input.color(color.new(color.yellow, 80), title="Master Pattern Contraction", group=group_colors)
color_master_expansion = input.color(color.new(color.purple, 0), title="Master Pattern Expansion", group=group_colors)
color_master_trend = input.color(color.new(color.teal, 0), title="Master Pattern Trend", group=group_colors)
color_kondratiev = input.color(color.new(color.navy, 0), title="Kondratiev Wave Color", group=group_colors)
color_deep_cycle = input.color(color.new(color.maroon, 0), title="Deep Depth Cycle Color", group=group_colors)
color_livermore = input.color(color.new(color.olive, 70), title="Livermore Cylinder Color", group=group_colors)
color_neowave = input.color(color.new(color.fuchsia, 0), title="NEoWave Advanced Pattern Color", group=group_colors)
color_chart_pattern = input.color(color.new(color.aqua, 0), title="Chart Pattern Color", group=group_colors)

// --- Advanced Settings ---
var group_advanced = "Advanced Settings"
label_offset_multiplier = input.float(1.5, title="Label Spacing Multiplier", minval=0.5, maxval=5.0, step=0.1, group=group_advanced, tooltip="Adjust spacing between overlapping labels")
debug_mode = input.bool(false, title="Debug Mode", group=group_advanced, tooltip="Enable debug logging")

// ═══════════════════════════════════════════════════════════════════════════════
// II. FIBONACCI RATIOS & CONSTANTS (피보나치 상수)
// ═══════════════════════════════════════════════════════════════════════════════

// Traditional Fibonacci Ratios
var float FIB_0236 = 0.236
var float FIB_0382 = 0.382
var float FIB_0500 = 0.500
var float FIB_0618 = 0.618
var float FIB_0786 = 0.786
var float FIB_0886 = 0.886
var float FIB_1000 = 1.000
var float FIB_1130 = 1.130
var float FIB_1272 = 1.272
var float FIB_1414 = 1.414
var float FIB_1618 = 1.618
var float FIB_2000 = 2.000
var float FIB_2240 = 2.240
var float FIB_2618 = 2.618

// Ian Copsey Harmonic Elliott Wave Ratios (Advanced)
var float FIB_0414 = 0.414  // √2 ratio - 41.4%
var float FIB_0586 = 0.586  // Complementary √2 ratio - 58.6%
var float FIB_1236 = 1.236  // 123.6%
var float FIB_1382 = 1.382  // 138.2%
var float FIB_1667 = 1.667  // 166.7%
var float FIB_1764 = 1.764  // 176.4% - Very frequent Wave (iii) target
var float FIB_1854 = 1.854  // 185.4% - Very frequent Wave (iii) target
var float FIB_1900 = 1.9002 // 190.02% - Wave (iii) target
var float FIB_2236 = 2.236  // 223.6% - Common Wave (iii) extension
var float FIB_2382 = 2.382  // 238.2%
var float FIB_2764 = 2.764  // 276.4% - Frequent Wave (iii) target
var float FIB_2854 = 2.854  // 285.4% - Frequent Wave (iii) target
var float FIB_3618 = 3.618  // 361.8%
var float FIB_4236 = 4.236  // 423.6%

// ═══════════════════════════════════════════════════════════════════════════════
// III. ZIGZAG CALCULATION (지그재그 계산)
// ═══════════════════════════════════════════════════════════════════════════════

// ZigZag Pivot Detection
f_pivothigh(len) =>
    ta.pivothigh(high, len, len)

f_pivotlow(len) =>
    ta.pivotlow(low, len, len)

// ZigZag State Variables
var float[] zz_price = array.new_float(0)
var int[] zz_bar = array.new_int(0)
var int[] zz_direction = array.new_int(0) // 1 = high, -1 = low

// Calculate ZigZag
var float last_pivot_price = na
var int last_pivot_bar = na
var int last_pivot_dir = na

ph = f_pivothigh(zigzag_depth)
pl = f_pivotlow(zigzag_depth)

if not na(ph)
    price_change = na(last_pivot_price) ? 100.0 : math.abs((ph - last_pivot_price) / last_pivot_price * 100)
    if na(last_pivot_dir) or last_pivot_dir == -1
        if na(last_pivot_price) or price_change >= zigzag_deviation
            array.push(zz_price, ph)
            array.push(zz_bar, bar_index - zigzag_depth)
            array.push(zz_direction, 1)
            last_pivot_price := ph
            last_pivot_bar := bar_index - zigzag_depth
            last_pivot_dir := 1
            if array.size(zz_price) > 100
                array.shift(zz_price)
                array.shift(zz_bar)
                array.shift(zz_direction)
    else if last_pivot_dir == 1
        if ph > last_pivot_price
            array.set(zz_price, array.size(zz_price) - 1, ph)
            array.set(zz_bar, array.size(zz_bar) - 1, bar_index - zigzag_depth)
            last_pivot_price := ph
            last_pivot_bar := bar_index - zigzag_depth

if not na(pl)
    price_change = na(last_pivot_price) ? 100.0 : math.abs((pl - last_pivot_price) / last_pivot_price * 100)
    if na(last_pivot_dir) or last_pivot_dir == 1
        if na(last_pivot_price) or price_change >= zigzag_deviation
            array.push(zz_price, pl)
            array.push(zz_bar, bar_index - zigzag_depth)
            array.push(zz_direction, -1)
            last_pivot_price := pl
            last_pivot_bar := bar_index - zigzag_depth
            last_pivot_dir := -1
            if array.size(zz_price) > 100
                array.shift(zz_price)
                array.shift(zz_bar)
                array.shift(zz_direction)
    else if last_pivot_dir == -1
        if pl < last_pivot_price
            array.set(zz_price, array.size(zz_price) - 1, pl)
            array.set(zz_bar, array.size(zz_bar) - 1, bar_index - zigzag_depth)
            last_pivot_price := pl
            last_pivot_bar := bar_index - zigzag_depth

// ═══════════════════════════════════════════════════════════════════════════════
// IV. HELPER FUNCTIONS (헬퍼 함수)
// ═══════════════════════════════════════════════════════════════════════════════

// Check if value is within tolerance of target
f_within_tolerance(value, target, tolerance) =>
    math.abs(value - target) <= tolerance

// Calculate retracement ratio
f_retracement(a, b, c) =>
    math.abs((c - b) / (a - b))

// Calculate extension ratio
f_extension(a, b, c) =>
    math.abs((c - b) / (a - b))

// Get ATR for label offset calculation
atr_value = ta.atr(14)

// Calculate label offset based on direction
f_label_offset(is_bullish, multiplier=1.0) =>
    offset = atr_value * label_offset_multiplier * multiplier
    is_bullish ? offset : -offset

// ═══════════════════════════════════════════════════════════════════════════════
// V. ELLIOTT WAVE DETECTION (엘리엇 파동 탐지)
// ═══════════════════════════════════════════════════════════════════════════════

// Detect Impulse Waves (1, 2, 3, 4, 5)
f_detect_impulse_wave() =>
    if array.size(zz_price) >= 6 and show_elliott and show_elliott_impulse
        size = array.size(zz_price)

        // Get last 6 pivots (for 5-wave pattern)
        p0 = array.get(zz_price, size - 6)
        p1 = array.get(zz_price, size - 5)
        p2 = array.get(zz_price, size - 4)
        p3 = array.get(zz_price, size - 3)
        p4 = array.get(zz_price, size - 2)
        p5 = array.get(zz_price, size - 1)

        b0 = array.get(zz_bar, size - 6)
        b1 = array.get(zz_bar, size - 5)
        b2 = array.get(zz_bar, size - 4)
        b3 = array.get(zz_bar, size - 5)
        b4 = array.get(zz_bar, size - 2)
        b5 = array.get(zz_bar, size - 1)

        d0 = array.get(zz_direction, size - 6)

        // Check for bullish impulse (starting from low)
        is_bullish = d0 == -1

        // Impulse wave rules:
        // - Wave 2 cannot retrace more than 100% of wave 1
        // - Wave 3 cannot be the shortest
        // - Wave 4 cannot overlap wave 1

        wave1 = math.abs(p1 - p0)
        wave2 = math.abs(p2 - p1)
        wave3 = math.abs(p3 - p2)
        wave4 = math.abs(p4 - p3)
        wave5 = math.abs(p5 - p4)

        // Check wave 2 retracement
        retrace2 = wave2 / wave1
        valid_wave2 = retrace2 < 1.0

        // Check wave 3 is not shortest
        valid_wave3 = wave3 > wave1 or wave3 > wave5

        // Check wave 4 doesn't overlap wave 1
        valid_wave4 = is_bullish ? (p4 > p1) : (p4 < p1)

        // Check for truncated wave 5
        is_truncated = is_bullish ? (p5 < p3) : (p5 > p3)

        // Check for diagonal (wave 3 is not longest)
        is_diagonal = not (wave3 > wave1 and wave3 > wave5)

        if valid_wave2 and valid_wave3 and valid_wave4
            // Draw impulse wave lines
            line.new(b0, p0, b1, p1, color=color_impulse, width=2)
            line.new(b1, p1, b2, p2, color=color_impulse, width=2)
            line.new(b2, p2, b3, p3, color=color_impulse, width=2)
            line.new(b3, p3, b4, p4, color=color_impulse, width=2)
            line.new(b4, p4, b5, p5, color=color_impulse, width=2)

            // Place labels
            label.new(b1, p1, "①", style=is_bullish ? label.style_label_up : label.style_label_down, color=color_impulse, textcolor=color.white, size=size.normal)
            label.new(b2, p2, "②", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_impulse, textcolor=color.white, size=size.normal)
            label.new(b3, p3, "③", style=is_bullish ? label.style_label_up : label.style_label_down, color=color_impulse, textcolor=color.white, size=size.normal)
            label.new(b4, p4, "④", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_impulse, textcolor=color.white, size=size.normal)

            // Label wave 5 (or 5T if truncated)
            if is_truncated and show_truncated
                label.new(b5, p5, "⑤T", style=is_bullish ? label.style_label_up : label.style_label_down, color=color.new(color_impulse, 0), textcolor=color.white, size=size.normal)
                // Add truncation annotation
                line.new(b3, p3, b5, p5, color=color_impulse, width=1, style=line.style_dashed)
                label.new(b5, p5 + (is_bullish ? atr_value : -atr_value), "Truncated 5", style=label.style_none, color=color.new(color.white, 100), textcolor=color_impulse, size=size.small)
            else
                label.new(b5, p5, "⑤", style=is_bullish ? label.style_label_up : label.style_label_down, color=color_impulse, textcolor=color.white, size=size.normal)

            // Check and label diagonal
            if is_diagonal and show_diagonal
                label.new(b3, p3 + (is_bullish ? atr_value * 2 : -atr_value * 2), "Diagonal", style=label.style_none, color=color.new(color.white, 100), textcolor=color_impulse, size=size.small)

// Detect Corrective Waves (ABC)
f_detect_corrective_wave() =>
    if array.size(zz_price) >= 4 and show_elliott and show_elliott_corrective
        size = array.size(zz_price)

        // Get last 4 pivots (for ABC pattern)
        p0 = array.get(zz_price, size - 4)
        p1 = array.get(zz_price, size - 3)
        p2 = array.get(zz_price, size - 2)
        p3 = array.get(zz_price, size - 1)

        b0 = array.get(zz_bar, size - 4)
        b1 = array.get(zz_bar, size - 3)
        b2 = array.get(zz_bar, size - 2)
        b3 = array.get(zz_bar, size - 1)

        d0 = array.get(zz_direction, size - 4)
        is_bullish = d0 == 1 // Corrective after bullish move

        // Check if this is a completed correction
        waveA = math.abs(p1 - p0)
        waveB = math.abs(p2 - p1)
        waveC = math.abs(p3 - p2)

        // Basic ABC validation
        if waveA > 0 and waveB > 0 and waveC > 0
            // Determine if pattern is completed (solid) or in progress (dashed)
            is_completed = bar_index - b3 > zigzag_depth * 2
            line_style = is_completed ? line.style_solid : line.style_dashed

            // Draw corrective wave lines
            line.new(b0, p0, b1, p1, color=color_corrective, width=2, style=line_style)
            line.new(b1, p1, b2, p2, color=color_corrective, width=2, style=line_style)
            line.new(b2, p2, b3, p3, color=color_corrective, width=2, style=line_style)

            // Place labels
            label.new(b1, p1, "A", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_corrective, textcolor=color.white, size=size.normal)
            label.new(b2, p2, "B", style=is_bullish ? label.style_label_up : label.style_label_down, color=color_corrective, textcolor=color.white, size=size.normal)
            label.new(b3, p3, "C", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_corrective, textcolor=color.white, size=size.normal)

// Detect Connecting Waves (WXY)
f_detect_connecting_wave_wxy() =>
    if array.size(zz_price) >= 6 and show_elliott and show_elliott_connecting
        size = array.size(zz_price)

        // Get last 6 pivots for WXY pattern
        p0 = array.get(zz_price, size - 6)
        p1 = array.get(zz_price, size - 5)
        p2 = array.get(zz_price, size - 4)
        p3 = array.get(zz_price, size - 3)
        p4 = array.get(zz_price, size - 2)
        p5 = array.get(zz_price, size - 1)

        b0 = array.get(zz_bar, size - 6)
        b1 = array.get(zz_bar, size - 5)
        b2 = array.get(zz_bar, size - 4)
        b3 = array.get(zz_bar, size - 3)
        b4 = array.get(zz_bar, size - 2)
        b5 = array.get(zz_bar, size - 1)

        d0 = array.get(zz_direction, size - 6)
        is_bullish = d0 == -1

        // WXY structure: W (3 waves), X (connector), Y (3 waves)
        // Simplified: each segment is a corrective structure

        // Draw lines
        line.new(b0, p0, b2, p2, color=color_corrective, width=1, style=line.style_solid)
        line.new(b2, p2, b4, p4, color=color_corrective, width=1, style=line.style_dashed)
        line.new(b4, p4, b5, p5, color=color_corrective, width=1, style=line.style_solid)

        // Place labels
        label.new(b2, p2, "W", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_corrective, textcolor=color.white, size=size.small)
        label.new(b3, p3, "X", style=is_bullish ? label.style_label_up : label.style_label_down, color=color_corrective, textcolor=color.white, size=size.small)
        label.new(b5, p5, "Y", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_corrective, textcolor=color.white, size=size.small)

// Detect Triangle Waves (ABCDE)
f_detect_triangle_wave() =>
    if array.size(zz_price) >= 6 and show_elliott and show_elliott_triangle
        size = array.size(zz_price)

        // Get last 6 pivots for triangle pattern (5 points + origin)
        p0 = array.get(zz_price, size - 6)
        p1 = array.get(zz_price, size - 5)
        p2 = array.get(zz_price, size - 4)
        p3 = array.get(zz_price, size - 3)
        p4 = array.get(zz_price, size - 2)
        p5 = array.get(zz_price, size - 1)

        b0 = array.get(zz_bar, size - 6)
        b1 = array.get(zz_bar, size - 5)
        b2 = array.get(zz_bar, size - 4)
        b3 = array.get(zz_bar, size - 3)
        b4 = array.get(zz_bar, size - 2)
        b5 = array.get(zz_bar, size - 1)

        d0 = array.get(zz_direction, size - 6)
        is_bullish = d0 == 1

        // Calculate ranges to detect converging/expanding
        range1 = math.abs(p1 - p0)
        range2 = math.abs(p2 - p1)
        range3 = math.abs(p3 - p2)
        range4 = math.abs(p4 - p3)
        range5 = math.abs(p5 - p4)

        // Check if converging (each swing smaller)
        is_converging = range5 < range4 and range4 < range3 and range3 < range2

        // Check if expanding (each swing larger)
        is_expanding = range5 > range4 and range4 > range3 and range3 > range2

        if is_converging or is_expanding
            // Draw triangle lines
            line.new(b0, p0, b1, p1, color=color_corrective, width=1)
            line.new(b1, p1, b2, p2, color=color_corrective, width=1)
            line.new(b2, p2, b3, p3, color=color_corrective, width=1)
            line.new(b3, p3, b4, p4, color=color_corrective, width=1)
            line.new(b4, p4, b5, p5, color=color_corrective, width=1)

            // Place labels
            label.new(b1, p1, "A", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_corrective, textcolor=color.white, size=size.small)
            label.new(b2, p2, "B", style=is_bullish ? label.style_label_up : label.style_label_down, color=color_corrective, textcolor=color.white, size=size.small)
            label.new(b3, p3, "C", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_corrective, textcolor=color.white, size=size.small)
            label.new(b4, p4, "D", style=is_bullish ? label.style_label_up : label.style_label_down, color=color_corrective, textcolor=color.white, size=size.small)
            label.new(b5, p5, "E", style=is_bullish ? label.style_label_down : label.style_label_up, color=color_corrective, textcolor=color.white, size=size.small)

            // Add pattern type label
            if is_expanding
                label.new(b3, p3 + (is_bullish ? -atr_value * 2 : atr_value * 2), "Expanding Triangle", style=label.style_none, textcolor=color_corrective, size=size.small)
            else
                label.new(b3, p3 + (is_bullish ? -atr_value * 2 : atr_value * 2), "Converging Triangle", style=label.style_none, textcolor=color_corrective, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// VI. HARMONIC PATTERN DETECTION (하모닉 패턴 탐지)
// ═══════════════════════════════════════════════════════════════════════════════

// Detect Gartley Pattern
f_detect_gartley() =>
    if array.size(zz_price) >= 5 and show_harmonic
        size = array.size(zz_price)

        // XABCD points
        x = array.get(zz_price, size - 5)
        a = array.get(zz_price, size - 4)
        b = array.get(zz_price, size - 3)
        c = array.get(zz_price, size - 2)
        d = array.get(zz_price, size - 1)

        bx = array.get(zz_bar, size - 5)
        ba = array.get(zz_bar, size - 4)
        bb = array.get(zz_bar, size - 3)
        bc = array.get(zz_bar, size - 2)
        bd = array.get(zz_bar, size - 1)

        // Calculate ratios
        xab = f_retracement(x, a, b)
        abc = f_retracement(a, b, c)
        bcd = f_retracement(b, c, d)
        xad = f_retracement(x, a, d)

        // Gartley ratios:
        // XAB = 0.618
        // ABC = 0.382 - 0.886
        // BCD = 1.13 - 1.618
        // XAD = 0.786

        is_gartley = f_within_tolerance(xab, FIB_0618, fib_tolerance) and
                     (abc >= FIB_0382 - fib_tolerance and abc <= FIB_0886 + fib_tolerance) and
                     (bcd >= FIB_1130 - fib_tolerance and bcd <= FIB_1618 + fib_tolerance) and
                     f_within_tolerance(xad, FIB_0786, fib_tolerance)

        is_potential = (not is_gartley) and show_potential and
                       f_within_tolerance(xab, FIB_0618, fib_tolerance * 1.5)

        if is_gartley or is_potential
            line_style = is_gartley ? line.style_solid : line.style_dashed
            pattern_label = is_gartley ? "Gartley" : "Potential Gartley"

            // Draw pattern
            line.new(bx, x, ba, a, color=color_harmonic, width=2, style=line_style)
            line.new(ba, a, bb, b, color=color_harmonic, width=2, style=line_style)
            line.new(bb, b, bc, c, color=color_harmonic, width=2, style=line_style)
            line.new(bc, c, bd, d, color=color_harmonic, width=2, style=line_style)

            // Draw XB and AC lines
            line.new(bx, x, bb, b, color=color.new(color_harmonic, 70), width=1, style=line.style_dotted)
            line.new(ba, a, bc, c, color=color.new(color_harmonic, 70), width=1, style=line.style_dotted)

            is_bullish = a > x

            // Labels
            label.new(bx, x, "X", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)
            label.new(ba, a, "A", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)
            label.new(bb, b, "B", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)
            label.new(bc, c, "C", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)
            label.new(bd, d, "D", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)

            label.new(bc, c + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label, style=label.style_none, textcolor=color_harmonic, size=size.normal)

// Detect Butterfly Pattern
f_detect_butterfly() =>
    if array.size(zz_price) >= 5 and show_harmonic
        size = array.size(zz_price)

        x = array.get(zz_price, size - 5)
        a = array.get(zz_price, size - 4)
        b = array.get(zz_price, size - 3)
        c = array.get(zz_price, size - 2)
        d = array.get(zz_price, size - 1)

        bx = array.get(zz_bar, size - 5)
        ba = array.get(zz_bar, size - 4)
        bb = array.get(zz_bar, size - 3)
        bc = array.get(zz_bar, size - 2)
        bd = array.get(zz_bar, size - 1)

        xab = f_retracement(x, a, b)
        abc = f_retracement(a, b, c)
        bcd = f_extension(b, c, d)
        xad = f_extension(x, a, d)

        // Butterfly ratios:
        // XAB = 0.786
        // ABC = 0.382 - 0.886
        // BCD = 1.618 - 2.24
        // XAD = 1.27 - 1.618

        is_butterfly = f_within_tolerance(xab, FIB_0786, fib_tolerance) and
                       (abc >= FIB_0382 - fib_tolerance and abc <= FIB_0886 + fib_tolerance) and
                       (bcd >= FIB_1618 - fib_tolerance and bcd <= FIB_2240 + fib_tolerance) and
                       (xad >= FIB_1272 - fib_tolerance and xad <= FIB_1618 + fib_tolerance)

        is_potential = (not is_butterfly) and show_potential and
                       f_within_tolerance(xab, FIB_0786, fib_tolerance * 1.5)

        if is_butterfly or is_potential
            line_style = is_butterfly ? line.style_solid : line.style_dashed
            pattern_label = is_butterfly ? "Butterfly" : "Potential Butterfly"

            line.new(bx, x, ba, a, color=color_harmonic, width=2, style=line_style)
            line.new(ba, a, bb, b, color=color_harmonic, width=2, style=line_style)
            line.new(bb, b, bc, c, color=color_harmonic, width=2, style=line_style)
            line.new(bc, c, bd, d, color=color_harmonic, width=2, style=line_style)

            is_bullish = a > x

            label.new(bx, x, "X", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)
            label.new(ba, a, "A", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)
            label.new(bb, b, "B", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)
            label.new(bc, c, "C", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)
            label.new(bd, d, "D", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)

            label.new(bc, c + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label, style=label.style_none, textcolor=color_harmonic, size=size.normal)

// Detect Bat Pattern
f_detect_bat() =>
    if array.size(zz_price) >= 5 and show_harmonic
        size = array.size(zz_price)

        x = array.get(zz_price, size - 5)
        a = array.get(zz_price, size - 4)
        b = array.get(zz_price, size - 3)
        c = array.get(zz_price, size - 2)
        d = array.get(zz_price, size - 1)

        bx = array.get(zz_bar, size - 5)
        ba = array.get(zz_bar, size - 4)
        bb = array.get(zz_bar, size - 3)
        bc = array.get(zz_bar, size - 2)
        bd = array.get(zz_bar, size - 1)

        xab = f_retracement(x, a, b)
        abc = f_retracement(a, b, c)
        bcd = f_retracement(b, c, d)
        xad = f_retracement(x, a, d)

        // Bat ratios:
        // XAB = 0.382 - 0.50
        // ABC = 0.382 - 0.886
        // BCD = 1.618 - 2.618
        // XAD = 0.886

        is_bat = (xab >= FIB_0382 - fib_tolerance and xab <= FIB_0500 + fib_tolerance) and
                 (abc >= FIB_0382 - fib_tolerance and abc <= FIB_0886 + fib_tolerance) and
                 (bcd >= FIB_1618 - fib_tolerance and bcd <= FIB_2618 + fib_tolerance) and
                 f_within_tolerance(xad, FIB_0886, fib_tolerance)

        is_potential = (not is_bat) and show_potential and
                       (xab >= FIB_0382 - fib_tolerance * 1.5 and xab <= FIB_0500 + fib_tolerance * 1.5)

        if is_bat or is_potential
            line_style = is_bat ? line.style_solid : line.style_dashed
            pattern_label = is_bat ? "Bat" : "Potential Bat"

            line.new(bx, x, ba, a, color=color_harmonic, width=2, style=line_style)
            line.new(ba, a, bb, b, color=color_harmonic, width=2, style=line_style)
            line.new(bb, b, bc, c, color=color_harmonic, width=2, style=line_style)
            line.new(bc, c, bd, d, color=color_harmonic, width=2, style=line_style)

            is_bullish = a > x

            label.new(bx, x, "X", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)
            label.new(ba, a, "A", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)
            label.new(bb, b, "B", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)
            label.new(bc, c, "C", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)
            label.new(bd, d, "D", style=label.style_circle, color=color_harmonic, textcolor=color.white, size=size.small)

            label.new(bc, c + (is_bullish ? atr_value * 2 : -atr_value * 2), pattern_label, style=label.style_none, textcolor=color_harmonic, size=size.normal)

