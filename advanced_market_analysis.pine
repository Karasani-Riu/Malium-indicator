// --- Dual ZigZag Parameters (프랙탈 구조용) ---
var group_zigzag = "ZigZag Settings"

// Major ZigZag (대파동 감지용 - 큰 흐름)
major_zigzag_depth = input.int(20, title="Major ZigZag Depth", minval=5, maxval=50, group=group_zigzag, tooltip="대파동(1-5, A-C) 감지용 - 더 큰 값")
major_zigzag_deviation = input.float(8.0, title="Major ZigZag Deviation %", minval=3.0, maxval=20.0, step=0.5, group=group_zigzag, tooltip="대파동 최소 가격 변화율 - 더 큰 값")

// Minor ZigZag (소파동 감지용 - 세부 흐름)
minor_zigzag_depth = input.int(8, title="Minor ZigZag Depth", minval=1, maxval=30, group=group_zigzag, tooltip="소파동(i-v, a-c) 감지용 - 더 작은 값")
minor_zigzag_deviation = input.float(3.0, title="Minor ZigZag Deviation %", minval=0.5, maxval=10.0, step=0.5, group=group_zigzag, tooltip="소파동 최소 가격 변화율 - 더 작은 값")

// Legacy ZigZag (기존 패턴용)
zigzag_depth = input.int(12, title="ZigZag Depth", minval=1, group=group_zigzag, tooltip="Number of bars for pivot detection")
zigzag_deviation = input.float(5.0, title="ZigZag Deviation %", minval=0.1, group=group_zigzag, tooltip="Minimum price change percentage")

// --- Harmonic Pattern Parameters ---
var group_harmonic = "Harmonic Pattern Settings"
fib_tolerance_min = input.float(0.11, title="Min Fibonacci Tolerance", minval=0.05, maxval=0.20, step=0.01, group=group_harmonic, tooltip="Minimum tolerance for tight Fibonacci matching (±0.11)")
fib_tolerance_max = input.float(0.22, title="Max Fibonacci Tolerance", minval=0.10, maxval=0.30, step=0.01, group=group_harmonic, tooltip="Maximum tolerance for flexible Fibonacci matching (±0.22)")
show_potential = input.bool(true, title="Show Potential Patterns", group=group_harmonic, tooltip="Display patterns in formation with dashed lines")

// Legacy tolerance for backward compatibility
fib_tolerance = (fib_tolerance_min + fib_tolerance_max) / 2

