//@version=6
indicator("Advanced Market Analysis & Pattern Detection", shorttitle="AMA", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// I. USER INPUTS & CONFIGURATION (사용자 설정)
