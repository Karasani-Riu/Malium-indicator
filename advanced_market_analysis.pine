        bcd = f_extension(b, c, d)
        xad = f_extension(x, a, d)

        // Crab ratios:
        // XAB = 0.382 - 0.618
        // ABC = 0.382 - 0.886
        // BCD = 2.24 - 3.618
        // XAD = 1.618

        is_crab = (xab >= FIB_0382 - fib_tolerance and xab <= FIB_0618 + fib_tolerance) and
                  (abc >= FIB_0382 - fib_tolerance and abc <= FIB_0886 + fib_tolerance) and
                  (bcd >= FIB_2240 - fib_tolerance) and
                  f_within_tolerance(xad, FIB_1618, fib_tolerance)

        if is_crab
            line.new(bx, x, ba, a, color=color_harmonic, width=2)
            line.new(ba, a, bb, b, color=color_harmonic, width=2)
            line.new(bb, b, bc, c, color=color_harmonic, width=2)
            line.new(bc, c, bd, d, color=color_harmonic, width=2)

