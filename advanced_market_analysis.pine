// --- Pattern Display Toggles ---
var group_toggles = "Pattern Display Toggles"

// Fractal Elliott Wave Settings
show_fractal_elliott = input.bool(true, title="Show Fractal Elliott Waves", group=group_toggles)
show_major_waves = input.bool(true, title="  ↳ Show Major Waves (1-5, A-C) [Bold]", group=group_toggles)
show_minor_waves = input.bool(true, title="  ↳ Show Minor Waves (i-v, a-c) [Small]", group=group_toggles)

show_elliott = input.bool(true, title="Show Elliott Waves", group=group_toggles)
show_elliott_impulse = input.bool(true, title="  ↳ Show Impulse Waves (1-5)", group=group_toggles)
