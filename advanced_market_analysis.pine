kondratiev_lookback = input.int(250, title="Lookback Period (Bars)", minval=50, maxval=1000, group=group_kondratiev, tooltip="Historical bars to analyze for cycle detection")
kondratiev_show_background = input.bool(true, title="Show Seasonal Background Tint", group=group_kondratiev, tooltip="Display subtle background color based on Kondratiev season")

