// --- Color Settings ---
var group_colors = "Color Settings"
color_impulse = input.color(color.new(color.blue, 0), title="Impulse Wave Color", group=group_colors)
color_corrective = input.color(color.new(color.red, 0), title="Corrective Wave Color", group=group_colors)
